---
import BaseLayout from '../layouts/BaseLayout.astro';
import PagesTopbar from '../components/PagesTopbar.astro';
import PagesFooter from '../components/PagesFooter.astro';
const base = import.meta.env.BASE_URL;

type Theme = {
    slug: string;
    name: string;
    tagline: string;
    desc: string;
    tags: string[];
    demo: string;
    repo: string;
    img: string;
    pro?: { from: number; note: string };
};

const ECOMMERCE: Theme[] = [
    {
        slug: 'dark-lux',
        name: 'astro-njx-dark-lux',
        tagline: 'Monochrome dark luxury',
        desc: 'Hairline borders, zero radius, overlay search, quick-view popups, cart with saved-for-later. A full design system for brands that sell in black and white.',
        tags: ['Ecommerce', 'Shopify-ready', 'Tailwind v4'],
        demo: 'https://astro-njx-dark-lux.pages.dev',
        repo: 'https://github.com/njbSaab/astro-njx-dark-lux',
        img: '/img/themes/dark-lux.jpg',
        pro: { from: 79, note: 'reviews · customer accounts · command palette' },
    },
    {
        slug: 'verdant',
        name: 'astro-njx-verdant',
        tagline: 'Botanical apothecary',
        desc: 'Deep forest green with a brass accent and a parchment light mode. Made for skincare, spa and any brand with a garden-first voice.',
        tags: ['Ecommerce', 'Shopify-ready', 'Tailwind v4'],
        demo: 'https://astro-njx-verdant.pages.dev',
        repo: 'https://github.com/njbSaab/astro-njx-verdant',
        img: '/img/themes/verdant.jpg',
        pro: { from: 69, note: 'reviews · customer accounts · richer catalog' },
    },
    {
        slug: 'boutique',
        name: 'astro-njx-boutique',
        tagline: 'Editorial fashion',
        desc: 'Serif display type, full-bleed imagery, 3:4 photography and an oxblood accent. An editorial storefront for ateliers and small fashion brands.',
        tags: ['Ecommerce', 'Shopify-ready', 'Tailwind v4'],
        demo: 'https://astro-njx-boutique.pages.dev',
        repo: 'https://github.com/njbSaab/astro-njx-boutique',
        img: '/img/themes/boutique.jpg',
        pro: { from: 59, note: 'reviews · customer accounts · lookbook pages' },
    },
    {
        slug: 'store',
        name: 'astro-njx-store',
        tagline: 'Warm paper & pine',
        desc: 'The original: 18 static pages, cart with hosted checkout, filters, search, favorites and dark mode. Friendly, versatile, ready for any catalog.',
        tags: ['Ecommerce', 'Shopify-ready', 'Tailwind v4'],
        demo: 'https://astro-njx-store.pages.dev',
        repo: 'https://github.com/njbSaab/astro-njx-store',
        img: '/img/themes/store.jpg',
        pro: { from: 69, note: 'reviews · customer accounts · pagination & swatches' },
    },
];

const SITES: Theme[] = [
    {
        slug: 'saas',
        name: 'astro-njx-saas',
        tagline: 'Product landing',
        desc: 'Glow hero, reviews slider, 9 runtime themes — a complete product landing built 100% with njX UI and Alpine.js.',
        tags: ['Landing', 'njX UI', 'Alpine.js'],
        demo: 'https://astro-njx-saas.pages.dev',
        repo: 'https://github.com/njbSaab/astro-njx-saas',
        img: '/img/themes/saas.jpg',
    },
    {
        slug: 'portfolio',
        name: 'astro-njx-portfolio',
        tagline: 'Personal portfolio',
        desc: 'Filterable project grid, glass stat card, gradient CTA — a personal site you rebrand in one config file.',
        tags: ['Portfolio', 'njX UI', 'Alpine.js'],
        demo: 'https://astro-njx-portfolio.pages.dev',
        repo: 'https://github.com/njbSaab/astro-njx-portfolio',
        img: '/img/themes/portfolio.jpg',
    },
    {
        slug: 'launch',
        name: 'astro-njx-launch',
        tagline: 'Launch / waitlist',
        desc: 'Waitlist counter, video modal, testimonial slider and an optimistic signup form — everything a launch page needs.',
        tags: ['Landing', 'njX UI', 'Alpine.js'],
        demo: 'https://astro-njx-launch.pages.dev',
        repo: 'https://github.com/njbSaab/astro-njx-launch',
        img: '/img/themes/launch.jpg',
    },
];
---

<BaseLayout
    title="Astro Themes by njX — free ecommerce & landing themes"
    description="Free open-source Astro themes: Shopify-ready ecommerce storefronts and landing pages. Fork on GitHub, rebrand in two files, deploy in minutes. Pro versions coming soon."
>
    <PagesTopbar activePage="themes" />

    <div class="th-page">
        <!-- HERO -->
        <div class="th-hero">
            <span class="th-badge">Free &amp; open source</span>
            <h1>Astro themes by <em>njX</em></h1>
            <p>
                Production-grade Astro themes — Shopify-ready storefronts and
                landing pages. Every demo below is the theme itself running on
                mock data: fork it, rebrand two files, deploy for free.
            </p>
        </div>

        <!-- ECOMMERCE -->
        <section class="th-section">
            <div class="th-section-head">
                <h2>Ecommerce storefronts</h2>
                <p>
                    Astro 5 + Tailwind v4, static build, provider-agnostic
                    commerce layer: mock JSON out of the box, your live Shopify
                    catalog with one env var. Hosted checkout stays on Shopify.
                </p>
            </div>
            <div class="th-grid">
                {
                    ECOMMERCE.map((t) => (
                        <article class="th-card" id={t.slug}>
                            <a
                                class="th-shot"
                                href={t.demo}
                                target="_blank"
                                rel="noopener"
                            >
                                <img
                                    src={t.img}
                                    alt={`${t.name} home page`}
                                    loading="lazy"
                                    width="1280"
                                    height="720"
                                />
                            </a>
                            <div class="th-body">
                                <div class="th-name-row">
                                    <h3>{t.name}</h3>
                                    <span class="th-free">Free</span>
                                </div>
                                <div class="th-tagline">{t.tagline}</div>
                                <p class="th-desc">{t.desc}</p>
                                <div class="th-tags">
                                    {t.tags.map((tag) => (
                                        <span>{tag}</span>
                                    ))}
                                </div>
                                <div class="th-actions">
                                    <a
                                        class="th-btn th-btn-primary"
                                        href={t.demo}
                                        target="_blank"
                                        rel="noopener"
                                    >
                                        Live demo
                                    </a>
                                    <a
                                        class="th-btn"
                                        href={t.repo}
                                        target="_blank"
                                        rel="noopener"
                                    >
                                        GitHub ↗
                                    </a>
                                </div>
                                {t.pro && (
                                    <div class="th-pro">
                                        <span class="th-pro-badge">
                                            Pro · from ${t.pro.from}
                                        </span>
                                        <span class="th-pro-note">
                                            {t.pro.note} — coming soon.{' '}
                                            <a
                                                href={t.repo}
                                                target="_blank"
                                                rel="noopener"
                                            >
                                                Watch the repo
                                            </a>{' '}
                                            to get notified.
                                        </span>
                                    </div>
                                )}
                            </div>
                        </article>
                    ))
                }
            </div>
        </section>

        <!-- SITES -->
        <section class="th-section">
            <div class="th-section-head">
                <h2>Landing &amp; site themes</h2>
                <p>
                    Built 100% with njX UI — one CSS import, nine runtime
                    themes, Alpine.js for interactivity. Rebrand in a single
                    config file.
                </p>
            </div>
            <div class="th-grid th-grid-3">
                {
                    SITES.map((t) => (
                        <article class="th-card" id={t.slug}>
                            <a
                                class="th-shot"
                                href={t.demo}
                                target="_blank"
                                rel="noopener"
                            >
                                <img
                                    src={t.img}
                                    alt={`${t.name} home page`}
                                    loading="lazy"
                                    width="1280"
                                    height="720"
                                />
                            </a>
                            <div class="th-body">
                                <div class="th-name-row">
                                    <h3>{t.name}</h3>
                                    <span class="th-free">Free</span>
                                </div>
                                <div class="th-tagline">{t.tagline}</div>
                                <p class="th-desc">{t.desc}</p>
                                <div class="th-tags">
                                    {t.tags.map((tag) => (
                                        <span>{tag}</span>
                                    ))}
                                </div>
                                <div class="th-actions">
                                    <a
                                        class="th-btn th-btn-primary"
                                        href={t.demo}
                                        target="_blank"
                                        rel="noopener"
                                    >
                                        Live demo
                                    </a>
                                    <a
                                        class="th-btn"
                                        href={t.repo}
                                        target="_blank"
                                        rel="noopener"
                                    >
                                        GitHub ↗
                                    </a>
                                </div>
                            </div>
                        </article>
                    ))
                }
            </div>
        </section>

        <!-- CTA -->
        <div class="th-cta">
            <h2>Need it wired to a real store?</h2>
            <p>
                Setup and branding services ship together with the Pro versions.
                Questions, custom work, or a theme request —
                <a href={`${base}contact`}>write to us</a>. If a theme saved you
                time, a star on GitHub keeps this project alive ♡
            </p>
        </div>
    </div>

    <PagesFooter />
</BaseLayout>

<!-- ── themes-page styles (is:global = no Astro scoping) ── -->
<style is:global>
    .th-page {
        max-width: 1160px;
        margin: 0 auto;
        padding: 0 24px 60px;
    }
    .th-hero {
        text-align: center;
        padding: 64px 0 40px;
    }
    .th-badge {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.4px;
        color: var(--color-primary);
        background: color-mix(in srgb, var(--color-primary) 12%, transparent);
        border: 1px solid
            color-mix(in srgb, var(--color-primary) 30%, transparent);
    }
    .th-hero h1 {
        margin: 18px 0 12px;
        font-family: 'Poppins', sans-serif;
        font-size: clamp(32px, 5vw, 48px);
        font-weight: 800;
    }
    .th-hero h1 em {
        font-style: normal;
        color: var(--color-primary);
    }
    .th-hero p {
        max-width: 62ch;
        margin: 0 auto;
        opacity: 0.8;
        line-height: 1.6;
    }
    .th-section {
        margin-top: 40px;
    }
    .th-section-head h2 {
        font-family: 'Poppins', sans-serif;
        font-size: 26px;
        font-weight: 800;
    }
    .th-section-head p {
        max-width: 70ch;
        margin: 8px 0 22px;
        opacity: 0.75;
        line-height: 1.55;
        font-size: 15px;
    }
    .th-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
    }
    .th-grid-3 {
        grid-template-columns: repeat(3, 1fr);
    }
    @media (max-width: 900px) {
        .th-grid,
        .th-grid-3 {
            grid-template-columns: 1fr;
        }
    }
    .th-card {
        display: flex;
        flex-direction: column;
        border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
        border-radius: 14px;
        overflow: hidden;
        background: color-mix(in srgb, currentColor 4%, transparent);
        transition:
            transform 0.2s ease,
            border-color 0.2s ease;
    }
    .th-card:hover {
        transform: translateY(-3px);
        border-color: color-mix(in srgb, var(--color-primary) 55%, transparent);
    }
    .th-shot {
        display: block;
        aspect-ratio: 16/9;
        overflow: hidden;
        border-bottom: 1px solid
            color-mix(in srgb, currentColor 12%, transparent);
    }
    .th-shot img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.4s ease;
    }
    .th-card:hover .th-shot img {
        transform: scale(1.03);
    }
    .th-body {
        display: flex;
        flex-direction: column;
        flex: 1;
        padding: 18px 20px 20px;
    }
    .th-name-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }
    .th-name-row h3 {
        font-size: 17px;
        font-weight: 700;
        font-family: 'Roboto Mono', monospace;
    }
    .th-free {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: #22c55e;
        border: 1px solid color-mix(in srgb, #22c55e 45%, transparent);
        border-radius: 999px;
        padding: 2px 10px;
    }
    .th-tagline {
        margin-top: 4px;
        font-size: 13px;
        font-weight: 600;
        color: var(--color-primary);
    }
    .th-desc {
        margin: 10px 0 0;
        font-size: 14px;
        line-height: 1.55;
        opacity: 0.8;
    }
    .th-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 12px;
    }
    .th-tags span {
        font-size: 12px;
        padding: 3px 10px;
        border-radius: 999px;
        border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
        opacity: 0.75;
    }
    .th-actions {
        display: flex;
        gap: 10px;
        margin-top: 16px;
    }
    .th-btn {
        display: inline-block;
        padding: 9px 18px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        color: inherit;
        border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
        transition:
            background 0.15s ease,
            border-color 0.15s ease,
            color 0.15s ease;
    }
    .th-btn:hover {
        border-color: color-mix(in srgb, var(--color-primary) 60%, transparent);
        color: var(--color-primary);
    }
    .th-btn-primary {
        background: var(--color-primary);
        border-color: var(--color-primary);
        color: #fff;
    }
    .th-btn-primary:hover {
        opacity: 0.88;
        color: #fff;
    }
    .th-pro {
        margin-top: 16px;
        padding-top: 14px;
        border-top: 1px dashed
            color-mix(in srgb, currentColor 18%, transparent);
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 8px;
        font-size: 13px;
        line-height: 1.5;
    }
    .th-pro-badge {
        font-weight: 700;
        white-space: nowrap;
        color: var(--color-primary);
        border: 1px solid
            color-mix(in srgb, var(--color-primary) 40%, transparent);
        border-radius: 999px;
        padding: 2px 10px;
        font-size: 12px;
    }
    .th-pro-note {
        opacity: 0.75;
    }
    .th-pro-note a {
        color: var(--color-primary);
        text-decoration: underline;
        text-underline-offset: 2px;
    }
    .th-cta {
        margin-top: 64px;
        text-align: center;
        padding: 36px 24px;
        border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
        border-radius: 16px;
    }
    .th-cta h2 {
        font-family: 'Poppins', sans-serif;
        font-size: 24px;
        font-weight: 800;
    }
    .th-cta p {
        max-width: 62ch;
        margin: 10px auto 0;
        opacity: 0.8;
        line-height: 1.6;
        font-size: 15px;
    }
    .th-cta a {
        color: var(--color-primary);
    }
</style>
