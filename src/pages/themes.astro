<script is:inline>
    // category tabs — delegated on document so View Transitions can't drop the listener
    (function () {
        function moveGlider() {
            var tabs = document.querySelector('.th-tabs');
            var active = document.querySelector('.th-tab.is-active');
            var glider = document.querySelector('.th-tab-glider');
            if (!tabs || !active || !glider) return;
            glider.style.left = active.offsetLeft + 'px';
            glider.style.width = active.offsetWidth + 'px';
            tabs.classList.add('is-ready');
        }
        function applyTab(tab) {
            var cat = tab.dataset.thTab;
            document.querySelectorAll('[data-th-tab]').forEach(function (b) {
                b.classList.toggle('is-active', b === tab);
            });
            document.querySelectorAll('[data-th-cat]').forEach(function (sec) {
                var hide = cat !== 'all' && sec.dataset.thCat !== cat;
                var wasHidden = sec.classList.contains('is-tab-hidden');
                sec.classList.toggle('is-tab-hidden', hide);
                if (!hide && wasHidden) {
                    sec.classList.remove('th-anim-in');
                    void sec.offsetWidth; /* restart the entrance animation */
                    sec.classList.add('th-anim-in');
                }
            });
            moveGlider();
        }
        if (!window.__thTabsBound) {
            window.__thTabsBound = true;
            document.addEventListener('click', function (e) {
                var tab = e.target.closest('[data-th-tab]');
                if (tab) applyTab(tab);
            });
            window.addEventListener('resize', moveGlider);
            document.addEventListener('astro:page-load', moveGlider);
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', moveGlider);
        else moveGlider();
        window.addEventListener('load', moveGlider);
    })();
</script>
