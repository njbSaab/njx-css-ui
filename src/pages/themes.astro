---
import BaseLayout from '../layouts/BaseLayout.astro';
import PagesTopbar from '../components/PagesTopbar.astro';
import PagesFooter from '../components/PagesFooter.astro';
const base = import.meta.env.BASE_URL;

type Theme = {
    slug: string;
    name: string;
    tagline: string;
    desc: string;
    tags: string[];
    demo: string;
    repo: string;
    img: string;
    pro?: { from: number; note: string };
};

const ECOMMERCE: Theme[] = [
    {
        slug: 'dark-lux',
        name: 'astro-njx-dark-lux',
        tagline: 'Monochrome dark luxury',
        desc: 'Hairline borders, zero radius, overlay search, quick-view popups, cart with saved-for-later. A full design system for brands that sell in black and white.',
        tags: ['Ecommerce', 'Shopify-ready', 'Tailwind v4'],
        demo: 'https://astro-njx-dark-lux.pages.dev',
        repo: 'https://github.com/njbSaab/astro-njx-dark-lux',
        img: '/img/themes/dark-lux.jpg',
        pro: { from: 79, note: 'reviews · customer accounts · command palette' },
    },
    {
        slug: 'verdant',
        name: 'astro-njx-verdant',
        tagline: 'Botanical apothecary',
        desc: 'Deep forest green with a brass accent and a parchment light mode. Made for skincare, spa and any brand with a garden-first voice.',
        tags: ['Ecommerce', 'Shopify-ready', 'Tailwind v4'],
        demo: 'https://astro-njx-verdant.pages.dev',
        repo: 'https://github.com/njbSaab/astro-njx-verdant',
        img: '/img/themes/verdant.jpg',
        pro: { from: 69, note: 'reviews · customer accounts · richer catalog' },
    },
    {
        slug: 'boutique',
        name: 'astro-njx-boutique',
        tagline: 'Editorial fashion',
        desc: 'Serif display type, full-bleed imagery, 3:4 photography and an oxblood accent. An editorial storefront for ateliers and small fashion brands.',
        tags: ['Ecommerce', 'Shopify-ready', 'Tailwind v4'],
        demo: 'https://astro-njx-boutique.pages.dev',
        repo: 'https://github.com/njbSaab/astro-njx-boutique',
        img: '/img/themes/boutique.jpg',
        pro: { from: 59, note: 'reviews · customer accounts · lookbook pages' },
    },
    {
        slug: 'store',
        name: 'astro-njx-store',
        tagline: 'Warm paper & pine',
        desc: 'The original: 18 static pages, cart with hosted checkout, filters, search, favorites and dark mode. Friendly, versatile, ready for any catalog.',
        tags: ['Ecommerce', 'Shopify-ready', 'Tailwind v4'],
        demo: 'https://astro-njx-store.pages.dev',
        repo: 'https://github.com/njbSaab/astro-njx-store',
        img: '/img/themes/store.jpg',
        pro: { from: 69, note: 'reviews · customer accounts · pagination & swatches' },
    },
];

const SITES: Theme[] = [
    {
        slug: 'saas',
        name: 'astro-njx-saas',
        tagline: 'Product landing',
        desc: 'Glow hero, reviews slider, 9 runtime themes — a complete product landing built 100% with njX UI and Alpine.js.',
        tags: ['Landing', 'njX UI', 'Alpine.js'],
        demo: 'https://astro-njx-saas.pages.dev',
        repo: 'https://github.com/njbSaab/astro-njx-saas',
        img: '/img/themes/saas.jpg',
    },
    {
        slug: 'portfolio',
        name: 'astro-njx-portfolio',
        tagline: 'Personal portfolio',
        desc: 'Filterable project grid, glass stat card, gradient CTA — a personal site you rebrand in one config file.',
        tags: ['Portfolio', 'njX UI', 'Alpine.js'],
        demo: 'https://astro-njx-portfolio.pages.dev',
        repo: 'https://github.com/njbSaab/astro-njx-portfolio',
        img: '/img/themes/portfolio.jpg',
    },
    {
        slug: 'launch',
        name: 'astro-njx-launch',
        tagline: 'Launch / waitlist',
        desc: 'Waitlist counter, video modal, testimonial slider and an optimistic signup form — everything a launch page needs.',
        tags: ['Landing', 'njX UI', 'Alpine.js'],
        demo: 'https://astro-njx-launch.pages.dev',
        repo: 'https://github.com/njbSaab/astro-njx-launch',
        img: '/img/themes/launch.jpg',
    },
];
---

<BaseLayout
    title="Astro Ecommerce Themes & Shopify Templates — Free & Pro | njX"
    description="Free open-source Astro ecommerce themes and Shopify storefront templates: headless Shopify-ready storefronts plus landing page themes. Fork on GitHub, rebrand in two files, deploy free. Pro versions and setup service coming soon."
>
    <PagesTopbar activePage="themes" />

    <div class="th-page">
        <!-- HERO -->
        <div class="th-hero">
            <span class="tag tag-primary">Free &amp; open source</span>
            <h1>Astro ecommerce themes <span class="text-main-gradient">&amp; Shopify templates</span></h1>
            <p>
                Production-grade Astro themes — headless Shopify-ready
                ecommerce storefront templates and landing pages. Every demo
                below is the theme itself running on mock data: fork it,
                rebrand two files, deploy for free.
            </p>
            <div class="th-hero-actions">
                <a class="btn btn-primary btn-lg" href="#brief">Start your project brief</a>
                <a class="btn btn-outline btn-lg" href="https://github.com/njbSaab" target="_blank" rel="noopener">GitHub ↗</a>
            </div>
        </div>

        <!-- ECOMMERCE -->
        <section class="th-section">
            <div class="th-section-head">
                <h2>Ecommerce storefronts</h2>
                <p>
                    Astro 5 + Tailwind v4, static build, provider-agnostic
                    commerce layer: each ecommerce template runs on mock JSON
                    out of the box and becomes a headless Shopify storefront
                    with one env var — your live catalog, Shopify's hosted
                    checkout.
                </p>
            </div>
            <div class="th-grid">
                {
                    ECOMMERCE.map((t) => (
                        <article class="th-card" id={t.slug}>
                            <a
                                class="th-shot"
                                href={t.demo}
                                target="_blank"
                                rel="noopener"
                            >
                                <img
                                    src={t.img}
                                    alt={`${t.name} home page`}
                                    loading="lazy"
                                    width="1280"
                                    height="720"
                                />
                            </a>
                            <div class="th-body">
                                <div class="th-name-row">
                                    <h3>{t.name}</h3>
                                    <span class="th-free">Free</span>
                                </div>
                                <div class="th-tagline">{t.tagline}</div>
                                <p class="th-desc">{t.desc}</p>
                                <div class="th-tags">
                                    {t.tags.map((tag) => (
                                        <span>{tag}</span>
                                    ))}
                                </div>
                                <div class="th-actions">
                                    <a
                                        class="th-btn th-btn-primary"
                                        href={t.demo}
                                        target="_blank"
                                        rel="noopener"
                                    >
                                        Live demo
                                    </a>
                                    <a
                                        class="th-btn"
                                        href={t.repo}
                                        target="_blank"
                                        rel="noopener"
                                    >
                                        GitHub ↗
                                    </a>
                                </div>
                                {t.pro && (
                                    <div class="th-pro">
                                        <span class="th-pro-badge">
                                            Pro · from ${t.pro.from}
                                        </span>
                                        <span class="th-pro-note">
                                            {t.pro.note} — coming soon.{' '}
                                            <a
                                                href={t.repo}
                                                target="_blank"
                                                rel="noopener"
                                            >
                                                Watch the repo
                                            </a>{' '}
                                            to get notified.
                                        </span>
                                    </div>
                                )}
                            </div>
                        </article>
                    ))
                }
            </div>
        </section>

        <!-- SITES -->
        <section class="th-section">
            <div class="th-section-head">
                <h2>Landing &amp; site themes</h2>
                <p>
                    Built 100% with njX UI — one CSS import, nine runtime
                    themes, Alpine.js for interactivity. Rebrand in a single
                    config file.
                </p>
            </div>
            <div class="th-grid th-grid-3">
                {
                    SITES.map((t) => (
                        <article class="th-card" id={t.slug}>
                            <a
                                class="th-shot"
                                href={t.demo}
                                target="_blank"
                                rel="noopener"
                            >
                                <img
                                    src={t.img}
                                    alt={`${t.name} home page`}
                                    loading="lazy"
                                    width="1280"
                                    height="720"
                                />
                            </a>
                            <div class="th-body">
                                <div class="th-name-row">
                                    <h3>{t.name}</h3>
                                    <span class="th-free">Free</span>
                                </div>
                                <div class="th-tagline">{t.tagline}</div>
                                <p class="th-desc">{t.desc}</p>
                                <div class="th-tags">
                                    {t.tags.map((tag) => (
                                        <span>{tag}</span>
                                    ))}
                                </div>
                                <div class="th-actions">
                                    <a
                                        class="th-btn th-btn-primary"
                                        href={t.demo}
                                        target="_blank"
                                        rel="noopener"
                                    >
                                        Live demo
                                    </a>
                                    <a
                                        class="th-btn"
                                        href={t.repo}
                                        target="_blank"
                                        rel="noopener"
                                    >
                                        GitHub ↗
                                    </a>
                                </div>
                            </div>
                        </article>
                    ))
                }
            </div>
        </section>

        <!-- CTA → brief form -->
        <div class="th-cta">
            <h2>Need it wired to a real store?</h2>
            <p>
                Pro versions, Shopify setup, branding or custom work — tell us
                what you're building and we'll reply with a plan and a quote.
                If a theme saved you time, a star on GitHub keeps this project
                alive ♡
            </p>
            <a class="btn btn-primary btn-lg th-cta-btn" href="#brief">Fill the brief ↓</a>
        </div>

        <!-- Brief form -->
        <section class="th-brief card-glass" id="brief">
            <div class="th-brief-copy">
                <span class="tag tag-success">Project brief</span>
                <h2>Tell us about your store</h2>
                <p>
                    The more you tell us, the more precise the first reply —
                    usually within a day. The form sends an email through
                    njxui.dev; if the service is unavailable, it opens your
                    mail app with a prepared draft.
                </p>
                <div class="th-brief-points">
                    <span>Reply within a day</span>
                    <span>No obligation quote</span>
                    <span>Private by default</span>
                </div>
            </div>
            <form class="th-brief-form" id="briefForm">
                <input id="briefCompany" name="company" type="text" autocomplete="off" tabindex="-1" aria-hidden="true" class="th-honey" />
                <label>
                    What do you need
                    <select id="briefNeed" name="need">
                        <option value="Pro version">Pro version (when it ships)</option>
                        <option value="Setup service">Setup — connect my Shopify store</option>
                        <option value="Branding package">Branding — colors, fonts, logo, copy</option>
                        <option value="Custom work">Custom work / new features</option>
                        <option value="Other">Other</option>
                    </select>
                </label>
                <label>
                    Theme
                    <select id="briefTheme" name="theme">
                        <option value="astro-njx-dark-lux">astro-njx-dark-lux</option>
                        <option value="astro-njx-verdant">astro-njx-verdant</option>
                        <option value="astro-njx-boutique">astro-njx-boutique</option>
                        <option value="astro-njx-store">astro-njx-store</option>
                        <option value="landing themes">Landing theme (saas / portfolio / launch)</option>
                        <option value="not sure">Not sure yet — advise me</option>
                    </select>
                </label>
                <label>
                    Your email
                    <input id="briefReply" name="reply" type="email" placeholder="you@example.com" />
                </label>
                <label>
                    Store platform
                    <select id="briefPlatform" name="platform">
                        <option value="Shopify — live store">Shopify — live store</option>
                        <option value="Shopify — starting now">Shopify — starting now</option>
                        <option value="No store yet">No store yet</option>
                        <option value="Other platform">Other platform</option>
                    </select>
                </label>
                <label>
                    Budget
                    <select id="briefBudget" name="budget">
                        <option value="$50–150">$50–150</option>
                        <option value="$150–500">$150–500</option>
                        <option value="$500–1500">$500–1500</option>
                        <option value="$1500+">$1500+</option>
                        <option value="Not sure">Not sure yet</option>
                    </select>
                </label>
                <label>
                    Timeline
                    <select id="briefTimeline" name="timeline">
                        <option value="ASAP">ASAP</option>
                        <option value="2–4 weeks">2–4 weeks</option>
                        <option value="Flexible">Flexible</option>
                    </select>
                </label>
                <label class="full">
                    About the project
                    <textarea id="briefMessage" name="message" rows="6" placeholder="What do you sell? Links to your current store, references, must-have features…"></textarea>
                </label>
                <button class="btn btn-success btn-lg" type="submit">Send the brief</button>
                <p class="th-brief-status" id="briefFormStatus" role="status"></p>
            </form>
        </section>
    </div>

    <PagesFooter />

    <script is:inline>
        (function () {
            var form = document.getElementById('briefForm');
            if (!form) return;
            var statusEl = document.getElementById('briefFormStatus');
            var email = 'sdr.expert@gmail.com';
            function val(id) {
                var el = document.getElementById(id);
                return el ? el.value.trim() : '';
            }
            function setStatus(text, kind) {
                statusEl.textContent = text;
                statusEl.style.color =
                    kind === 'error' ? '#f43f5e' : kind === 'ok' ? '#22c55e' : '';
            }
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                var need = val('briefNeed');
                var summary = [
                    'Need: ' + need,
                    'Theme: ' + val('briefTheme'),
                    'Platform: ' + val('briefPlatform'),
                    'Budget: ' + val('briefBudget'),
                    'Timeline: ' + val('briefTimeline'),
                    '',
                    val('briefMessage') || '(no message)',
                ].join('\n');
                var reply = val('briefReply');
                if (!reply) {
                    setStatus('Please add your email so we can reply.', 'error');
                    return;
                }
                var btn = form.querySelector('button[type=submit]');
                if (btn) btn.disabled = true;
                setStatus('Sending…', '');
                fetch('/api/contact', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        topic: 'Theme brief — ' + need,
                        replyEmail: reply,
                        message: summary,
                        company: val('briefCompany'),
                    }),
                })
                    .then(function (r) {
                        return r.json().catch(function () { return { ok: false }; })
                            .then(function (d) {
                                if (!r.ok || !d.ok) throw new Error('send failed');
                                setStatus('Brief sent — we reply within a day ✓', 'ok');
                                form.reset();
                            });
                    })
                    .catch(function () {
                        setStatus('Service unavailable — opening your mail app…', 'error');
                        window.location.href =
                            'mailto:' + email +
                            '?subject=' + encodeURIComponent('njX Themes — brief: ' + need) +
                            '&body=' + encodeURIComponent(summary + '\n\nReply email: ' + reply);
                    })
                    .finally(function () {
                        if (btn) btn.disabled = false;
                    });
            });
        })();
    </script>
</BaseLayout>

<!-- ── themes-page styles (is:global = no Astro scoping) ── -->
<style is:global>
    .th-page {
        max-width: 1160px;
        margin: 0 auto;
        padding: 0 24px 60px;
    }
    .th-hero {
        text-align: center;
        padding: 64px 0 40px;
    }
    .th-badge {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.4px;
        color: var(--color-primary);
        background: color-mix(in srgb, var(--color-primary) 12%, transparent);
        border: 1px solid
            color-mix(in srgb, var(--color-primary) 30%, transparent);
    }
    .th-hero h1 {
        margin: 18px 0 12px;
        font-family: 'Poppins', sans-serif;
        font-size: clamp(32px, 5vw, 48px);
        font-weight: 800;
    }
    .th-hero h1 em {
        font-style: normal;
        color: var(--color-primary);
    }
    .th-hero p {
        max-width: 62ch;
        margin: 0 auto;
        opacity: 0.8;
        line-height: 1.6;
    }
    .th-section {
        margin-top: 40px;
    }
    .th-section-head h2 {
        font-family: 'Poppins', sans-serif;
        font-size: 26px;
        font-weight: 800;
    }
    .th-section-head p {
        max-width: 70ch;
        margin: 8px 0 22px;
        opacity: 0.75;
        line-height: 1.55;
        font-size: 15px;
    }
    .th-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
    }
    .th-grid-3 {
        grid-template-columns: repeat(3, 1fr);
    }
    @media (max-width: 900px) {
        .th-grid,
        .th-grid-3 {
            grid-template-columns: 1fr;
        }
    }
    .th-card {
        display: flex;
        flex-direction: column;
        border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
        border-radius: 14px;
        overflow: hidden;
        background: color-mix(in srgb, currentColor 4%, transparent);
        transition:
            transform 0.2s ease,
            border-color 0.2s ease;
    }
    .th-card:hover {
        transform: translateY(-3px);
        border-color: color-mix(in srgb, var(--color-primary) 55%, transparent);
    }
    .th-shot {
        display: block;
        aspect-ratio: 16/9;
        overflow: hidden;
        border-bottom: 1px solid
            color-mix(in srgb, currentColor 12%, transparent);
    }
    .th-shot img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.4s ease;
    }
    .th-card:hover .th-shot img {
        transform: scale(1.03);
    }
    .th-body {
        display: flex;
        flex-direction: column;
        flex: 1;
        padding: 18px 20px 20px;
    }
    .th-name-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }
    .th-name-row h3 {
        font-size: 17px;
        font-weight: 700;
        font-family: 'Roboto Mono', monospace;
    }
    .th-free {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: #22c55e;
        border: 1px solid color-mix(in srgb, #22c55e 45%, transparent);
        border-radius: 999px;
        padding: 2px 10px;
    }
    .th-tagline {
        margin-top: 4px;
        font-size: 13px;
        font-weight: 600;
        color: var(--color-primary);
    }
    .th-desc {
        margin: 10px 0 0;
        font-size: 14px;
        line-height: 1.55;
        opacity: 0.8;
    }
    .th-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 12px;
    }
    .th-tags span {
        font-size: 12px;
        padding: 3px 10px;
        border-radius: 999px;
        border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
        opacity: 0.75;
    }
    .th-actions {
        display: flex;
        gap: 10px;
        margin-top: 16px;
    }
    .th-btn {
        display: inline-block;
        padding: 9px 18px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        color: inherit;
        border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
        transition:
            background 0.15s ease,
            border-color 0.15s ease,
            color 0.15s ease;
    }
    .th-btn:hover {
        border-color: color-mix(in srgb, var(--color-primary) 60%, transparent);
        color: var(--color-primary);
    }
    .th-btn-primary {
        background: var(--color-primary);
        border-color: var(--color-primary);
        color: #fff;
    }
    .th-btn-primary:hover {
        opacity: 0.88;
        color: #fff;
    }
    .th-pro {
        margin-top: 16px;
        padding-top: 14px;
        border-top: 1px dashed
            color-mix(in srgb, currentColor 18%, transparent);
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 8px;
        font-size: 13px;
        line-height: 1.5;
    }
    .th-pro-badge {
        font-weight: 700;
        white-space: nowrap;
        color: var(--color-primary);
        border: 1px solid
            color-mix(in srgb, var(--color-primary) 40%, transparent);
        border-radius: 999px;
        padding: 2px 10px;
        font-size: 12px;
    }
    .th-pro-note {
        opacity: 0.75;
    }
    .th-pro-note a {
        color: var(--color-primary);
        text-decoration: underline;
        text-underline-offset: 2px;
    }
    .th-cta {
        margin-top: 64px;
        text-align: center;
        padding: 36px 24px;
        border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
        border-radius: 16px;
    }
    .th-cta h2 {
        font-family: 'Poppins', sans-serif;
        font-size: 24px;
        font-weight: 800;
    }
    .th-cta p {
        max-width: 62ch;
        margin: 10px auto 0;
        opacity: 0.8;
        line-height: 1.6;
        font-size: 15px;
    }
    .th-cta a {
        color: var(--color-primary);
    }
    .th-cta .th-cta-btn {
        display: inline-block;
        margin-top: 20px;
        color: #fff;
    }
    .th-hero-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        margin-top: 24px;
    }

    /* ── Brief form ── */
    .th-brief {
        margin-top: 40px;
        display: grid;
        gap: 32px;
        padding: 32px;
        border-radius: 16px;
        grid-template-columns: 0.9fr 1.1fr;
    }
    @media (max-width: 860px) {
        .th-brief {
            grid-template-columns: 1fr;
        }
    }
    .th-brief-copy h2 {
        font-family: 'Poppins', sans-serif;
        font-size: 24px;
        font-weight: 800;
        margin-top: 14px;
    }
    .th-brief-copy p {
        margin-top: 10px;
        opacity: 0.8;
        line-height: 1.6;
        font-size: 15px;
    }
    .th-brief-points {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 18px;
    }
    .th-brief-points span {
        font-size: 12px;
        padding: 4px 12px;
        border-radius: 999px;
        border: 1px solid color-mix(in srgb, var(--color-primary) 35%, transparent);
        color: var(--color-primary);
    }
    .th-brief-form {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px 16px;
        align-content: start;
    }
    .th-brief-form label {
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-size: 13px;
        font-weight: 600;
    }
    .th-brief-form label.full {
        grid-column: 1 / -1;
    }
    .th-brief-form select,
    .th-brief-form input,
    .th-brief-form textarea {
        width: 100%;
        padding: 10px 12px;
        border-radius: 10px;
        font-size: 14px;
        font-family: inherit;
