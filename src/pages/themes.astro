---
import BaseLayout from '../layouts/BaseLayout.astro';
import PagesTopbar from '../components/PagesTopbar.astro';
import PagesFooter from '../components/PagesFooter.astro';
import { MODERN, ECOMMERCE, SITES } from '../data/themesCatalog';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
    title="Astro Ecommerce Themes & Shopify Templates — Free & Pro | njX"
    description="Free open-source Astro ecommerce themes and Shopify storefront templates: headless Shopify-ready storefronts plus landing page themes. Fork on GitHub, rebrand in two files, deploy free. Pro and premium licenses available."
>
    <PagesTopbar activePage="themes" />

    <main class="themes-page">
        <!-- HERO: copy left, fastest paths right (contact-page pattern) -->
        <section class="contact-hero">
            <div class="contact-hero-copy">
                <span class="tag tag-primary">Free &amp; open source</span>
                <h1>
                    Astro themes <span class="text-main-gradient">&amp; Shopify templates</span>
                </h1>
                <p>
                    Production-grade Astro ecommerce themes — headless
                    Shopify-ready storefront templates and landing pages. Every
                    demo is the theme itself on mock data: fork it, rebrand two
                    files, deploy for free.
                </p>
                <div class="contact-actions">
                    <a class="btn btn-primary btn-lg" href="#modern">
                        Browse premium themes
                    </a>
                    <a class="btn btn-outline btn-lg" href="#storefronts">
                        Free storefronts
                    </a>
                </div>
            </div>

            <aside class="contact-hero-panel" aria-label="Fastest paths">
                <span class="contact-panel-kicker">Fastest paths</span>
                <a class="contact-path" href="#modern">
                    <span class="contact-path-icon">◈</span>
                    <span>
                        <strong>Modern collection</strong>
                        <small>3 premium multi-store themes</small>
                    </span>
                    <span class="contact-path-arrow">→</span>
                </a>
                <a class="contact-path" href="#storefronts">
                    <span class="contact-path-icon">EC</span>
                    <span>
                        <strong>Ecommerce storefronts</strong>
                        <small>4 Shopify-ready templates</small>
                    </span>
                    <span class="contact-path-arrow">→</span>
                </a>
                <a class="contact-path" href="#sites">
                    <span class="contact-path-icon">LP</span>
                    <span>
                        <strong>Landing themes</strong>
                        <small>SaaS, portfolio, launch</small>
                    </span>
                    <span class="contact-path-arrow">→</span>
                </a>
            </aside>
        </section>

        <!-- CATEGORY TABS -->
        <div class="th-tabs-wrap">
            <div class="th-tabs" role="tablist" aria-label="Theme categories">
                <span class="th-tab-glider" aria-hidden="true"></span>
                <button class="th-tab is-active" data-th-tab="all" role="tab">All</button>
                <button class="th-tab" data-th-tab="modern" role="tab">Modern</button>
                <button class="th-tab" data-th-tab="storefronts" role="tab">Storefronts</button>
            </div>
        </div>

        <!-- MODERN PREMIUM THEMES -->
        <section class="th-section" id="modern" data-th-cat="modern">
            <div class="th-section-head">
                <h2>Modern collection</h2>
                <p>
                    Premium multi-store themes: three switchable shop editions
                    in every theme, five palettes, faceted super-filters with
                    live counts and full account dashboards. Paid only — these
                    are the flagship builds.
                </p>
            </div>
            <div class="th-list">
                {
                    MODERN.map((t) => (
                        <article class="th-row" id={t.slug}>
                            <a class="th-row-shot" href={`/themes/${t.slug}`}>
                                <img src={t.img} alt={`${t.name} home page`} loading="lazy" width="1280" height="720" />
                                <span class="th-shot-hint">Open theme →</span>
                            </a>
                            <div class="th-row-body">
                                <div class="th-row-head">
                                    <h3><a href={`/themes/${t.slug}`}>{t.name}</a></h3>
                                    <span class="th-premium">Premium</span>
                                </div>
                                <div class="th-tagline">{t.tagline}</div>
                                <p class="th-row-desc">{t.desc}</p>
                                {t.pro && (
                                    <ul class="th-row-feats">
                                        {t.pro.features.slice(0, 3).map((f) => (
                                            <li>{f}</li>
                                        ))}
                                    </ul>
                                )}
                                <div class="th-row-cta">
                                    {t.pro && (
                                        <div class="th-row-price">
                                            <span class="th-price-big">${t.pro.single}</span>
                                            <span class="th-price-note">Single site · ${t.pro.unlimited} Unlimited</span>
                                        </div>
                                    )}
                                    <div class="th-row-actions">
                                        <a class="th-buy" href={`/themes/${t.slug}`}>Buy this theme →</a>
                                        <a class="btn btn-outline btn-sm" href={`/themes/${t.slug}/preview`}>Live demo</a>
                                    </div>
                                </div>
                            </div>
                        </article>
                    ))
                }
            </div>
        </section>

        <!-- ECOMMERCE THEMES -->
        <section class="th-section" id="storefronts" data-th-cat="storefronts">
            <div class="th-section-head">
                <h2>Ecommerce storefronts</h2>
                <p>
                    Astro 5 + Tailwind v4, static build, provider-agnostic
                    commerce layer: each ecommerce template runs on mock JSON
                    out of the box and becomes a headless Shopify storefront
                    with one env var — your live catalog, Shopify's hosted
                    checkout.
                </p>
            </div>
            <div class="th-list">
                {
                    ECOMMERCE.map((t) => (
                        <article class="th-row" id={t.slug}>
                            <a class="th-row-shot" href={`/themes/${t.slug}`}>
                                <img src={t.img} alt={`${t.name} home page`} loading="lazy" width="1280" height="720" />
                                <span class="th-shot-hint">Open theme →</span>
                            </a>
                            <div class="th-row-body">
                                <div class="th-row-head">
                                    <h3><a href={`/themes/${t.slug}`}>{t.name}</a></h3>
                                    <span class="th-free">Free + Pro</span>
                                </div>
                                <div class="th-tagline">{t.tagline}</div>
                                <p class="th-row-desc">{t.desc}</p>
                                {t.pro && (
                                    <ul class="th-row-feats">
                                        {t.pro.features.slice(0, 3).map((f) => (
                                            <li>{f}</li>
                                        ))}
                                    </ul>
                                )}
                                <div class="th-row-cta">
                                    {t.pro ? (
                                        <div class="th-row-price">
                                            <span class="th-price-big">${t.pro.single}</span>
                                            <span class="th-price-note">Pro Single · ${t.pro.unlimited} Unlimited · free Lite on GitHub</span>
                                        </div>
                                    ) : (
                                        <div class="th-row-price">
                                            <span class="th-price-big">Free</span>
                                            <span class="th-price-note">MIT · open source</span>
                                        </div>
                                    )}
                                    <div class="th-row-actions">
                                        <a class="th-buy" href={`/themes/${t.slug}`}>{t.pro ? 'Get this theme →' : 'Open theme →'}</a>
                                        <a class="btn btn-outline btn-sm" href={`/themes/${t.slug}/preview`}>Live demo</a>
                                    </div>
                                </div>
                            </div>
                        </article>
                    ))
                }
            </div>
        </section>

        <!-- LANDING THEMES -->
        <section class="th-section" id="sites" data-th-cat="sites">
            <div class="th-section-head">
                <h2>Landing &amp; site themes</h2>
                <p>
                    Built 100% with njX UI — one CSS import, nine runtime
                    themes, Alpine.js for interactivity. Rebrand in a single
                    config file.
                </p>
            </div>
            <div class="th-grid th-grid-3">
                {
                    SITES.map((t) => (
                        <article class="th-card" id={t.slug}>
                            <a class="th-shot" href={`/themes/${t.slug}`}>
                                <img src={t.img} alt={`${t.name} home page`} loading="lazy" width="1280" height="720" />
                                <span class="th-shot-hint">Open theme →</span>
                            </a>
                            <div class="th-body">
                                <div class="th-name-row">
                                    <h3><a href={`/themes/${t.slug}`}>{t.name}</a></h3>
                                    <span class="th-free">Free</span>
                                </div>
                                <div class="th-tagline">{t.tagline}</div>
                                <p class="th-desc">{t.desc}</p>
                                <div class="th-tags">
                                    {t.tags.map((tag, i) => (
                                        <span class={['is-blue', 'is-green', 'is-red'][i % 3]}>{tag}</span>
                                    ))}
                                </div>
                                <div class="th-actions">
                                    <a class="btn btn-primary btn-sm" href={`/themes/${t.slug}`}>Live demo</a>
                                    <a class="btn btn-outline btn-sm" href={t.repo} target="_blank" rel="noopener">Free theme · GitHub ↗</a>
                                </div>
                                <div class="th-pro">
                                    <span class="th-pro-badge th-badge-ui">100% njX UI</span>
                                    <span class="th-pro-note">
                                        9 runtime themes · 1-file rebrand ·{' '}
                                        <a href={`/themes/${t.slug}`}>Details →</a>
                                    </span>
                                </div>
                            </div>
                        </article>
                    ))
                }
            </div>
        </section>

        <!-- BRIEF FORM (contact-form-card pattern) -->

        <!-- Star tip -->
        <section class="contact-tips card-glass">
            <div>
                <h2>Just taking a free theme?</h2>
                <p>
                    Go for it — that's what they're for. If a theme saves you
                    time, a star on GitHub keeps this project alive, and
                    watching the repo gets you notified the day Pro ships.
                </p>
            </div>
            <div class="contact-tip-grid">
                <span>MIT licensed</span>
                <span>Rebrand = two files</span>
                <span>Deploys free on CF Pages</span>
                <span>Pro &amp; services on the way</span>
            </div>
        </section>
    </main>

    <PagesFooter />
</BaseLayout>

<style is:global>
    /* ── page shell: contact-page pattern ── */
    .themes-page {
        min-height: 100vh;
        background:
            radial-gradient(
                circle at 14% 0,
                color-mix(in srgb, var(--color-primary) 16%, transparent),
                transparent 34rem
            ),
            radial-gradient(
                circle at 88% 18%,
                color-mix(in srgb, var(--color-accent) 12%, transparent),
                transparent 28rem
            ),
            var(--сolor-dark);
        padding: 0 24px 96px;
    }

    .themes-page .contact-hero,
    .themes-page .contact-grid,
    .themes-page .contact-form-card,
    .themes-page .contact-tips,
    .themes-page .th-section {
        width: min(1120px, 100%);
        margin-inline: auto;
    }

    /* ── hero (contact pattern) ── */
    .contact-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
        gap: clamp(28px, 5vw, 64px);
        align-items: center;
        padding: 58px 0 46px;
    }
    .contact-hero-copy {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 16px 0;
        position: relative;
    }
    .contact-hero-copy::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -18px;
        width: min(420px, 70%);
        height: 2px;
        background: linear-gradient(
            90deg,
            var(--color-primary),
            color-mix(in srgb, var(--color-accent) 70%, transparent),
            transparent
        );
        pointer-events: none;
    }
    .contact-hero-copy > * {
        position: relative;
        z-index: 1;
    }
    .contact-hero h1 {
        margin: 20px 0 0;
        max-width: 720px;
        font-size: clamp(44px, 6.5vw, 76px);
        line-height: 0.98;
        font-weight: 950;
        letter-spacing: 0;
    }
    .contact-hero p {
        max-width: 640px;
        margin: 22px 0 0;
        color: var(--color-muted);
        font-size: 18px;
        line-height: 1.75;
    }
    .contact-actions {
        display: flex;
        gap: 14px;
        justify-content: flex-start;
        flex-wrap: wrap;
        margin-top: 30px;
    }
    .contact-hero-panel {
        display: grid;
        gap: 12px;
        padding: 8px 0 8px 18px;
        border-left: 1px solid
            color-mix(in srgb, var(--color-primary) 24%, transparent);
    }
    .contact-panel-kicker {
        color: var(--color-primary);
        font-size: 12px;
        font-weight: 900;
        text-transform: uppercase;
    }
    .contact-path {
        display: grid;
        grid-template-columns: 42px minmax(0, 1fr) 34px;
        gap: 12px;
        align-items: center;
        padding: 12px 0;
        border: 1px solid
            color-mix(in srgb, var(--color-neutral-600) 20%, transparent);
        border-width: 0 0 1px;
        background: transparent;
        color: var(--color-light);
        text-decoration: none;
        transition:
            transform 0.18s ease,
            color 0.18s ease;
    }
    .contact-path:hover {
        transform: translateX(4px);
        color: var(--color-primary);
    }
    .contact-path-icon,
    .contact-path-arrow {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 12px;
        background: color-mix(in srgb, var(--color-primary) 11%, transparent);
        color: var(--color-primary);
        font-size: 13px;
        font-weight: 950;
    }
    .contact-path-arrow {
        justify-self: end;
        background: transparent;
        color: var(--color-muted);
        font-size: 20px;
    }
    .contact-path strong {
        display: block;
        font-size: 16px;
        font-weight: 900;
    }
    .contact-path small {
        display: block;
        margin-top: 2px;
        color: var(--color-muted);
        font-size: 13px;
        line-height: 1.35;
    }


    /* ── single-column selling rows ── */
    .th-list {
        display: grid;
        grid-template-columns: 1fr;
        gap: 22px;
        margin-top: 26px;
    }
    .th-row {
        display: grid;
        grid-template-columns: minmax(0, 480px) 1fr;
        border: 1px solid color-mix(in srgb, var(--color-light) 12%, transparent);
        border-radius: 18px;
        overflow: hidden;
        background: color-mix(in srgb, var(--color-light) 3%, transparent);
        transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
    }
    .th-row:hover {
        border-color: color-mix(in srgb, var(--color-primary) 55%, transparent);
        transform: translateY(-2px);
        box-shadow: 0 18px 50px color-mix(in srgb, var(--color-primary) 12%, transparent);
    }
    .th-row-shot {
        position: relative;
        display: block;
        min-height: 100%;
    }
    .th-row-shot img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: left top;
        display: block;
    }
    .th-row-shot .th-shot-hint {
        position: absolute;
        left: 14px;
        bottom: 12px;
    }
    .th-row-body {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 26px 30px 24px;
        min-width: 0;
    }
    .th-row-head {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }
    .th-row-head h3 {
        font-size: 22px;
        font-weight: 800;
        font-family: 'Roboto Mono', monospace;
        color: var(--color-light);
    }
    .th-row-head h3 a { color: inherit; text-decoration: none; }
    .th-row-head h3 a:hover { color: var(--color-primary); }
    .th-row-desc {
        color: var(--color-muted);
        font-size: 15px;
        line-height: 1.65;
        max-width: 62ch;
    }
    .th-row-feats {
        display: grid;
        gap: 7px;
        margin: 2px 0 4px;
        padding: 0;
        list-style: none;
    }
    .th-row-feats li {
        position: relative;
        padding-left: 24px;
        color: var(--color-muted);
        font-size: 14px;
        line-height: 1.5;
    }
    .th-row-feats li::before {
        content: '✓';
        position: absolute;
        left: 0;
        color: #22c55e;
        font-weight: 900;
    }
    .th-row-cta {
        margin-top: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        flex-wrap: wrap;
        padding-top: 14px;
        border-top: 1px dashed color-mix(in srgb, var(--color-light) 12%, transparent);
    }
    .th-row-price {
        display: flex;
        align-items: baseline;
        gap: 10px;
        flex-wrap: wrap;
    }
    .th-price-big {
        font-size: 34px;
        font-weight: 900;
        color: var(--color-light);
        line-height: 1;
    }
    .th-price-note {
        font-size: 13px;
        color: var(--color-muted);
    }
    .th-row-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }
    .th-buy {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #22c55e;
        color: #052e14;
        font-weight: 800;
        font-size: 15px;
        padding: 14px 26px;
        border-radius: 12px;
        text-decoration: none;
        transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 8px 26px color-mix(in srgb, #22c55e 30%, transparent);
        white-space: nowrap;
    }
    .th-buy:hover {
        background: #16a34a;
        transform: translateY(-1px);
        box-shadow: 0 12px 32px color-mix(in srgb, #22c55e 40%, transparent);
    }
    @media (max-width: 900px) {
        .th-row { grid-template-columns: 1fr; }
        .th-row-shot { aspect-ratio: 16 / 9; min-height: 0; }
        .th-row-body { padding: 20px; }
        .th-row-cta { flex-direction: column; align-items: stretch; }
        .th-buy { justify-content: center; }
    }
    /* ── service cards (contact-grid pattern) ── */
    .contact-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
    }
    .contact-card {
        display: flex;
        flex-direction: column;
        gap: 16px;
        min-height: 292px;
        padding: 22px;
        border-radius: var(--radius-lg);
        border: 1px solid color-mix(in srgb, #fff 8%, transparent);
        box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 8%, transparent);
        transition:
            transform 0.18s ease,
            box-shadow 0.18s ease,
            border-color 0.18s ease;
    }
    .contact-card:hover {
        transform: translateY(-5px);
        border-color: color-mix(in srgb, var(--color-primary) 42%, transparent);
        box-shadow: 0 26px 70px color-mix(in srgb, #000 22%, transparent);
    }
    .contact-card.card-aura-primary {
        --card-aura-bg: linear-gradient(
            160deg,
            color-mix(in srgb, var(--color-primary) 12%, var(--bg-secondary)),
            color-mix(in srgb, var(--color-accent) 7%, var(--сolor-dark))
        );
    }
    .contact-card.card-aura-ocean {
        --card-aura-bg: linear-gradient(160deg, #00101a, #061724);
    }
    .contact-card.card-aura-aurora {
        --card-aura-bg: linear-gradient(160deg, #07111e, #101424);
    }
    .contact-card.card-aura-cosmic {
        --card-aura-bg: linear-gradient(160deg, #100819, #15101f);
    }
    .contact-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 46px;
        height: 46px;
        border-radius: 16px;
        background: color-mix(in srgb, var(--color-primary) 16%, transparent);
        color: var(--color-primary);
        font-weight: 950;
        font-size: 13px;
    }
    .contact-card h2,
    .contact-form-copy h2,
    .contact-tips h2 {
        margin: 0;
        color: var(--color-light);
        font-size: 22px;
        line-height: 1.2;
        font-weight: 900;
    }
    .contact-card p,
    .contact-form-copy p,
    .contact-tips p {
        margin: 10px 0 0;
        color: var(--color-muted);
        line-height: 1.65;
        font-size: 14px;
    }
    .contact-card-actions {
        margin-top: auto;
        display: grid;
        gap: 10px;
        align-items: end;
    }
    .contact-card-actions span {
        color: var(--color-primary);
        font-size: 13px;
        font-weight: 700;
        line-height: 1.45;
        word-break: break-word;
        text-align: center;
    }

    /* ── theme sections & cards ── */
    .th-section {
        margin-top: 56px;
    }
    .th-section-head h2 {
        font-family: 'Poppins', sans-serif;
        font-size: 26px;
        font-weight: 800;
        color: var(--color-light);
    }
    .th-section-head p {
        max-width: 70ch;
        margin: 8px 0 22px;
        color: var(--color-muted);
        line-height: 1.55;
        font-size: 15px;
    }
    .th-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
    }
    .th-grid-3 {
        grid-template-columns: repeat(3, 1fr);
    }
    .th-card {
        display: flex;
        flex-direction: column;
        border: 1px solid color-mix(in srgb, #fff 10%, transparent);
        border-radius: 16px;
        overflow: hidden;
        background: color-mix(in srgb, #fff 3%, transparent);
        box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 6%, transparent);
        transition:
            transform 0.2s ease,
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }
    .th-card:hover {
        transform: translateY(-4px);
        border-color: color-mix(in srgb, var(--color-primary) 45%, transparent);
        box-shadow:
            0 26px 70px color-mix(in srgb, #000 22%, transparent),
            0 0 44px color-mix(in srgb, var(--color-primary) 16%, transparent);
    }
    .th-shot {
        position: relative;
        display: block;
        aspect-ratio: 16/9;
        overflow: hidden;
        border-bottom: 1px solid color-mix(in srgb, #fff 8%, transparent);
    }
    .th-shot-hint {
        position: absolute;
        inset-inline: 0;
        bottom: 0;
        padding: 26px 16px 12px;
        background: linear-gradient(transparent, color-mix(in srgb, #000 72%, transparent));
        color: #fff;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.4px;
        opacity: 0;
        transition: opacity 0.2s ease;
    }
    .th-card:hover .th-shot-hint { opacity: 1; }
    .th-shot img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.4s ease;
    }
    .th-card:hover .th-shot img {
        transform: scale(1.03);
    }
    .th-body {
        display: flex;
        flex-direction: column;
        flex: 1;
        padding: 18px 20px 20px;
    }
