<script is:inline>
    (function () {
        var form = document.getElementById('briefForm');
        if (!form) return;
        var statusEl = document.getElementById('briefFormStatus');
        var email = 'support@njxui.dev';
        function val(id) {
            var el = document.getElementById(id);
            return el ? el.value.trim() : '';
        }
        function setStatus(text, kind) {
            statusEl.textContent = text;
            statusEl.classList.toggle('is-success', kind === 'ok');
            statusEl.classList.toggle('is-error', kind === 'error');
        }
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            var need = val('briefNeed');
            var summary = [
                'Need: ' + need,
                'Theme: ' + val('briefTheme'),
                'Platform: ' + val('briefPlatform'),
                'Budget: ' + val('briefBudget'),
                'Timeline: ' + val('briefTimeline'),
                '',
                val('briefMessage') || '(no message)',
            ].join('\n');
            var reply = val('briefReply');
            if (!reply) {
                setStatus('Please add your email so we can reply.', 'error');
                return;
            }
            var btn = form.querySelector('button[type=submit]');
            if (btn) btn.disabled = true;
            setStatus('Sending…', '');
            fetch('/api/contact', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    topic: 'Theme brief — ' + need,
                    replyEmail: reply,
                    message: summary,
                    company: val('briefCompany'),
                }),
            })
                .then(function (r) {
                    return r
                        .json()
                        .catch(function () {
                            return { ok: false };
                        })
                        .then(function (d) {
                            if (!r.ok || !d.ok) throw new Error('send failed');
                            setStatus(
                                'Brief sent — we reply within a day ✓',
                                'ok'
                            );
                            form.reset();
                        });
                })
                .catch(function () {
                    setStatus(
                        'Service unavailable — opening your mail app…',
                        'error'
                    );
                    window.location.href =
                        'mailto:' +
                        email +
                        '?subject=' +
                        encodeURIComponent('njX Themes — brief: ' + need) +
                        '&body=' +
                        encodeURIComponent(
                            summary + '\n\nReply email: ' + reply
                        );
                })
                .finally(function () {
                    if (btn) btn.disabled = false;
                });
        });
    })();
</script>
