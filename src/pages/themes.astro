---
import BaseLayout from '../layouts/BaseLayout.astro';
import PagesTopbar from '../components/PagesTopbar.astro';
import PagesFooter from '../components/PagesFooter.astro';
const base = import.meta.env.BASE_URL;

type Theme = {
    slug: string;
    name: string;
    tagline: string;
    desc: string;
    tags: string[];
    demo: string;
    repo: string;
    img: string;
    pro?: { from: number; note: string; demo?: string };
};

const ECOMMERCE: Theme[] = [
    {
        slug: 'dark-lux',
        name: 'astro-njx-dark-lux',
        tagline: 'Monochrome dark luxury',
        desc: 'Hairline borders, zero radius, overlay search, quick-view popups, cart with saved-for-later. A full design system for brands that sell in black and white.',
        tags: ['Ecommerce', 'Shopify-ready', 'Tailwind v4'],
        demo: 'https://astro-njx-dark-lux.pages.dev',
        repo: 'https://github.com/njbSaab/astro-njx-dark-lux',
        img: '/img/themes/dark-lux.jpg',
        pro: { from: 79, note: 'reviews · customer accounts · advanced catalog · SEO pack', demo: 'https://astro-njx-dark-lux-pro.pages.dev' },
    },
    {
        slug: 'verdant',
        name: 'astro-njx-verdant',
        tagline: 'Botanical apothecary',
        desc: 'Deep forest green with a brass accent and a clean white light mode. Made for skincare, spa and any brand with a garden-first voice.',
        tags: ['Ecommerce', 'Shopify-ready', 'Tailwind v4'],
        demo: 'https://astro-njx-verdant.pages.dev',
        repo: 'https://github.com/njbSaab/astro-njx-verdant',
        img: '/img/themes/verdant.jpg',
        pro: { from: 69, note: 'reviews · customer accounts · richer catalog' },
    },
    {
        slug: 'boutique',
        name: 'astro-njx-boutique',
        tagline: 'Editorial fashion',
        desc: 'Serif display type, full-bleed imagery, 3:4 photography and an oxblood accent. An editorial storefront for ateliers and small fashion brands.',
        tags: ['Ecommerce', 'Shopify-ready', 'Tailwind v4'],
        demo: 'https://astro-njx-boutique.pages.dev',
        repo: 'https://github.com/njbSaab/astro-njx-boutique',
        img: '/img/themes/boutique.jpg',
        pro: { from: 59, note: 'reviews · customer accounts · lookbook pages' },
    },
    {
        slug: 'store',
        name: 'astro-njx-store',
        tagline: 'Warm paper & pine',
        desc: 'The original: 18 static pages, cart with hosted checkout, filters, search, favorites and dark mode. Friendly, versatile, ready for any catalog.',
        tags: ['Ecommerce', 'Shopify-ready', 'Tailwind v4'],
        demo: 'https://astro-njx-store.pages.dev',
        repo: 'https://github.com/njbSaab/astro-njx-store',
        img: '/img/themes/store.jpg',
        pro: { from: 69, note: 'reviews · customer accounts · pagination & swatches' },
    },
];

const SITES: Theme[] = [
    {
        slug: 'saas',
        name: 'astro-njx-saas',
        tagline: 'Product landing',
        desc: 'Glow hero, reviews slider, 9 runtime themes — a complete product landing built 100% with njX UI and Alpine.js.',
        tags: ['Landing', 'njX UI', 'Alpine.js'],
        demo: 'https://astro-njx-saas.pages.dev',
        repo: 'https://github.com/njbSaab/astro-njx-saas',
        img: '/img/themes/saas.jpg',
    },
    {
        slug: 'portfolio',
        name: 'astro-njx-portfolio',
        tagline: 'Personal portfolio',
        desc: 'Filterable project grid, glass stat card, gradient CTA — a personal site you rebrand in one config file.',
        tags: ['Portfolio', 'njX UI', 'Alpine.js'],
        demo: 'https://astro-njx-portfolio.pages.dev',
        repo: 'https://github.com/njbSaab/astro-njx-portfolio',
        img: '/img/themes/portfolio.jpg',
    },
    {
        slug: 'launch',
        name: 'astro-njx-launch',
        tagline: 'Launch / waitlist',
        desc: 'Waitlist counter, video modal, testimonial slider and an optimistic signup form — everything a launch page needs.',
        tags: ['Landing', 'njX UI', 'Alpine.js'],
        demo: 'https://astro-njx-launch.pages.dev',
        repo: 'https://github.com/njbSaab/astro-njx-launch',
        img: '/img/themes/launch.jpg',
    },
];
---

<BaseLayout
    title="Astro Ecommerce Themes & Shopify Templates — Free & Pro | njX"
    description="Free open-source Astro ecommerce themes and Shopify storefront templates: headless Shopify-ready storefronts plus landing page themes. Fork on GitHub, rebrand in two files, deploy free. Pro versions and setup service coming soon."
>
    <PagesTopbar activePage="themes" />

    <main class="themes-page">
        <!-- HERO: copy left, fastest paths right (contact-page pattern) -->
        <section class="contact-hero">
            <div class="contact-hero-copy">
                <span class="tag tag-primary">Free &amp; open source</span>
                <h1>
                    Astro themes <span class="text-main-gradient">&amp; Shopify templates</span>
                </h1>
                <p>
                    Production-grade Astro ecommerce themes — headless
                    Shopify-ready storefront templates and landing pages. Every
                    demo is the theme itself on mock data: fork it, rebrand two
                    files, deploy for free.
                </p>
                <div class="contact-actions">
                    <a class="btn btn-primary btn-lg" href="#brief">
                        Start your project brief
                    </a>
                    <a class="btn btn-outline btn-lg" href="#storefronts">
                        Browse themes
                    </a>
                </div>
            </div>

            <aside class="contact-hero-panel" aria-label="Fastest paths">
                <span class="contact-panel-kicker">Fastest paths</span>
                <a class="contact-path" href="#storefronts">
                    <span class="contact-path-icon">EC</span>
                    <span>
                        <strong>Ecommerce storefronts</strong>
                        <small>4 Shopify-ready templates</small>
                    </span>
                    <span class="contact-path-arrow">→</span>
                </a>
                <a class="contact-path" href="#sites">
                    <span class="contact-path-icon">LP</span>
                    <span>
                        <strong>Landing themes</strong>
                        <small>SaaS, portfolio, launch</small>
                    </span>
                    <span class="contact-path-arrow">→</span>
                </a>
                <a class="contact-path" href="#brief">
                    <span class="contact-path-icon">✉</span>
                    <span>
                        <strong>Project brief</strong>
                        <small>Pro, setup or custom — get a quote</small>
                    </span>
                    <span class="contact-path-arrow">→</span>
                </a>
            </aside>
        </section>

        <!-- SERVICE CARDS: what you can pay for -->
        <section class="contact-grid" aria-label="Services">
            <article class="contact-card card-aura card-aura-primary">
                <div class="contact-icon">PRO</div>
                <div>
                    <h2>Pro versions</h2>
                    <p>
                        Reviews, customer accounts, richer catalog, SEO pack —
                        everything the free themes leave for later. One
                        license, lifetime demo parity.
                    </p>
                </div>
                <div class="contact-card-actions">
                    <a class="btn btn-primary btn-sm" href="#brief">Get notified</a>
                    <span>from $59 · coming soon</span>
                </div>
            </article>

            <article class="contact-card card-aura card-aura-aurora">
                <div class="contact-icon">⚙</div>
                <div>
                    <h2>Setup service</h2>
                    <p>
                        We connect the theme to your live Shopify store:
                        catalog, tokens, checkout, deploy to Cloudflare Pages —
                        ready in one working day.
                    </p>
                </div>
                <div class="contact-card-actions">
                    <a class="btn btn-outline btn-sm" href="#brief">Request setup</a>
                    <span>$99–149 · 1 day</span>
                </div>
            </article>

            <article class="contact-card card-aura card-aura-cosmic">
                <div class="contact-icon">🎨</div>
                <div>
                    <h2>Branding package</h2>
                    <p>
                        Your colors, fonts, logo and copy applied through the
                        theme's design tokens and constants — a store that
                        looks like yours, not like a template.
                    </p>
                </div>
                <div class="contact-card-actions">
                    <a class="btn btn-outline btn-sm" href="#brief">Request branding</a>
                    <span>$199–249</span>
                </div>
            </article>

            <article class="contact-card card-aura card-aura-ocean">
                <div class="contact-icon">＋</div>
                <div>
                    <h2>Custom work</h2>
                    <p>
                        New sections, integrations, features beyond the theme —
                        scoped and quoted from your brief before any work
                        starts.
                    </p>
                </div>
                <div class="contact-card-actions">
                    <a class="btn btn-primary btn-sm" href="#brief">Describe the task</a>
                    <span>from $80/hour</span>
                </div>
            </article>
        </section>

        <!-- ECOMMERCE THEMES -->
        <section class="th-section" id="storefronts">
            <div class="th-section-head">
                <h2>Ecommerce storefronts</h2>
                <p>
                    Astro 5 + Tailwind v4, static build, provider-agnostic
                    commerce layer: each ecommerce template runs on mock JSON
                    out of the box and becomes a headless Shopify storefront
                    with one env var — your live catalog, Shopify's hosted
                    checkout.
                </p>
            </div>
            <div class="th-grid">
                {
                    ECOMMERCE.map((t) => (
                        <article class="th-card" id={t.slug}>
                            <a class="th-shot" href={t.demo} target="_blank" rel="noopener">
                                <img src={t.img} alt={`${t.name} home page`} loading="lazy" width="1280" height="720" />
                            </a>
                            <div class="th-body">
                                <div class="th-name-row">
                                    <h3>{t.name}</h3>
                                    <span class="th-free">Free</span>
                                </div>
                                <div class="th-tagline">{t.tagline}</div>
                                <p class="th-desc">{t.desc}</p>
                                <div class="th-tags">
                                    {t.tags.map((tag) => (
                                        <span>{tag}</span>
                                    ))}
                                </div>
                                <div class="th-actions">
                                    <a class="btn btn-primary btn-sm" href={t.demo} target="_blank" rel="noopener">Live demo</a>
                                    <a class="btn btn-outline btn-sm" href={t.repo} target="_blank" rel="noopener">GitHub ↗</a>
                                </div>
                                {t.pro && (
                                    <div class="th-pro">
                                        <span class="th-pro-badge">Pro · from ${t.pro.from}</span>
                                        {t.pro.demo ? (
                                            <span class="th-pro-note">
                                                {t.pro.note} —{' '}
                                                <a href={t.pro.demo} target="_blank" rel="noopener">Pro demo</a>{' '}
                                                ·{' '}
                                                <a href="#brief">Buy / get notified</a>
                                            </span>
                                        ) : (
                                            <span class="th-pro-note">
                                                {t.pro.note} — coming soon.{' '}
                                                <a href="#brief">Get notified</a>
                                            </span>
                                        )}
                                    </div>
                                )}
                            </div>
                        </article>
                    ))
                }
            </div>
        </section>

        <!-- LANDING THEMES -->
        <section class="th-section" id="sites">
            <div class="th-section-head">
                <h2>Landing &amp; site themes</h2>
                <p>
                    Built 100% with njX UI — one CSS import, nine runtime
                    themes, Alpine.js for interactivity. Rebrand in a single
                    config file.
                </p>
            </div>
            <div class="th-grid th-grid-3">
                {
                    SITES.map((t) => (
                        <article class="th-card" id={t.slug}>
                            <a class="th-shot" href={t.demo} target="_blank" rel="noopener">
                                <img src={t.img} alt={`${t.name} home page`} loading="lazy" width="1280" height="720" />
                            </a>
                            <div class="th-body">
                                <div class="th-name-row">
                                    <h3>{t.name}</h3>
                                    <span class="th-free">Free</span>
                                </div>
                                <div class="th-tagline">{t.tagline}</div>
                                <p class="th-desc">{t.desc}</p>
                                <div class="th-tags">
                                    {t.tags.map((tag) => (
                                        <span>{tag}</span>
                                    ))}
                                </div>
                                <div class="th-actions">
                                    <a class="btn btn-primary btn-sm" href={t.demo} target="_blank" rel="noopener">Live demo</a>
                                    <a class="btn btn-outline btn-sm" href={t.repo} target="_blank" rel="noopener">GitHub ↗</a>
                                </div>
                            </div>
                        </article>
                    ))
                }
            </div>
        </section>

        <!-- BRIEF FORM (contact-form-card pattern) -->
        <section class="contact-form-card" id="brief">
            <div class="contact-form-copy">
                <span class="tag tag-success">Project brief</span>
                <h2>Tell us about your store</h2>
                <p>
                    Pro versions, Shopify setup, branding or custom work — the
                    more you tell us, the more precise the first reply, usually
                    within a day. If the service is unavailable, the form opens
                    your mail app with a prepared draft.
                </p>
                <div class="contact-form-points">
                    <span>Reply within a day</span>
                    <span>No-obligation quote</span>
                    <span>Private by default</span>
                </div>
            </div>

            <form class="contact-form" id="briefForm">
                <input id="briefCompany" name="company" type="text" autocomplete="off" tabindex="-1" aria-hidden="true" class="contact-honey" />
                <label>
                    What do you need
                    <select id="briefNeed" name="need">
                        <option value="Pro version">Pro version (when it ships)</option>
                        <option value="Setup service">Setup — connect my Shopify store</option>
                        <option value="Branding package">Branding — colors, fonts, logo, copy</option>
                        <option value="Custom work">Custom work / new features</option>
                        <option value="Other">Other</option>
                    </select>
                </label>
                <label>
                    Theme
                    <select id="briefTheme" name="theme">
                        <option value="astro-njx-dark-lux">astro-njx-dark-lux</option>
                        <option value="astro-njx-verdant">astro-njx-verdant</option>
                        <option value="astro-njx-boutique">astro-njx-boutique</option>
                        <option value="astro-njx-store">astro-njx-store</option>
                        <option value="landing themes">Landing theme (saas / portfolio / launch)</option>
                        <option value="not sure">Not sure yet — advise me</option>
                    </select>
                </label>
                <label>
                    Your email
                    <input id="briefReply" name="reply" type="email" placeholder="you@example.com" />
                </label>
                <label>
                    Store platform
                    <select id="briefPlatform" name="platform">
                        <option value="Shopify — live store">Shopify — live store</option>
                        <option value="Shopify — starting now">Shopify — starting now</option>
                        <option value="No store yet">No store yet</option>
                        <option value="Other platform">Other platform</option>
                    </select>
                </label>
                <label>
                    Budget
                    <select id="briefBudget" name="budget">
                        <option value="$50–150">$50–150</option>
                        <option value="$150–500">$150–500</option>
                        <option value="$500–1500">$500–1500</option>
                        <option value="$1500+">$1500+</option>
                        <option value="Not sure">Not sure yet</option>
                    </select>
                </label>
                <label>
                    Timeline
                    <select id="briefTimeline" name="timeline">
                        <option value="ASAP">ASAP</option>
                        <option value="2–4 weeks">2–4 weeks</option>
                        <option value="Flexible">Flexible</option>
                    </select>
                </label>
                <label class="full">
                    About the project
                    <textarea id="briefMessage" name="message" rows="6" placeholder="What do you sell? Links to your current store, references, must-have features…"></textarea>
                </label>
                <button class="btn btn-success btn-lg" type="submit">Send the brief</button>
                <p class="contact-form-status" id="briefFormStatus" role="status"></p>
            </form>
        </section>

        <!-- Star tip -->
        <section class="contact-tips card-glass">
            <div>
                <h2>Just taking a free theme?</h2>
                <p>
                    Go for it — that's what they're for. If a theme saves you
                    time, a star on GitHub keeps this project alive, and
                    watching the repo gets you notified the day Pro ships.
                </p>
            </div>
            <div class="contact-tip-grid">
                <span>MIT licensed</span>
                <span>Rebrand = two files</span>
                <span>Deploys free on CF Pages</span>
                <span>Pro &amp; services on the way</span>
            </div>
        </section>
    </main>

    <PagesFooter />
</BaseLayout>

<style is:global>
    /* ── page shell: contact-page pattern ── */
    .themes-page {
        min-height: 100vh;
        background:
            radial-gradient(
                circle at 14% 0,
                color-mix(in srgb, var(--color-primary) 16%, transparent),
                transparent 34rem
            ),
            radial-gradient(
                circle at 88% 18%,
                color-mix(in srgb, var(--color-accent) 12%, transparent),
                transparent 28rem
            ),
            var(--сolor-dark);
        padding: 0 24px 96px;
    }

    .themes-page .contact-hero,
    .themes-page .contact-grid,
    .themes-page .contact-form-card,
    .themes-page .contact-tips,
    .themes-page .th-section {
        width: min(1120px, 100%);
        margin-inline: auto;
    }

    /* ── hero (contact pattern) ── */
    .contact-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
        gap: clamp(28px, 5vw, 64px);
        align-items: center;
        padding: 58px 0 46px;
    }
    .contact-hero-copy {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 16px 0;
        position: relative;
    }
    .contact-hero-copy::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -18px;
        width: min(420px, 70%);
        height: 2px;
        background: linear-gradient(
            90deg,
            var(--color-primary),
            color-mix(in srgb, var(--color-accent) 70%, transparent),
            transparent
        );
        pointer-events: none;
    }
    .contact-hero-copy > * {
        position: relative;
        z-index: 1;
    }
    .contact-hero h1 {
        margin: 20px 0 0;
        max-width: 720px;
        font-size: clamp(44px, 6.5vw, 76px);
        line-height: 0.98;
        font-weight: 950;
        letter-spacing: 0;
    }
    .contact-hero p {
        max-width: 640px;
        margin: 22px 0 0;
        color: var(--color-muted);
        font-size: 18px;
        line-height: 1.75;
    }
    .contact-actions {
        display: flex;
        gap: 14px;
        justify-content: flex-start;
        flex-wrap: wrap;
        margin-top: 30px;
    }
    .contact-hero-panel {
        display: grid;
        gap: 12px;
        padding: 8px 0 8px 18px;
        border-left: 1px solid
            color-mix(in srgb, var(--color-primary) 24%, transparent);
    }
    .contact-panel-kicker {
        color: var(--color-primary);
        font-size: 12px;
        font-weight: 900;
        text-transform: uppercase;
    }
    .contact-path {
        display: grid;
        grid-template-columns: 42px minmax(0, 1fr) 34px;
        gap: 12px;
        align-items: center;
        padding: 12px 0;
        border: 1px solid
            color-mix(in srgb, var(--color-neutral-600) 20%, transparent);
        border-width: 0 0 1px;
        background: transparent;
        color: var(--color-light);
        text-decoration: none;
        transition:
            transform 0.18s ease,
            color 0.18s ease;
    }
    .contact-path:hover {
        transform: translateX(4px);
        color: var(--color-primary);
    }
    .contact-path-icon,
    .contact-path-arrow {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 12px;
        background: color-mix(in srgb, var(--color-primary) 11%, transparent);
        color: var(--color-primary);
        font-size: 13px;
        font-weight: 950;
    }
    .contact-path-arrow {
        justify-self: end;
        background: transparent;
        color: var(--color-muted);
        font-size: 20px;
    }
    .contact-path strong {
        display: block;
        font-size: 16px;
        font-weight: 900;
    }
    .contact-path small {
        display: block;
        margin-top: 2px;
        color: var(--color-muted);
        font-size: 13px;
        line-height: 1.35;
    }

    /* ── service cards (contact-grid pattern) ── */
    .contact-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
    }
    .contact-card {
        display: flex;
        flex-direction: column;
        gap: 16px;
        min-height: 292px;
        padding: 22px;
        border-radius: var(--radius-lg);
        border: 1px solid color-mix(in srgb, #fff 8%, transparent);
        box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 8%, transparent);
        transition:
            transform 0.18s ease,
            box-shadow 0.18s ease,
            border-color 0.18s ease;
    }
    .contact-card:hover {
        transform: translateY(-5px);
        border-color: color-mix(in srgb, var(--color-primary) 42%, transparent);
        box-shadow: 0 26px 70px color-mix(in srgb, #000 22%, transparent);
    }
    .contact-card.card-aura-primary {
        --card-aura-bg: linear-gradient(
            160deg,
            color-mix(in srgb, var(--color-primary) 12%, var(--bg-secondary)),
            color-mix(in srgb, var(--color-accent) 7%, var(--сolor-dark))
        );
    }
    .contact-card.card-aura-ocean {
        --card-aura-bg: linear-gradient(160deg, #00101a, #061724);
    }
    .contact-card.card-aura-aurora {
        --card-aura-bg: linear-gradient(160deg, #07111e, #101424);
    }
    .contact-card.card-aura-cosmic {
        --card-aura-bg: linear-gradient(160deg, #100819, #15101f);
    }
    .contact-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 46px;
        height: 46px;
        border-radius: 16px;
        background: color-mix(in srgb, var(--color-primary) 16%, transparent);
        color: var(--color-primary);
        font-weight: 950;
        font-size: 13px;
    }
    .contact-card h2,
    .contact-form-copy h2,
    .contact-tips h2 {
        margin: 0;
        color: var(--color-light);
        font-size: 22px;
        line-height: 1.2;
        font-weight: 900;
    }
    .contact-card p,
    .contact-form-copy p,
    .contact-tips p {
        margin: 10px 0 0;
        color: var(--color-muted);
        line-height: 1.65;
        font-size: 14px;
    }
    .contact-card-actions {
        margin-top: auto;
        display: grid;
        gap: 10px;
        align-items: end;
    }
    .contact-card-actions span {
        color: var(--color-primary);
        font-size: 13px;
        font-weight: 700;
        line-height: 1.45;
        word-break: break-word;
        text-align: center;
    }

    /* ── theme sections & cards ── */
    .th-section {
        margin-top: 56px;
    }
    .th-section-head h2 {
        font-family: 'Poppins', sans-serif;
        font-size: 26px;
        font-weight: 800;
        color: var(--color-light);
    }
    .th-section-head p {
        max-width: 70ch;
        margin: 8px 0 22px;
        color: var(--color-muted);
        line-height: 1.55;
        font-size: 15px;
    }
    .th-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
    }
    .th-grid-3 {
        grid-template-columns: repeat(3, 1fr);
    }
    .th-card {
        display: flex;
        flex-direction: column;
        border: 1px solid color-mix(in srgb, #fff 10%, transparent);
        border-radius: 16px;
        overflow: hidden;
        background: color-mix(in srgb, #fff 3%, transparent);
