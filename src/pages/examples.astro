---
import BaseLayout from '../layouts/BaseLayout.astro';
import PagesTopbar from '../components/PagesTopbar.astro';
import PagesFooter from '../components/PagesFooter.astro';
import Bottombar from '../components/Bottombar.astro';
const base = import.meta.env.BASE_URL;

// Готовые лендинги: один файл = один продукт позиционирования
// «поставь CDN → собирай из готового» (STRATEGY-TWO-LIBS, фаза 1.3)
const EXAMPLES = [
  {
    file: 'saas',
    icon: '☁️',
    title: 'SaaS landing',
    desc: 'Hero, features, pricing with a monthly/yearly Alpine toggle, native-details FAQ, CTA.',
    alpine: 'pricing toggle · theme switch',
    theme: 'dark',
  },
  {
    file: 'portfolio',
    icon: '👨‍💻',
    title: 'Portfolio',
    desc: 'Personal page: hero with stats, project grid with Alpine filter tabs, testimonial, contact CTA.',
    alpine: 'filter tabs · theme cycler',
    theme: 'purple',
  },
  {
    file: 'launch',
    icon: '🛰',
    title: 'Product launch',
    desc: 'Waitlist page: gradient hero, video modal, testimonial carousel, optimistic signup form.',
    alpine: 'modal · carousel · form',
    theme: 'cyan',
  },
];
---

<BaseLayout
  title="Examples — njX UI · Ready-Made Landing Pages (copy the file, ship)"
  description="Complete single-file landing pages built with njX UI + Alpine.js: SaaS, portfolio, product launch. Copy the HTML, replace the words, deploy. Zero build step."
>
  <PagesTopbar activePage="examples" />

  <section class="ex-hero">
    <div class="ex-wrap">
      <div class="ex-label">
        <span class="ex-pulse"></span>
        Ready-made landings · copy &amp; ship
      </div>
      <h1>
        Copy the file.<br />
        <span class="ex-grad">Replace the words.</span>
        <span class="ex-dim">Ship.</span>
      </h1>
      <p class="ex-sub">
        Each example is one self-contained <code>index.html</code>: njX UI from
        CDN for the look, Alpine.js for the interactivity. No build step, no
        dependencies to install — open the file, make it yours, deploy anywhere.
      </p>
    </div>
  </section>

  <section class="sc-section" style="padding-top:0">
    <div class="ex-grid">
      {EXAMPLES.map((ex) => (
        <article class="ex-card">
          <div class="ex-frame-wrap">
            <iframe
              src={`${base}examples/${ex.file}.html`}
              title={`${ex.title} — live preview`}
              loading="lazy"
            />
          </div>
          <div class="ex-body">
            <h2 class="ex-title">{ex.icon} {ex.title}</h2>
            <p class="ex-desc">{ex.desc}</p>
            <div class="ex-meta">
              <span class="ex-pill">🏔 Alpine: {ex.alpine}</span>
              <span class="ex-pill">theme: {ex.theme}</span>
            </div>
            <div class="ex-actions">
              <a
                class="sc-btn-primary ex-btn"
                href={`${base}examples/${ex.file}.html`}
                target="_blank"
                rel="noopener">Open live ↗</a
              >
              <a
                class="sc-btn-ghost ex-btn"
                href={`${base}examples/${ex.file}.html`}
                download={`${ex.file}.html`}>Download HTML</a
              >
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="ex-note">
      💡 Every page is a live iframe of the real file — what you download is
      exactly what you see. Interactivity is plain Alpine
      <code>x-data</code> recipes from the
      <a href={`${base}documentation#alpine`}>Alpine.js section</a> of the docs.
    </div>
  </section>

  <PagesFooter activePage="examples" />
  <Bottombar />
</BaseLayout>

<style is:global>
  /* ── HERO — стайл-гайд overview: full-bleed градиент + .wrap ── */
  .ex-hero {
    position: relative;
    padding: 80px 0 64px;
    overflow: hidden;
  }
  .ex-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 70% 60% at 30% 20%,
        color-mix(in srgb, var(--color-primary) 22%, transparent),
        transparent
      ),
      radial-gradient(
        ellipse 50% 50% at 80% 80%,
        color-mix(in srgb, var(--color-accent) 12%, transparent),
        transparent
      );
    pointer-events: none;
  }
  .ex-wrap {
    position: relative;
    max-width: 1340px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .ex-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 25%, transparent);
    font-size: 11px;
    font-weight: 700;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 24px;
  }
  .ex-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-primary);
    box-shadow: 0 0 10px var(--color-primary);
    animation: ex-pulse 1.8s infinite;
    flex-shrink: 0;
  }
  @keyframes ex-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }
  .ex-hero h1 {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(48px, 6vw, 84px);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.025em;
    margin-bottom: 24px;
  }
  .ex-grad {
    background: linear-gradient(
      135deg,
      var(--color-primary),
      var(--color-accent)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .ex-dim {
    color: var(--color-muted);
  }
  .ex-sub {
    font-size: 17px;
    color: var(--color-muted);
    line-height: 1.7;
    max-width: 640px;
  }

  .ex-grid {
    display: grid;
    gap: 32px;
  }
  .ex-card {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 0;
    border: 1px solid color-mix(in srgb, var(--color-neutral-600) 22%, transparent);
    border-radius: 20px;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-neutral-600) 6%, transparent);
  }
  .ex-frame-wrap {
    position: relative;
    min-height: 380px;
    background: #0a0a0a;
  }
  .ex-frame-wrap iframe {
    position: absolute;
    inset: 0;
    width: 166%;
    height: 166%;
    border: 0;
    transform: scale(0.6);
    transform-origin: top left;
  }
  .ex-body {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    justify-content: center;
  }
  .ex-title {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.5px;
  }
  .ex-desc {
    font-size: 14px;
    color: var(--color-muted);
    line-height: 1.65;
  }
  .ex-meta {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .ex-pill {
    font-size: 11px;
    font-family: 'Roboto Mono', monospace;
    padding: 4px 10px;
    border-radius: 99px;
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    color: var(--color-primary);
  }
  .ex-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 6px;
  }
  .ex-btn {
    font-size: 13px;
    padding: 10px 22px;
  }
  .ex-note {
    margin-top: 40px;
    padding: 16px 22px;
    border-radius: 14px;
    font-size: 14px;
    color: var(--color-muted);
    background: color-mix(in srgb, var(--color-primary) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 15%, transparent);
  }
  .ex-note a {
    color: var(--color-primary);
  }
  @media (max-width: 860px) {
    .ex-card {
      grid-template-columns: 1fr;
    }
    .ex-frame-wrap {
      min-height: 300px;
    }
  }
</style>
