<!-- ── quickstart-specific styles (is:global = no Astro scoping) ── -->
<style is:global>
    *,
    *::before,
    *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        background: var(--сolor-dark);
        color: var(--color-light);
        font-family: 'Roboto', sans-serif;
        min-height: 100vh;
        transition:
            background 0.35s,
            color 0.35s;
        overflow-x: hidden;
    }

    .lib-sidebar .sc-nav-github {
        background: var(--сolor-dark) !important;
        box-shadow: none !important;
    }

    /* ── DOC LAYOUT ── */
    .doc-layout {
        display: grid;
        grid-template-columns: 260px 1fr;
        min-height: calc(100vh - 60px);
        max-width: 1400px;
        margin: 0 auto;
    }

    /* ── SIDEBAR ── */
    .doc-sidebar {
        position: sticky;
        top: 60px;
        height: calc(100vh - 60px);
        overflow-y: auto;
        padding: 32px 20px 40px;
        border-right: 1px solid
            color-mix(in srgb, var(--color-neutral-600) 18%, transparent);
    }




    .doc-sidebar-group {
        margin-bottom: 28px;
    }

    .doc-sidebar-label {
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: var(--color-muted);
        opacity: 0.5;
        padding: 0 12px;
        margin-bottom: 6px;
        display: block;
    }

    .doc-sidebar a {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 500;
        color: var(--color-muted);
        text-decoration: none;
        transition: all 0.18s;
        margin-bottom: 2px;
    }

    .doc-sidebar a:hover {
        color: var(--color-light);
        background: color-mix(in srgb, var(--color-primary) 8%, transparent);
    }

    .doc-sidebar a.active,
    .lib-sidebar a[href^='#'].active {
        color: var(--color-primary);
        background: color-mix(in srgb, var(--color-primary) 12%, transparent);
        font-weight: 600;
    }

    .doc-sidebar a .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
        flex-shrink: 0;
        opacity: 0.5;
    }

    .doc-sidebar a.active .dot {
        opacity: 1;
    }

    /* ── MAIN CONTENT ── */
    .doc-main {
        padding: 0 56px 80px;
        min-width: 0;
    }

    /* ── SECTION ── */
    .doc-section {
        margin-bottom: 72px;
        scroll-margin-top: 80px;
    }

    .doc-section-header {
        margin-bottom: 32px;
    }

    .sc-eyebrow {
        display: inline-block;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: var(--color-primary);
        margin-bottom: 10px;
    }

    .sc-heading {
        font-size: clamp(22px, 3vw, 34px);
        font-weight: 900;
        letter-spacing: -1.2px;
        line-height: 1.1;
        margin-bottom: 12px;
    }

    .sc-subheading {
        font-size: 15px;
        color: var(--color-muted);
        line-height: 1.7;
        max-width: 640px;
    }

    .doc-divider {
        height: 1px;
        background: color-mix(
            in srgb,
            var(--color-neutral-600) 18%,
            transparent
        );
        margin-bottom: 72px;
    }

    /* ── CODE BLOCK ── */
    /* .sc-code-* — база в site-shared.css; ниже дельты documentation
