        name: "purple",
        label: "Purple",
        bg: "#0c0812",
        dot: "#a855f7",
        nameBg: "#160c22",
        nameColor: "#a855f7"
    }
];

---

<BaseLayout
    title="Documentation — njX UI · Components, Tokens, JavaScript Reference"
    description="Full reference for njX UI: design tokens, component classes, JavaScript helpers, themes and classless mode. Everything in one place."
    withDocsShell={true}
    withDocsScripts={true}
>
    <!-- ══════════════════════ NAV ══════════════════════ -->
    <PagesTopbar activePage="documentation" />

    <div class="lib-wrap">
        <Sidebar><DocSidebar /></Sidebar>
        <!-- ══════════════════════ HERO ══════════════════════ -->
        <main class="doc-main lib-main">
            <!-- ══════════ STICKY MODE BAR ══════════ -->
            <div class="doc-mode-bar" id="doc-mode-bar">
                <span class="doc-mode-label">Mode</span>
                <div class="doc-mode-tabs">
                    <button
                        class="doc-mode-tab active"
                        data-mode="full"
                        onclick="pageSyncFlavor('full')"
                    >
                        <span class="doc-mode-icon">◈</span>
                        Full
                        <span class="doc-mode-default">RECOMMENDED</span>
                        <span class="doc-mode-size">{SIZE_FULL}</span>
                    </button>
                    <button
                        class="doc-mode-tab"
                        data-mode="classless"
                        onclick="pageSyncFlavor('classless')"
                    >
                        <span class="doc-mode-icon">&lt;/&gt;</span>
                        Classless Only
                        <span class="doc-mode-default">LITE</span>
                        <span class="doc-mode-size">{SIZE_CLASSLESS}</span>
                    </button>
                    <button
                        class="doc-mode-tab"
                        data-mode="interactive"
                        onclick="pageSyncFlavor('interactive')"
                    >
                        <span class="doc-mode-icon">JS</span>
                        Interactive
                    </button>
                </div>
                <span class="doc-mode-hint" id="doc-mode-hint">
                    Classless built-in — your HTML is styled automatically
                </span>
            </div>

            <!-- ══════════ QUICK START ══════════ -->
            <section class="doc-section" id="quickstart">
                <!-- ── Flavor-aware section header ── -->
                <div class="doc-section-header" data-flavor-code="full">
                    <span class="sc-eyebrow">Getting started</span>
                    <h1 class="sc-heading">Quick Start</h1>
                    <p class="sc-subheading">
                        Connect the library to your project in under a minute —
                        no build tools required.
                    </p>
                </div>
                <div
                    class="doc-section-header"
                    data-flavor-code="classless"
                    style="display:none"
                >
                    <span class="sc-eyebrow">Getting started</span>
                    <h1 class="sc-heading">Quick Start — Classless Only</h1>
                    <p class="sc-subheading">
                        Standalone mode — one file, zero class names. Semantic
                        HTML is styled automatically via element selectors. Use <code
                            style="color:var(--color-primary)"
                            >classless.min.css</code
                        >
                        when you need classless without any component classes. Need
                        component classes instead? Switch to <strong>Full</strong>
                        (<code>style.min.css</code>) — pick one stylesheet, the
                        builds are standalone.
                    </p>
                </div>
                <div
                    class="doc-section-header"
                    data-flavor-code="interactive"
                    style="display:none"
                >
                    <span class="sc-eyebrow">Getting started</span>
                    <h1 class="sc-heading">Quick Start — Interactive</h1>
                    <p class="sc-subheading">
                        Full CSS components plus JavaScript-powered interactions
                        out of the box — modals, tabs, toasts, dropdowns.
                    </p>
                </div>

                <!-- ── Version selector cards ── -->
                <div class="doc-flavor-cards">
                    <div
                        class="doc-flavor-card"
                        data-flavor-card="classless"
                        onclick="pageSyncFlavor('classless')"
                    >
                        <div class="doc-flavor-card-icon" style="color:#4ade80">
                            &lt;/&gt;
                        </div>
                        <div class="doc-flavor-card-title">Classless Only</div>
                        <div class="doc-flavor-card-desc">
                            Standalone — no component classes. Semantic HTML
                            gets styled automatically. Zero dependencies.
                        </div>
                        <div class="doc-flavor-card-badge">
                            classless.min.css · 47 KB
                        </div>
                    </div>
                    <div
                        class="doc-flavor-card active"
                        data-flavor-card="full"
                        onclick="pageSyncFlavor('full')"
                    >
                        <div class="doc-flavor-card-label-default">
                            RECOMMENDED
                        </div>
                        <div
                            class="doc-flavor-card-icon"
                            style="color:var(--color-primary)"
                        >
                            ◈
                        </div>
                        <div class="doc-flavor-card-title">Full</div>
                        <div class="doc-flavor-card-desc">
                            30+ component classes — <code>.btn</code>, <code
                                >.card</code
                            >,
                            <code>.tag</code> and more, plus utilities and 9
                            themes.
                        </div>
                        <div class="doc-flavor-card-badge">
                            style.min.css · 308 KB
                        </div>
                    </div>
                    <div
                        class="doc-flavor-card"
                        data-flavor-card="interactive"
                        onclick="pageSyncFlavor('interactive')"
                    >
                        <div class="doc-flavor-card-icon" style="color:#facc15">
                            JS
                        </div>
                        <div class="doc-flavor-card-title">Interactive</div>
                        <div class="doc-flavor-card-desc">
                            Everything in Full plus JS-powered modals, tabs,
                            toasts, dropdowns and more.
                        </div>
                        <div class="doc-flavor-card-badge">
                            style.min.css + njx.js
                        </div>
                    </div>
                </div>

                <!-- ── One-build tip ── -->
                <div class="doc-mix-tip">
                    <span class="doc-mix-tip-icon">✦</span>
                    <span>
                        <strong>One stylesheet at a time.</strong>
                        <code>style.min.css</code> (Full) and <code
                            >classless.min.css</code
                        >
                        are standalone builds — pick the one that fits your
                        project, don't load both together.
                    </span>
                </div>

                <!-- ── Steps: Full ── -->
                <div class="doc-steps" data-flavor-code="full">
                    <div class="doc-step">
                        <div class="doc-step-left">
                            <div class="doc-step-num">1</div>
                            <div class="doc-step-line"></div>
                        </div>
                        <div class="doc-step-body">
                            <div class="doc-step-title">Add the stylesheet</div>
                            <div class="doc-step-desc">
                                One <code>&lt;link&gt;</code> tag in <code
                                    >&lt;head&gt;</code
                                >. Nothing else required.
                            </div>
                            <CodeBlock frame="sc" lang="html" code={qsFullLink} />
                        </div>
                    </div>
                    <div class="doc-step">
                        <div class="doc-step-left">
                            <div class="doc-step-num">2</div>
                            <div class="doc-step-line"></div>
                        </div>
                        <div class="doc-step-body">
                            <div class="doc-step-title">Set a theme</div>
                            <div class="doc-step-desc">
                                Add <code>data-theme</code> to the <code
                                    >&lt;html&gt;</code
                                > element. All components adapt automatically.
                            </div>
                            <CodeBlock frame="sc" lang="html" code={qsFullTheme} />
                        </div>
                    </div>
                    <div class="doc-step">
                        <div class="doc-step-left">
                            <div class="doc-step-num">3</div>
                            <div class="doc-step-line"></div>
                        </div>
                        <div class="doc-step-body">
                            <div class="doc-step-title">
                                Use component classes
                            </div>
                            <div class="doc-step-desc">
                                Add class names to HTML elements. Most
                                components are pure CSS — no JavaScript needed.
                            </div>
                            <CodeBlock frame="sc" lang="html" label="index.html" code={qsFullPage} />
                        </div>
                    </div>
                </div>

                <!-- Step 4: JS (Full only) -->
                <div
                    class="doc-step"
                    style="margin-top:0"
                    data-flavor-code="full"
                >
                    <div class="doc-step-left">
                        <div class="doc-step-num">4</div>
                    </div>
                    <div class="doc-step-body">
                        <div class="doc-step-title">
                            Add JavaScript <span
                                style="font-size:12px;font-weight:400;color:var(--color-muted)"
                                >(optional)</span
                            >
                        </div>
                        <div class="doc-step-desc">
                            Interactive components — collapse, tabs, dropdown,
                            modal, carousel, toast — need one script.
                        </div>
                        <CodeBlock frame="sc" lang="html" style="margin-top:12px" code={qsFullJs} />
                        <div
                            style="margin-top:10px;font-size:13px;color:var(--color-muted)"
                        >
                            Native <code>details/summary</code> components work without
                            JS. See the <a
                                href="#javascript"
                                style="color:var(--color-primary)"
                                >JavaScript reference</a
                            > for all functions.
                        </div>
                    </div>
                </div>

                <!-- ── Steps: Classless ── -->
                <div
                    class="doc-steps"
                    data-flavor-code="classless"
                    style="display:none"
                >
                    <div class="doc-step">
                        <div class="doc-step-left">
                            <div class="doc-step-num">1</div>
                            <div class="doc-step-line"></div>
                        </div>
                        <div class="doc-step-body">
                            <div class="doc-step-title">Add the stylesheet</div>
                            <div class="doc-step-desc">
                                One <code>&lt;link&gt;</code> tag in <code
                                    >&lt;head&gt;</code
                                >. No configuration needed.
                            </div>
                            <CodeBlock frame="sc" lang="html" code={qsClasslessLink} />
                        </div>
                    </div>
                    <div class="doc-step">
                        <div class="doc-step-left">
                            <div class="doc-step-num">2</div>
                            <div class="doc-step-line"></div>
                        </div>
                        <div class="doc-step-body">
                            <div class="doc-step-title">Write plain HTML</div>
                            <div class="doc-step-desc">
                                No class names needed. Every native HTML element
                                — <code>&lt;button&gt;</code>, <code
                                    >&lt;table&gt;</code
                                >, <code>&lt;form&gt;</code>, <code
                                    >&lt;details&gt;</code
                                > — gets styled automatically.
                            </div>
                            <CodeBlock frame="sc" lang="html" label="index.html" code={qsClasslessPage} />
                        </div>
                    </div>
                    <div class="doc-step">
                        <div class="doc-step-left">
                            <div class="doc-step-num">3</div>
                        </div>
                        <div class="doc-step-body">
                            <div class="doc-step-title">
                                Themes <span
                                    style="font-size:12px;font-weight:400;color:var(--color-muted)"
                                    >(optional)</span
                                >
                            </div>
                            <div class="doc-step-desc">
                                Classless supports the same 9 themes. Add <code
                                    >data-theme</code
                                > to <code>&lt;html&gt;</code> to switch color palettes.
                            </div>
                            <CodeBlock frame="sc" lang="html" code={qsClasslessTheme} />
                        </div>
                    </div>
                </div>

                <!-- ── Steps: Interactive ── -->
                <div
                    class="doc-steps"
                    data-flavor-code="interactive"
                    style="display:none"
                >
                    <div class="doc-step">
                        <div class="doc-step-left">
                            <div class="doc-step-num">1</div>
                            <div class="doc-step-line"></div>
                        </div>
                        <div class="doc-step-body">
                            <div class="doc-step-title">Add CSS + JS</div>
                            <div class="doc-step-desc">
                                Two tags in <code>&lt;head&gt;</code> and before <code
                                    >&lt;/body&gt;</code
                                >. JS unlocks modals, tabs, toasts, dropdowns.
                            </div>
                            <CodeBlock frame="sc" lang="html" code={qsInteractiveLink} />
                        </div>
                    </div>
                    <div class="doc-step">
                        <div class="doc-step-left">
                            <div class="doc-step-num">2</div>
                            <div class="doc-step-line"></div>
                        </div>
                        <div class="doc-step-body">
                            <div class="doc-step-title">Set a theme</div>
                            <div class="doc-step-desc">
                                Add <code>data-theme</code> to <code
                                    >&lt;html&gt;</code
                                >. All components adapt automatically.
                            </div>
                            <CodeBlock frame="sc" lang="html" code={qsInteractiveTheme} />
                        </div>
                    </div>
                    <div class="doc-step">
                        <div class="doc-step-left">
                            <div class="doc-step-num">3</div>
                        </div>
                        <div class="doc-step-body">
                            <div class="doc-step-title">
                                Use components + JS API
                            </div>
                            <div class="doc-step-desc">
                                Classes work the same as Full. JS functions are
                                available globally — no import needed.
                            </div>
                            <CodeBlock frame="sc" lang="html" label="index.html" code={qsInteractivePage} />
                            <div
                                style="margin-top:10px;font-size:13px;color:var(--color-muted)"
                            >
                                JS API: <code>openModal</code> · <code
                                    >closeModal</code
                                > · <code>showToast</code> · <code
                                    >tabSwitch</code
                                > · <code>collapseToggle</code> · <code
                                    >dropdownToggle</code
                                >. See the <a
                                    href="#javascript"
                                    style="color:var(--color-primary)"
                                    >JavaScript reference</a
                                >.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="doc-tip" style="margin-top:28px">
                    <span class="doc-tip-icon">📦</span>
                    <div class="doc-tip-text">
                        <strong>More install options:</strong> npm install, download
                        ZIP, or import individual CSS files. See the <a
                            href={`${base}quickstart`}
                            style="color:var(--color-primary)"
                            >Quick Start guide</a
                        > for all methods.
                    </div>
                </div>
            </section>

            <div class="doc-divider"></div>

            <!-- ══════════ THEMES ══════════ -->
            <section class="doc-section" id="themes">
                <div class="doc-section-header">
                    <span class="sc-eyebrow">Theme system</span>
                    <h2 class="sc-heading">Themes</h2>
                    <p class="sc-subheading">
                        9 built-in themes, each defined as a complete set of CSS
                        custom properties. Switch the entire UI with one
                        attribute — no JavaScript required.
                    </p>
                </div>

                <div class="doc-themes-grid" style="margin-bottom:28px">
                    {DOC_THEME_SWATCHES.map((t) => (
                        <div
                            class={`doc-theme-swatch${t.name === 'dark' ? ' selected' : ''}`}
                            onclick={`switchTheme(this,'${t.name}')`}
                            data-tc={t.name}
                            style={`background:${t.bg}`}
                        >
                            <div class="doc-theme-top" style={`background:${t.bg}`}>
                                <div class="doc-theme-dot-b" style={`background:${t.dot}`} />
                            </div>
                            <div class="doc-theme-name" style={`background:${t.nameBg};color:${t.nameColor}`}>
                                {t.label}
                            </div>
                        </div>
                    ))}
                </div>

                <CodeBlock frame="sc" lang="js" label="Theme switching" code={themeSwitchCode} />
            </section>

            <div class="doc-divider"></div>

            <!-- ══════════ COMPONENTS ══════════ -->
            <section class="doc-section" id="components">
                <!-- ── Full / Interactive: class-based components ── -->
                <div data-flavor-code="full interactive">
                    <div class="doc-section-header">
                        <span class="sc-eyebrow">Reference</span>
                        <h2 class="sc-heading">Components</h2>
                        <p class="sc-subheading">
                            30+ components included. Browse live demos and code
                            at <a
                                href="../index.html"
                                style="color:var(--color-primary)"
                                >the components page</a
                            >.
                        </p>
                    </div>

                    <div class="doc-grid doc-grid-auto">
                        {DOC_COMPONENT_CARDS.map((c) => (
                            <div class="doc-card">
                                <div class="doc-card-title">
                                    {c.t}{c.note && (
                                        <span style="font-size:10px;color:var(--color-muted);font-weight:400"> {c.note}</span>
                                    )}
                                </div>
                                <div class="doc-card-mono" set:html={c.lines.join('<br />')} />
                            </div>
                        ))}
                    </div>

                    <div class="doc-tip" style="margin-top:20px">
                        <span class="doc-tip-icon">⚡</span>
                        <div class="doc-tip-text">
                            Components marked <strong>JS</strong> require <code
                                >njx.js</code
                            > for interactivity. Components marked <strong
                                >native</strong
                            > use <code>&lt;details&gt;</code>/<code
                                >&lt;summary&gt;</code
                            > and work without any JavaScript.
                        </div>
                    </div>
                </div><!-- /full interactive -->

                <!-- ── Classless: styled HTML elements ── -->
                <div data-flavor-code="classless" style="display:none">
                    <div class="doc-section-header">
                        <span class="sc-eyebrow">Reference</span>
                        <h2 class="sc-heading">Styled Elements</h2>
                        <p class="sc-subheading">
                            Every native HTML element below is styled
                            automatically — no class names required. Just write
                            semantic HTML.
                        </p>
                    </div>

                    <div class="doc-grid doc-grid-auto">
                        {DOC_CLASSLESS_CARDS.map((c) => (
                            <div class="doc-card">
                                <div class="doc-card-title">
                                    {c.t}{c.note && (
                                        <span style="font-size:10px;color:var(--color-muted);font-weight:400"> {c.note}</span>
                                    )}
                                </div>
                                <div class="doc-card-mono" set:html={c.lines.join('<br />')} />
                            </div>
                        ))}
                    </div>

                    <div class="doc-tip" style="margin-top:20px">
                        <span class="doc-tip-icon">💡</span>
                        <div class="doc-tip-text">
                            All these elements respond to <code>data-theme</code
                            > — switch to any of 9 themes with zero extra CSS. Want
                            component classes (<code>.btn-glow</code>, <code
                                >.card-glass</code
                            >...)? Switch to <strong>Full</strong> mode.
                        </div>
                    </div>
                </div><!-- /classless -->
            </section>

            <div class="doc-divider"></div>

            <!-- ══════════ JAVASCRIPT ══════════ -->
            <section class="doc-section" id="javascript">
                <!-- ── Classless: no JS needed ── -->
                <div data-flavor-code="classless" style="display:none">
                    <div class="doc-section-header">
                        <span class="sc-eyebrow">Reference</span>
                        <h2 class="sc-heading">JavaScript</h2>
                        <p class="sc-subheading">
                            Classless mode requires <strong
                                >zero JavaScript</strong
                            >. Interactive elements work natively via HTML.
                        </p>
                    </div>
                    <div class="doc-tip">
                        <span class="doc-tip-icon">💡</span>
                        <div class="doc-tip-text">
                            <strong>Collapse / Accordion</strong> — use <code
                                >&lt;details&gt;&lt;summary&gt;</code
                            >, browser handles open/close natively.<br />
                            <strong>Dialogs</strong> — use <code
                                >&lt;dialog&gt;</code
                            > with <code>showModal()</code> — no library needed.<br
                            />
                            <strong>Forms</strong> — native validation with <code
                                >required</code
                            >, <code>pattern</code>, <code>type</code> attributes.<br
                            /><br />
                            Want <code>openModal()</code>, <code
                                >showToast()</code
                            >, <code>tabSwitch()</code>? Switch to <strong
                                >Interactive</strong
                            > mode.
                        </div>
                    </div>
                    <div style="margin-top:24px">
                        <h3
                            style="font-size:15px;font-weight:700;margin-bottom:12px;color:var(--color-light)"
                        >
                            Native HTML — no JS needed
                        </h3>
                        <CodeBlock frame="sc" lang="html" code={nativeNoJs} />
                    </div>
                </div><!-- /classless -->

                <!-- ── Full / Interactive: njx.js reference ── -->
                <div data-flavor-code="full interactive">
                    <div class="doc-section-header">
                        <span class="sc-eyebrow">Reference</span>
                        <h2 class="sc-heading">JavaScript — njx.js</h2>
                        <p class="sc-subheading">
                            One script file for all interactive components.
                            Include it once — everything initializes
                            automatically.
                        </p>
                    </div>

                    <!-- Connection -->
                    <h3
                        style="font-size:16px;font-weight:700;margin-bottom:12px"
                    >
                        Connection
                    </h3>
                    <CodeBlock frame="sc" lang="html" label="index.html" style="margin-bottom:28px" code={jsConnection} />

                    <!-- Which components need JS -->
                    <h3
                        style="font-size:16px;font-weight:700;margin-bottom:16px"
                    >
                        Which components need JS
                    </h3>
                    <div
                        class="doc-token-table-wrap"
                        style="margin-bottom:28px"
                    >
                        <table class="doc-token-table">
                            <thead>
                                <tr>
                                    <th>Component</th>
                                    <th>Without JS</th>
                                    <th>With njx.js</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="tok">Collapse</td>
                                    <td
                                        style="font-size:12px;color:var(--color-muted)"
                                        ><code>details.collapse</code> — работает
                                        нативно</td
                                    >
                                    <td
                                        style="font-size:12px;color:var(--color-muted)"
                                        ><code>collapseToggle()</code> для div-based
                                        + аккордеон</td
                                    >
                                </tr>
                                <tr>
                                    <td class="tok">Dropdown</td>
                                    <td
                                        style="font-size:12px;color:var(--color-muted)"
                                        ><code>details.dropdown</code> — работает
                                        нативно</td
                                    >
                                    <td
                                        style="font-size:12px;color:var(--color-muted)"
                                        ><code>dropdownToggle()</code> для div-based
                                        + close on outside click</td
                                    >
                                </tr>
                                <tr>
                                    <td class="tok">Tabs</td>
                                    <td
                                        style="font-size:12px;color:var(--color-muted)"
                                        >—</td
                                    >
                                    <td
                                        style="font-size:12px;color:var(--color-muted)"
                                        ><code>tabSwitch()</code> — переключение панелей</td
                                    >
                                </tr>
                                <tr>
                                    <td class="tok">Modal</td>
                                    <td
                                        style="font-size:12px;color:var(--color-muted)"
                                        >—</td
                                    >
                                    <td
                                        style="font-size:12px;color:var(--color-muted)"
                                        ><code>openModal()</code> / <code
                                            >closeModal()</code
                                        >
                                        + Escape</td
                                    >
                                </tr>
                                <tr>
                                    <td class="tok">Carousel</td>
                                    <td
                                        style="font-size:12px;color:var(--color-muted)"
                                        >Scroll-snap работает, якорные кнопки
                                        работают</td
                                    >
                                    <td
                                        style="font-size:12px;color:var(--color-muted)"
                                        ><code>initCarousels()</code> — синхронизация
                                        dots при свайпе</td
                                    >
                                </tr>
                                <tr>
                                    <td class="tok">Toast</td>
                                    <td
                                        style="font-size:12px;color:var(--color-muted)"
                                        >—</td
                                    >
                                    <td
                                        style="font-size:12px;color:var(--color-muted)"
                                        ><code>showToast()</code> — динамические уведомления
                                    </td>
                                </tr>
                                <tr>
                                    <td class="tok"
                                        >Buttons, Cards, Forms, Nav, Links,
                                        Tags, Table, Progress, Gradients,
                                        Animations</td
                                    >
                                    <td
                                        colspan="2"
                                        style="font-size:12px;color:var(--color-success)"
