    var preEl = document.getElementById('qs3-cpre');
    var previewEl = document.getElementById('qs3-cpreview');
    var fnameEl = document.getElementById('qs3-cfname');
    var langEl = document.getElementById('qs3-clang');
    var card = document.getElementById('qs3-ccard');
    var curBlock = 'b1';
    var curTab = 0;

    function renderTabs() {
      var b = BLOCKS[curBlock];
      var useClassless = window._qsMode === 'classless';
      var tabs = useClassless && b.classlessTabs ? b.classlessTabs : b.tabs;
      tabsEl.innerHTML = '';
      tabs.forEach(function (t, i) {
        var btn = document.createElement('button');
        btn.className = i === curTab ? 'on' : '';
        btn.textContent = t.name;
        btn.onclick = function () {
          curTab = i;
          renderTab();
        };
        tabsEl.appendChild(btn);
      });
      renderTab();
    }
    function renderTab() {
      var b = BLOCKS[curBlock];
      var useClassless = window._qsMode === 'classless';
      var tabs = useClassless && b.classlessTabs ? b.classlessTabs : b.tabs;
      var t = tabs[curTab] || tabs[0];
      preEl.innerHTML =
        useClassless && t.classlessCode ? t.classlessCode : t.code;
      if (window._qsApplyModeToCode) window._qsApplyModeToCode(preEl);
      fnameEl.textContent = t.fname || b.fname;
      langEl.textContent = t.lang || 'HTML';
      previewEl.innerHTML =
        useClassless && t.classlessPreview
          ? t.classlessPreview
          : t.preview || '';
      if (t.themePreview) {
        previewEl.innerHTML =
          '<button class="btn btn-primary btn-sm">Primary</button> <span class="tag tag-primary">live</span>';
        previewEl.setAttribute('data-theme', t.themePreview);
      } else {
        previewEl.removeAttribute('data-theme');
      }
      Array.from(tabsEl.children).forEach(function (c, i) {
        c.classList.toggle('on', i === curTab);
      });
    }

    // Scroll-spy
    var blocks = Array.from(document.querySelectorAll('.qs3-block'));
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting && e.intersectionRatio > 0.3) {
            if (curBlock !== e.target.id.replace('qs3-', '')) {
              curBlock = e.target.id.replace('qs3-', '');
              curTab = 0;
              renderTabs();
            }
          }
        });
      },
      { threshold: [0.3, 0.6], rootMargin: '-80px 0px -50% 0px' },
    );
    blocks.forEach(function (b) {
      io.observe(b);
    });

    // Preview toggle
    var tbCode = document.getElementById('qs3-tb-code');
    var tbBoth = document.getElementById('qs3-tb-both');
    if (tbCode)
      tbCode.onclick = function () {
        card.classList.remove('show-preview');
        tbCode.classList.add('on');
        tbBoth.classList.remove('on');
      };
    if (tbBoth)
      tbBoth.onclick = function () {
        card.classList.add('show-preview');
        tbBoth.classList.add('on');
        tbCode.classList.remove('on');
      };

    // Copy
    var ccopy = document.getElementById('qs3-ccopy');
    if (ccopy) ccopy.onclick = function () { qsCopy(preEl.innerText, ccopy); };

    renderTabs();
    window._qsRenderTab = renderTabs;
  }

  // Первичный запуск + повтор после каждой VT-навигации: ClientRouter не
  // перевыполняет одинаковые инлайн-скрипты, поэтому вешаемся на astro:page-load;
  // dataset-гварды внутри init-функций защищают от двойного запуска
  function qsInitAll() {
    initQsNew();
    initQs3Pane();
  }
  qsInitAll();
  document.addEventListener('astro:page-load', qsInitAll);

  // ══════════════════════ MODE BAR ══════════════════════
  // Общая механика (табы, hint, show/hide, persist) — njxSyncModeUI из
  // njx-site.js; ниже только специфика quickstart (рендер трека/кода)
  var QS_CSS_FILE = {
    full: 'style.min.css',
    classless: 'classless.min.css',
    interactive: 'style.min.css',
  };

  function qsSyncMode(flavor) {
    njxSyncModeUI(flavor, {
      tabSel: '#qs-mode-bar .doc-mode-tab',
      hintId: 'qs-mode-hint',
      blockAttr: 'data-qs-mode',
    });

    // Global mode + css file vars (used by PATHS getters and render hooks)
    window._qsMode = flavor;
    window._qsCssFile = QS_CSS_FILE[flavor] || 'style.min.css';

    // Code transformation hook (used by renderTab)
    var _cssFile = window._qsCssFile;
    window._qsApplyModeToCode = function (el) {
      if (!el) return;
      el.innerHTML = el.innerHTML.replace(/style\.min\.css/g, _cssFile);
    };

    // Re-render the progress tracker + code card
    if (window._qsRender) window._qsRender();
    if (window._qsRenderTab) window._qsRenderTab();

    // Static data-qs-cssfile spans
    document.querySelectorAll('[data-qs-cssfile]').forEach(function (el) {
      el.textContent = window._qsCssFile;
    });

    // JS step (interactive only)
    document.querySelectorAll('[data-qs-jsonly]').forEach(function (el) {
      el.style.display = flavor === 'interactive' ? '' : 'none';
    });
  }

  // Init from saved flavor (общий ключ с documentation)
  if (njxSavedFlavor() !== 'full') qsSyncMode(njxSavedFlavor());
  document.addEventListener('astro:page-load', function () {
    qsSyncMode(njxSavedFlavor());
  });
</script>
