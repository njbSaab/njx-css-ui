<span class="com"># link it</span>
<span class="hi">&lt;<span class="sh-tag">link</span> <span class="attr">rel</span>=<span class="str">"stylesheet"</span> <span class="attr">href</span>=<span class="str">"./vendor/njx-css-ui-main/css/style.min.css"</span>&gt;
</span>`,
            preview: `<button class="btn btn-primary">Ship it</button>`,
          },
        ],
      },
      b2: {
        title: 'Theme',
        fname: 'index.html',
        tabs: [
          {
            k: 'dark',
            name: 'dark',
            lang: 'HTML',
            code: `<span class="hi">&lt;<span class="sh-tag">html</span> <span class="attr">data-theme</span>=<span class="str">"dark"</span>&gt;
</span>  &lt;<span class="sh-tag">button</span> <span class="attr">class</span>=<span class="str">"btn btn-primary"</span>&gt;Primary&lt;/<span class="sh-tag">button</span>&gt;
  &lt;<span class="sh-tag">span</span> <span class="attr">class</span>=<span class="str">"tag tag-primary"</span>&gt;live&lt;/<span class="sh-tag">span</span>&gt;
&lt;/<span class="sh-tag">html</span>&gt;`,
            classlessCode: `<span class="hi">&lt;<span class="sh-tag">html</span> <span class="attr">data-theme</span>=<span class="str">"dark"</span>&gt;
</span>  &lt;<span class="sh-tag">button</span>&gt;Primary&lt;/<span class="sh-tag">button</span>&gt;
  &lt;<span class="sh-tag">p</span>&gt;Styled automatically.&lt;/<span class="sh-tag">p</span>&gt;
&lt;/<span class="sh-tag">html</span>&gt;`,
            themePreview: 'dark',
          },
          {
            k: 'purple',
            name: 'purple',
            lang: 'HTML',
            code: `<span class="hi">&lt;<span class="sh-tag">html</span> <span class="attr">data-theme</span>=<span class="str">"purple"</span>&gt;
</span>  &lt;<span class="sh-tag">button</span> <span class="attr">class</span>=<span class="str">"btn btn-primary"</span>&gt;Primary&lt;/<span class="sh-tag">button</span>&gt;
  &lt;<span class="sh-tag">span</span> <span class="attr">class</span>=<span class="str">"tag tag-primary"</span>&gt;live&lt;/<span class="sh-tag">span</span>&gt;
&lt;/<span class="sh-tag">html</span>&gt;`,
            classlessCode: `<span class="hi">&lt;<span class="sh-tag">html</span> <span class="attr">data-theme</span>=<span class="str">"purple"</span>&gt;
</span>  &lt;<span class="sh-tag">button</span>&gt;Primary&lt;/<span class="sh-tag">button</span>&gt;
  &lt;<span class="sh-tag">p</span>&gt;Styled automatically.&lt;/<span class="sh-tag">p</span>&gt;
&lt;/<span class="sh-tag">html</span>&gt;`,
            themePreview: 'purple',
          },
          {
            k: 'green',
            name: 'green',
            lang: 'HTML',
            code: `<span class="hi">&lt;<span class="sh-tag">html</span> <span class="attr">data-theme</span>=<span class="str">"green"</span>&gt;
</span>  &lt;<span class="sh-tag">button</span> <span class="attr">class</span>=<span class="str">"btn btn-primary"</span>&gt;Primary&lt;/<span class="sh-tag">button</span>&gt;
  &lt;<span class="sh-tag">span</span> <span class="attr">class</span>=<span class="str">"tag tag-primary"</span>&gt;live&lt;/<span class="sh-tag">span</span>&gt;
&lt;/<span class="sh-tag">html</span>&gt;`,
            classlessCode: `<span class="hi">&lt;<span class="sh-tag">html</span> <span class="attr">data-theme</span>=<span class="str">"green"</span>&gt;
</span>  &lt;<span class="sh-tag">button</span>&gt;Primary&lt;/<span class="sh-tag">button</span>&gt;
  &lt;<span class="sh-tag">p</span>&gt;Styled automatically.&lt;/<span class="sh-tag">p</span>&gt;
&lt;/<span class="sh-tag">html</span>&gt;`,
            themePreview: 'green',
          },
          {
            k: 'persist',
            name: 'Persist',
            lang: 'JS',
            fname: 'theme.js',
            code: `<span class="com">// before the library loads</span>
<span class="kw">const</span> saved = localStorage.getItem(<span class="str">'theme'</span>);
<span class="kw">if</span> (saved) {
  document.documentElement.setAttribute(<span class="str">'data-theme'</span>, saved);
}

<span class="com">// whenever the user picks one</span>
<span class="kw">function</span> setTheme(t) {
  document.documentElement.setAttribute(<span class="str">'data-theme'</span>, t);
  localStorage.setItem(<span class="str">'theme'</span>, t);
}`,
            preview: `<button class="btn btn-primary btn-sm">Primary</button> <span class="tag tag-primary">live</span>`,
          },
        ],
      },
      b3: {
        title: 'Compose',
        fname: 'buttons.html',
        tabs: [
          {
            k: 'color',
            name: 'Color',
