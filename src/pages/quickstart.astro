---
import BaseLayout from '../layouts/BaseLayout.astro';
import PagesTopbar from '../components/PagesTopbar.astro';
import PagesFooter from '../components/PagesFooter.astro';
import Bottombar from '../components/Bottombar.astro';
import '../styles/quickstart-page.css';
import QsHero from '../components/qs-sections/QsHero.astro';
import QsPane from '../components/qs-sections/QsPane.astro';
import QsSteps from '../components/qs-sections/QsSteps.astro';
import QsShelf from '../components/qs-sections/QsShelf.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Quick Start — njX UI · One CDN link. Nine themes. Zero build tools."
  description="One CDN link. Nine themes ready to go. No bundler, no config. CDN in 30 seconds, npm in 60."
>
  <!-- ══ NAV ══ -->
  <PagesTopbar activePage="quickstart" />

  <QsHero />

  <QsPane />

  <QsSteps />

  <QsShelf />

  <PagesFooter activePage="quickstart" />
  <Bottombar activePage="quickstart" />
</BaseLayout>

<!-- ══════════════════════ STYLES ══════════════════════ -->

<!-- ══════════════════════ PAGE JS ══════════════════════ -->
<script is:inline>
  // ── Shared copy helper for this page (njxCopyBtn — из njx-site.js) ──
  function qsCopy(text, btn) {
    njxCopyBtn(btn, text, { ms: 1500 });
  }

  function initQsNew() {
    var track = document.getElementById('qs-track');
    if (!track) return;
    // Идемпотентность: dataset живёт на DOM-узле и сбрасывается вместе с ним
    // при VT-навигации — в свежем DOM init выполнится заново, в текущем нет
    if (track.dataset.qsInit === '1') return;
    track.dataset.qsInit = '1';

    window._qsCssFile = window._qsCssFile || 'style.min.css';
    window._qsMode = window._qsMode || 'full';

    var PATHS = {
      cdn: [
        {
          h: 'Drop the link',
          meta: '~10s',
          d: "Paste this single &lt;link&gt; into your &lt;head&gt;. That's the whole library.",
          get code() {
            return (
              '&lt;<span class="sh-tag">link</span> <span class="attr">rel</span>=<span class="str">"stylesheet"</span> <span class="attr">href</span>=<span class="str">"https://cdn.jsdelivr.net/npm/njx-ui@1/css/' +
              window._qsCssFile +
              '"</span>&gt;'
            );
          },
          check: 'Pasted',
        },
        {
          h: 'Pick a theme',
          meta: '~5s',
          d: 'Set <code>data-theme</code> on &lt;html&gt;. 9 options: dark, light, red, blue, green, cyan, yellow, pink, purple.',
          code: '&lt;<span class="sh-tag">html</span> <span class="attr">lang</span>=<span class="str">"en"</span> <span class="attr">data-theme</span>=<span class="str">"dark"</span>&gt;',
          check: 'Themed',
        },
        {
          h: 'Use a class',
          meta: '~10s',
          d: 'Any <code>.btn</code>, <code>.inp</code>, <code>.tag</code> on the page now styles itself. No imports.',
          code: '&lt;<span class="sh-tag">button</span> <span class="attr">class</span>=<span class="str">"btn btn-primary"</span>&gt;Ship it&lt;/<span class="sh-tag">button</span>&gt;\n&lt;<span class="sh-tag">input</span>  <span class="attr">class</span>=<span class="str">"inp inp-primary"</span> <span class="attr">placeholder</span>=<span class="str">"email"</span>&gt;\n&lt;<span class="sh-tag">span</span>   <span class="attr">class</span>=<span class="str">"tag tag-success"</span>&gt;live&lt;/<span class="sh-tag">span</span>&gt;',
          check: 'Used',
        },
        {
          h: 'Customize a token',
          meta: '~5s',
          d: 'Override one variable to brand your build. Everything that uses <code>--color-primary</code> retints.',
          code: '&lt;<span class="sh-tag">style</span>&gt;\n  <span class="sh-tag">:root</span> &#123; <span class="attr">--color-primary</span>: <span class="str">#ff6b35</span>; &#125;\n&lt;/<span class="sh-tag">style</span>&gt;',
          check: 'Branded',
        },
      ],
      npm: [
        {
          h: 'Install package',
          meta: '~30s',
          d: 'Add the package. Works with npm, pnpm, yarn or bun.',
          code: '<span class="com"># pick your manager</span>\nnpm  install njx-ui\npnpm add     njx-ui\nbun  add     njx-ui',
          check: 'Installed',
        },
        {
          h: 'Import CSS',
          meta: '~5s',
          d: 'Pull the stylesheet into your entry file. Vite, webpack, esbuild — all fine.',
          get code() {
            return (
              '<span class="com">// src/main.ts (or main.js)</span>\n<span class="sh-tag">import</span> <span class="str">"njx-ui/css/' +
              window._qsCssFile +
              '"</span>;'
            );
          },
          check: 'Imported',
        },
        {
          h: 'Set theme attribute',
          meta: '~5s',
          d: 'Set on &lt;html&gt; for the whole app, or any wrapper for a scoped theme.',
          code: '<span class="com">&lt;!-- index.html --&gt;</span>\n&lt;<span class="sh-tag">html</span> <span class="attr">data-theme</span>=<span class="str">"dark"</span>&gt;',
          check: 'Themed',
        },
        {
          h: 'Use in a component',
          meta: '~10s',
          d: 'Apply utility classes anywhere. React, Vue, Svelte — same string.',
          code: '<span class="sh-tag">export</span> <span class="sh-tag">function</span> <span class="attr">Login</span>() &#123;\n  <span class="sh-tag">return</span> (\n    &lt;<span class="sh-tag">form</span> <span class="attr">className</span>=<span class="str">"card"</span>&gt;\n      &lt;<span class="sh-tag">input</span> <span class="attr">className</span>=<span class="str">"inp inp-primary"</span> /&gt;\n      &lt;<span class="sh-tag">button</span> <span class="attr">className</span>=<span class="str">"btn btn-primary"</span>&gt;Sign in&lt;/<span class="sh-tag">button</span>&gt;\n    &lt;/<span class="sh-tag">form</span>&gt;\n  );\n&#125;',
          check: 'Used',
        },
      ],
      zip: [
        {
          h: 'Download source ZIP',
          meta: '~20s',
          d: 'Grab the latest source ZIP from GitHub (main branch).',
          dl: 'https://github.com/njbSaab/njx-css-ui/archive/refs/heads/main.zip',
          check: 'Downloaded',
        },
        {
          h: 'Copy into project',
          meta: '~10s',
          get d() {
            return (
              'Drop the <code>' +
              window._qsCssFile +
              '</code> file anywhere your server can serve it from.'
            );
          },
          get code() {
            return (
              '<span class="com"># tree</span>\nyour-project/\n&#x251C;&#x2500; index.html\n&#x2514;&#x2500; vendor/\n   &#x2514;&#x2500; njx-css-ui/\n      &#x2514;&#x2500; ' +
              window._qsCssFile
            );
          },
          check: 'Copied',
        },
        {
          h: 'Link the file',
          meta: '~10s',
          d: 'Reference it from your &lt;head&gt;. Relative path is fine.',
          get code() {
            return (
              '&lt;<span class="sh-tag">link</span> <span class="attr">rel</span>=<span class="str">"stylesheet"</span>\n      <span class="attr">href</span>=<span class="str">"./vendor/njx-css-ui/' +
              window._qsCssFile +
              '"</span>&gt;\n&lt;<span class="sh-tag">html</span> <span class="attr">data-theme</span>=<span class="str">"dark"</span>&gt;'
            );
          },
          check: 'Linked',
        },
        {
          h: 'Use the classes',
          meta: '~10s',
          d: 'Same classes as the CDN path. No build, no bundler — just HTML.',
          code: '&lt;<span class="sh-tag">button</span> <span class="attr">class</span>=<span class="str">"btn btn-primary"</span>&gt;Ship it&lt;/<span class="sh-tag">button</span>&gt;',
          check: 'Used',
        },
      ],
    };

    // Classless-specific path steps
    var CLASSLESS_PATHS = {
      cdn: [
        {
          h: 'Drop the link',
          meta: '~10s',
          d: 'Paste this single &lt;link&gt; into your &lt;head&gt;. One file — 47 KB standalone.',
          get code() {
            return '&lt;<span class="sh-tag">link</span> <span class="attr">rel</span>=<span class="str">"stylesheet"</span> <span class="attr">href</span>=<span class="str">"https://cdn.jsdelivr.net/npm/njx-ui@1/css/classless.min.css"</span>&gt;';
          },
          check: 'Pasted',
        },
        {
          h: 'Pick a theme',
          meta: '~5s',
          d: 'Set <code>data-theme</code> on &lt;html&gt;. 9 built-in themes, all work in classless mode.',
          code: '&lt;<span class="sh-tag">html</span> <span class="attr">lang</span>=<span class="str">"en"</span> <span class="attr">data-theme</span>=<span class="str">"dark"</span>&gt;',
          check: 'Themed',
        },
        {
          h: 'Write HTML',
          meta: '~5s',
          d: 'No class names needed. Every native element is styled automatically.',
          code: '&lt;<span class="sh-tag">button</span>&gt;Click me&lt;/<span class="sh-tag">button</span>&gt;\n&lt;<span class="sh-tag">input</span> <span class="attr">type</span>=<span class="str">"text"</span> <span class="attr">placeholder</span>=<span class="str">"email"</span>&gt;\n&lt;<span class="sh-tag">details</span>&gt;&lt;<span class="sh-tag">summary</span>&gt;FAQ&lt;/<span class="sh-tag">summary</span>&gt;Answer&lt;/<span class="sh-tag">details</span>&gt;',
          check: 'Done!',
        },
      ],
      npm: [
        {
          h: 'Install package',
          meta: '~30s',
          d: 'Add the package. Works with npm, pnpm, yarn or bun.',
          code: '<span class="com"># pick your manager</span>\nnpm  install njx-ui\npnpm add     njx-ui',
          check: 'Installed',
        },
        {
          h: 'Import classless CSS',
          meta: '~5s',
          d: 'Import only the classless file — 47 KB, no component classes.',
          code: '<span class="com">// src/main.ts (or main.js)</span>\n<span class="sh-tag">import</span> <span class="str">"njx-ui/css/classless.min.css"</span>;',
          check: 'Imported',
        },
        {
          h: 'Write HTML',
          meta: '~5s',
          d: 'No class names needed. Semantic HTML is styled automatically.',
          code: '<span class="com">&lt;!-- Just write HTML --&gt;</span>\n&lt;<span class="sh-tag">h1</span>&gt;Hello&lt;/<span class="sh-tag">h1</span>&gt;\n&lt;<span class="sh-tag">button</span>&gt;Action&lt;/<span class="sh-tag">button</span>&gt;',
          check: 'Done!',
        },
      ],
      zip: [
        {
          h: 'Download source ZIP',
          meta: '~20s',
          d: 'Grab the latest source ZIP from GitHub (main branch).',
          dl: 'https://github.com/njbSaab/njx-css-ui/archive/refs/heads/main.zip',
          check: 'Downloaded',
        },
        {
          h: 'Copy the file',
          meta: '~10s',
          d: 'Drop <code>classless.min.css</code> into your project.',
          code: '<span class="com"># tree</span>\nyour-project/\n&#x251C;&#x2500; index.html\n&#x2514;&#x2500; vendor/\n   &#x2514;&#x2500; classless.min.css',
          check: 'Copied',
        },
        {
          h: 'Link the file',
          meta: '~10s',
          d: "One link tag. That's it.",
          code: '&lt;<span class="sh-tag">link</span> <span class="attr">rel</span>=<span class="str">"stylesheet"</span>\n      <span class="attr">href</span>=<span class="str">"./vendor/classless.min.css"</span>&gt;',
          check: 'Done!',
        },
      ],
    };

    var curP = 'cdn';
    var done = {};

    function render() {
      var activePaths =
        window._qsMode === 'classless' ? CLASSLESS_PATHS : PATHS;
      var steps = activePaths[curP] || activePaths['cdn'];
      track.innerHTML = '';
      steps.forEach(function (st, i) {
        var isDone = !!done[curP + '-' + i];
        var isActive = !isDone && (i === 0 || !!done[curP + '-' + (i - 1)]);
        var el = document.createElement('div');
        el.className =
          'qs-step' + (isDone ? ' done' : '') + (isActive ? ' active' : '');
        el.innerHTML =
          '<div class="num"><span>' +
          (i + 1) +
          '</span></div>' +
          '<div class="body">' +
          '<div class="h">' +
          st.h +
          '<span class="meta">' +
          st.meta +
          '</span></div>' +
          '<div class="d">' +
          st.d +
          '</div>' +
          (st.dl
            ? '<a class="qs-dl-btn" href="' +
              st.dl +
              '" download>⬇ Download njx-css-ui (main.zip)</a>'
            : '<div class="code"><button class="copy">Copy</button><pre>' +
              st.code +
              '</pre></div>') +
          '<div class="actions">' +
          '<button class="check" data-i="' +
          i +
          '">' +
          (isDone ? st.check : 'I did this →') +
          '</button>' +
          (isDone
            ? ''
            : '<button class="skip" data-i="' + i + '">Skip</button>') +
          '</div>' +
          '</div>';
        track.appendChild(el);
      });

      track.querySelectorAll('.check, .skip').forEach(function (b) {
        b.onclick = function () {
          done[curP + '-' + b.dataset.i] = true;
          updateProgress();
        };
      });
      track.querySelectorAll('.copy').forEach(function (b) {
        b.onclick = function () {
          qsCopy(this.parentElement.querySelector('pre').innerText, this);
        };
      });
      updateProgress();
    }

    function updateProgress() {
      var activePaths =
        window._qsMode === 'classless' ? CLASSLESS_PATHS : PATHS;
      var steps = activePaths[curP] || activePaths['cdn'];
      var completed = steps.reduce(function (n, _, i) {
        return n + (done[curP + '-' + i] ? 1 : 0);
      }, 0);
      var prog = document.getElementById('qs-prog');
      var clock = document.getElementById('qs-clock');
      var success = document.getElementById('qs-success');
      if (prog) prog.style.width = (completed / steps.length) * 100 + '%';
      if (clock) clock.textContent = completed + '/' + steps.length;
      if (success) success.classList.toggle('show', completed === steps.length);

      track.querySelectorAll('.qs-step').forEach(function (el, i) {
        var isDone = !!done[curP + '-' + i];
        var isActive = !isDone && (i === 0 || !!done[curP + '-' + (i - 1)]);
        el.classList.toggle('done', isDone);
        el.classList.toggle('active', isActive);
        var cb = el.querySelector('.check');
        if (cb) cb.textContent = isDone ? steps[i].check : 'I did this →';
        var sk = el.querySelector('.skip');
        if (sk && isDone) sk.remove();
      });
    }

    document.querySelectorAll('#qs-paths button').forEach(function (b) {
      b.onclick = function () {
        document.querySelectorAll('#qs-paths button').forEach(function (x) {
          x.classList.remove('on');
        });
        b.classList.add('on');
        curP = b.dataset.p;
        done = {};
        render();
      };
    });

    render();
    window._qsRender = function () {
      done = {};
      render();
    };
    window._qsClasslessPaths = CLASSLESS_PATHS;
  }

  function initQs3Pane() {
    var tabsEl = document.getElementById('qs3-ctabs');
    if (!tabsEl) return;
    if (tabsEl.dataset.qsInit === '1') return;
    tabsEl.dataset.qsInit = '1';

    var BLOCKS = {
      b1: {
        title: 'Install',
        fname: 'index.html',
        tabs: [
          {
            k: 'cdn',
            name: 'CDN',
            lang: 'HTML',
            code: `<span class="com">&lt;!-- index.html --&gt;</span>
&lt;<span class="sh-tag">!DOCTYPE</span> html&gt;
&lt;<span class="sh-tag">html</span> <span class="attr">data-theme</span>=<span class="str">"dark"</span>&gt;
&lt;<span class="sh-tag">head</span>&gt;
  <span class="hi">&lt;<span class="sh-tag">link</span> <span class="attr">rel</span>=<span class="str">"stylesheet"</span> <span class="attr">href</span>=<span class="str">"https://cdn.jsdelivr.net/npm/njx-ui@1/css/style.min.css"</span>&gt;
</span>&lt;/<span class="sh-tag">head</span>&gt;
&lt;<span class="sh-tag">body</span>&gt;
  &lt;<span class="sh-tag">button</span> <span class="attr">class</span>=<span class="str">"btn btn-primary"</span>&gt;Ship it&lt;/<span class="sh-tag">button</span>&gt;
&lt;/<span class="sh-tag">body</span>&gt;
&lt;/<span class="sh-tag">html</span>&gt;`,
            classlessCode: `<span class="com">&lt;!-- index.html --&gt;</span>
&lt;<span class="sh-tag">!DOCTYPE</span> html&gt;
&lt;<span class="sh-tag">html</span> <span class="attr">data-theme</span>=<span class="str">"dark"</span>&gt;
&lt;<span class="sh-tag">head</span>&gt;
  <span class="hi">&lt;<span class="sh-tag">link</span> <span class="attr">rel</span>=<span class="str">"stylesheet"</span> <span class="attr">href</span>=<span class="str">"https://cdn.jsdelivr.net/npm/njx-ui@1/css/classless.min.css"</span>&gt;
</span>&lt;/<span class="sh-tag">head</span>&gt;
&lt;<span class="sh-tag">body</span>&gt;
  &lt;<span class="sh-tag">button</span>&gt;Ship it&lt;/<span class="sh-tag">button</span>&gt;
&lt;/<span class="sh-tag">body</span>&gt;
&lt;/<span class="sh-tag">html</span>&gt;`,
            preview: `<button class="btn btn-primary">Ship it</button>`,
            classlessPreview: `<button>Ship it</button>`,
          },
          {
            k: 'npm',
            name: 'npm',
            lang: 'JS',
            fname: 'main.ts',
            code: `<span class="com">// terminal</span>
<span class="kw">$</span> npm install njx-ui

<span class="com">// src/main.ts</span>
<span class="hi"><span class="kw">import</span> <span class="str">"njx-ui/css/style.min.css"</span>;
</span>
<span class="kw">import</span> { createApp } <span class="kw">from</span> <span class="str">"vue"</span>;
<span class="kw">import</span> App <span class="kw">from</span> <span class="str">"./App.vue"</span>;

createApp(App).mount(<span class="str">"#app"</span>);`,
            preview: `<button class="btn btn-primary">Ship it</button>`,
          },
          {
