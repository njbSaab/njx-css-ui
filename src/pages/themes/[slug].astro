---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PagesTopbar from '../../components/PagesTopbar.astro';
import PagesFooter from '../../components/PagesFooter.astro';
import { ALL_THEMES, SERVICES } from '../../data/themesCatalog';

export function getStaticPaths() {
  return ALL_THEMES.map((t) => ({ params: { slug: t.slug }, props: { theme: t } }));
}

const { theme: t } = Astro.props;
const briefHref = `/themes#brief`;
---

<BaseLayout
    title={`${t.name} — ${t.tagline} | njX Astro Themes`}
    description={t.desc}
>
    <PagesTopbar activePage="themes" />

    <main class="themes-page tp-page">
        <!-- Hero -->
        <section class="tp-hero">
            <div class="tp-hero-copy">
                <a href="/themes" class="tp-back">← All themes</a>
                <span class="tag tag-primary">{t.tagline}</span>
                <h1>{t.name}</h1>
                <p>{t.longDesc}</p>
                <div class="contact-actions">
                    <a class="btn btn-primary btn-lg" href={t.demo} target="_blank" rel="noopener">Live demo</a>
                    {t.pro?.demo && (
                        <a class="btn btn-outline btn-lg" href={t.pro.demo} target="_blank" rel="noopener">Pro demo</a>
                    )}
                    <a class="btn btn-outline btn-lg" href={t.repo} target="_blank" rel="noopener">Free theme · GitHub ↗</a>
                </div>
                <div class="th-tags tp-tags">
                    {t.tags.map((tag) => <span>{tag}</span>)}
                </div>
            </div>
            <a class="tp-shot" href={t.demo} target="_blank" rel="noopener">
                <img src={t.img} alt={`${t.name} home page`} width="1280" height="720" />
            </a>
        </section>

        <!-- Pricing -->
        <section class="tp-section">
            <h2>Pricing</h2>
            <div class="tp-pricing">
                <!-- Free -->
                <article class="tp-price-card">
                    <p class="tp-price-name">Lite</p>
                    <p class="tp-price-value">Free</p>
                    <p class="tp-price-note">Open source · MIT · fork and ship</p>
                    <ul>
                        {t.liteFeatures.map((f) => <li>{f}</li>)}
                    </ul>
                    <a class="btn btn-outline" href={t.repo} target="_blank" rel="noopener">Get free theme on GitHub</a>
                </article>

                {t.pro && (
                    <>
                        <!-- Pro single -->
                        <article class="tp-price-card tp-featured">
                            <p class="tp-price-name">Pro · Single site</p>
                            <p class="tp-price-value">${t.pro.single}</p>
                            <p class="tp-price-note">One-time · 12 months of updates · email support</p>
                            <ul>
                                <li><strong>Everything in Lite, plus:</strong></li>
                                {t.pro.features.map((f) => <li>{f}</li>)}
                            </ul>
                            {t.pro.ready ? (
                                <a class="btn btn-primary" href={briefHref}>Buy Pro — ${t.pro.single}</a>
                            ) : (
                                <a class="btn btn-primary" href={briefHref}>Get notified — launching soon</a>
                            )}
                            {t.pro.ready && <p class="tp-price-small">Checkout launching shortly — the button opens a short form, we reply with a payment link the same day.</p>}
                        </article>

                        <!-- Pro unlimited -->
                        <article class="tp-price-card">
                            <p class="tp-price-name">Pro · Unlimited</p>
                            <p class="tp-price-value">${t.pro.unlimited}</p>
                            <p class="tp-price-note">Unlimited sites · lifetime updates · priority support (24–48h)</p>
                            <ul>
                                <li>Everything in Pro Single</li>
                                <li>Use on any number of client projects</li>
                                <li>Lifetime updates — pay once</li>
                                <li>Priority email support</li>
                            </ul>
                            <a class="btn btn-outline" href={briefHref}>{t.pro.ready ? `Buy Unlimited — $${t.pro.unlimited}` : 'Get notified'}</a>
                        </article>
                    </>
                )}
            </div>
            <p class="tp-support-note">
                Support covers theme defects and setup per the docs. Custom feature work is quoted separately — see services below.
            </p>
        </section>

        <!-- Services -->
        <section class="tp-section">
            <h2>Services</h2>
            <div class="tp-services">
                {SERVICES.map((s) => (
                    <article class="tp-service">
                        <p class="tp-service-name">{s.name} <span>{s.price}</span></p>
                        <p class="tp-service-desc">{s.desc}</p>
                        <a href={briefHref} class="tp-service-link">Request →</a>
                    </article>
                ))}
            </div>
        </section>

        <!-- CTA -->
        <div class="contact-tips card-glass tp-cta">
            <div>
                <h2>Questions before buying?</h2>
                <p>
                    Licensing, Shopify specifics, a feature you need — send a short
                    brief and we reply within a day with honest answers and a quote
                    if custom work is involved.
                </p>
            </div>
            <div class="contact-tip-grid">
                <a href={briefHref} class="tp-cta-btn btn btn-primary btn-lg">Ask / start a brief</a>
                <a href={t.demo} target="_blank" rel="noopener" class="btn btn-outline btn-lg">Open the demo</a>
            </div>
        </div>
    </main>

    <PagesFooter />
</BaseLayout>

<style is:global>
    .tp-page { padding-bottom: 96px; }
    .tp-hero {
        width: min(1120px, 100%);
        margin-inline: auto;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
        gap: clamp(28px, 4vw, 56px);
        align-items: center;
        padding: 48px 0 8px;
    }
    .tp-back {
        display: inline-block;
        margin-bottom: 14px;
        color: var(--color-muted);
        font-size: 13px;
        text-decoration: underline;
        text-underline-offset: 3px;
    }
    .tp-back:hover { color: var(--color-light); }
    .tp-hero h1 {
        margin-top: 14px;
        font-family: 'Roboto Mono', monospace;
        font-size: clamp(26px, 3.6vw, 40px);
        font-weight: 700;
    }
    .tp-hero p { margin-top: 14px; color: var(--color-muted); line-height: 1.7; font-size: 15px; }
    .tp-hero .contact-actions { margin-top: 22px; }
    .tp-tags { margin-top: 18px; }
    .tp-shot {
        display: block;
        overflow: hidden;
        border-radius: 16px;
        border: 1px solid color-mix(in srgb, #fff 12%, transparent);
        box-shadow: 0 30px 90px color-mix(in srgb, #000 30%, transparent);
    }
    .tp-shot img { display: block; width: 100%; height: auto; }

    .tp-section { width: min(1120px, 100%); margin: 56px auto 0; }
    .tp-section > h2 {
        font-family: 'Poppins', sans-serif;
        font-size: 26px;
        font-weight: 800;
        color: var(--color-light);
        margin-bottom: 20px;
    }

    .tp-pricing { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; align-items: start; }
    .tp-price-card {
        display: flex; flex-direction: column;
        border: 1px solid color-mix(in srgb, #fff 10%, transparent);
        border-radius: 16px;
        background: color-mix(in srgb, #fff 3%, transparent);
        padding: 24px;
    }
    .tp-featured {
        border-color: color-mix(in srgb, var(--color-primary) 55%, transparent);
        background:
            radial-gradient(circle at 20% 0, color-mix(in srgb, var(--color-primary) 16%, transparent), transparent 20rem),
            color-mix(in srgb, #fff 3%, transparent);
    }
    .tp-price-name { font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.5px; color: var(--color-primary); }
    .tp-price-value { margin-top: 8px; font-size: 40px; font-weight: 900; color: var(--color-light); }
    .tp-price-note { margin-top: 4px; font-size: 13px; color: var(--color-muted); }
    .tp-price-card ul { margin: 18px 0 22px; padding: 0; list-style: none; display: grid; gap: 9px; flex: 1; }
    .tp-price-card li {
        position: relative; padding-left: 20px;
        font-size: 13.5px; line-height: 1.5; color: var(--color-muted);
    }
    .tp-price-card li::before { content: '✓'; position: absolute; left: 0; color: var(--color-primary); font-weight: 900; }
    .tp-price-card .btn { justify-content: center; }
    .tp-price-small { margin-top: 10px; font-size: 12px; line-height: 1.5; color: var(--color-muted); }
    .tp-support-note { margin-top: 18px; font-size: 13px; color: var(--color-muted); }

    .tp-services { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
    .tp-service {
        border: 1px solid color-mix(in srgb, #fff 10%, transparent);
        border-radius: 16px; padding: 20px;
        background: color-mix(in srgb, #fff 3%, transparent);
    }
    .tp-service-name { display: flex; justify-content: space-between; gap: 10px; font-weight: 800; color: var(--color-light); font-size: 15px; }
    .tp-service-name span { color: var(--color-primary); white-space: nowrap; }
    .tp-service-desc { margin-top: 8px; font-size: 13.5px; line-height: 1.6; color: var(--color-muted); }
    .tp-service-link { display: inline-block; margin-top: 12px; color: var(--color-primary); font-size: 13px; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }

    .tp-cta { width: min(1120px, 100%); margin: 56px auto 0; }
    .tp-cta .contact-tip-grid { grid-template-columns: 1fr; }
    .tp-cta .btn { justify-content: center; }

    @media (max-width: 960px) {
        .tp-hero { grid-template-columns: 1fr; padding-top: 32px; }
        .tp-pricing, .tp-services { grid-template-columns: 1fr; }
    }
</style>
