---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PagesTopbar from '../../components/PagesTopbar.astro';
import PagesFooter from '../../components/PagesFooter.astro';
import { ALL_THEMES, SERVICES } from '../../data/themesCatalog';

export function getStaticPaths() {
  return ALL_THEMES.map((t) => ({ params: { slug: t.slug }, props: { theme: t } }));
}

const { theme: t } = Astro.props;
const briefHref = `/themes#brief`;
const nameParts = t.name.split('-');
const nameTail = nameParts.slice(2).join('-'); // astro-njx-<tail>

// Payments: when Lemon Squeezy checkout URLs land in CF Pages env
// (PUBLIC_LS_DARK_LUX_SINGLE / PUBLIC_LS_DARK_LUX_UNLIMITED etc.),
// Buy buttons switch from the brief form to real checkout — no code changes.
const envKey = t.slug.toUpperCase().replace(/-/g, '_');
const buySingleHref = import.meta.env[`PUBLIC_LS_${envKey}_SINGLE`] || briefHref;
const buyUnlimitedHref = import.meta.env[`PUBLIC_LS_${envKey}_UNLIMITED`] || briefHref;
const checkoutLive = buySingleHref !== briefHref;
---

<BaseLayout
    title={`${t.name} — ${t.tagline} | njX Astro Themes`}
    description={t.desc}
>
    <PagesTopbar activePage="themes" />

    <main class="themes-page tp-page">
        <!-- HERO: shell with auras, kicker, stats — same language as the njX UI home hero -->
        <section class="tp-shell">
            <div class="tp-hero">
                <div class="tp-hero-copy">
                    <a href="/themes" class="tp-back">← All themes</a>
                    <span class="tp-kicker">{t.tagline}</span>
                    <h1 class="tp-title">
                        astro-njx-<strong>{nameTail}</strong>
                    </h1>
                    <p class="tp-text">{t.longDesc}</p>
                    <div class="tp-actions">
                        <a class="tp-btn tp-btn-primary" href={`/themes/${t.slug}/preview`}>
                            Live preview
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
                        </a>
                        {t.pro?.demo && (
                            <a class="tp-btn tp-btn-secondary" href={t.pro.demo} target="_blank" rel="noopener">Pro demo ↗</a>
                        )}
                        <a class="tp-btn tp-btn-ghost" href={t.repo} target="_blank" rel="noopener">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55v-2.05c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.18-1.49 3.14-1.18 3.14-1.18.63 1.59.24 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.66.41.36.77 1.05.77 2.13v3.16c0 .3.2.66.8.55A11.52 11.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" /></svg>
                            Free theme
                        </a>
                    </div>
                    <div class="tp-pills">
                        {t.tags.map((tag, i) => (
                            <span class:list={['tag', ['tag-primary', 'tag-success', 'tag-accent'][i % 3]]}>{tag}</span>
                        ))}
                        <span class="tag tag-warning"><strong>MIT</strong>&nbsp;· Lite license</span>
                    </div>
                </div>

                <div class="tp-hero-side">
                    <a class="tp-shot" href={`/themes/${t.slug}/preview`}>
                        <img src={t.img} alt={`${t.name} home page`} width="1280" height="720" />
                        <span class="tp-shot-hint">Open live preview →</span>
                    </a>
                    {t.stats && (
                        <div class="tp-stats">
                            {t.stats.map((s) => (
                                <div class="tp-stat">
                                    <span class="tp-stat-value">{s.value}</span>
                                    <span class="tp-stat-label">{s.label}</span>
                                </div>
                            ))}
                        </div>
                    )}
                </div>
            </div>
        </section>

        <!-- Pricing -->
        <section class="tp-section">
            <h2 class="tp-h2">Pricing</h2>
            <div class="tp-pricing">
                <!-- Free -->
                <article class="tp-price-card">
                    <p class="tp-price-name">Lite</p>
                    <p class="tp-price-value">Free</p>
                    <p class="tp-price-note">Open source · MIT · fork and ship</p>
                    <ul class:list={['tp-features', t.liteFeatures.length > 6 && 'is-clamped']}>
                        {t.liteFeatures.map((f) => <li>{f}</li>)}
                    </ul>
                    {t.liteFeatures.length > 6 && (
                        <button type="button" class="tp-more" data-tp-more>
                            <span data-more-label>All {t.liteFeatures.length} features</span>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                        </button>
                    )}
                    <a class="tp-btn tp-btn-ghost tp-btn-block" href={t.repo} target="_blank" rel="noopener">Get free theme on GitHub</a>
                </article>

                {t.pro && (
                    <>
                        <!-- Pro single -->
                        <article class="tp-price-card tp-featured">
                            <span class="tp-badge">{t.pro.ready ? 'Most popular' : 'Coming soon'}</span>
                            <p class="tp-price-name">Pro · Single site</p>
                            <p class="tp-price-value">${t.pro.single}</p>
                            <p class="tp-price-note">One-time · 12 months of updates · email support</p>
                            <ul class:list={['tp-features', t.pro.features.length > 6 && 'is-clamped']}>
                                <li><strong>Everything in Lite, plus:</strong></li>
                                {t.pro.features.map((f) => <li>{f}</li>)}
                            </ul>
                            {t.pro.features.length > 6 && (
                                <button type="button" class="tp-more" data-tp-more>
                                    <span data-more-label>All {t.pro.features.length} Pro features</span>
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                                </button>
                            )}
                            {t.pro.ready ? (
                                <a class="tp-btn tp-btn-primary tp-btn-block" href={buySingleHref} {...(checkoutLive ? { target: '_blank', rel: 'noopener' } : {})}>Buy Pro — ${t.pro.single}</a>
                            ) : (
                                <a class="tp-btn tp-btn-primary tp-btn-block" href={briefHref}>Get notified — launching soon</a>
                            )}
                            {t.pro.ready && (checkoutLive ? (
                                <p class="tp-price-small">Secure checkout · instant download · VAT invoices handled by Lemon Squeezy.</p>
                            ) : (
                                <p class="tp-price-small">Checkout launching shortly — the button opens a short form, we reply with a payment link the same day.</p>
                            ))}
                        </article>

                        <!-- Pro unlimited -->
                        <article class="tp-price-card">
                            <p class="tp-price-name">Pro · Unlimited</p>
                            <p class="tp-price-value">${t.pro.unlimited}</p>
                            <p class="tp-price-note">Unlimited sites · lifetime updates · priority support (24–48h)</p>
                            <ul>
                                <li>Everything in Pro Single</li>
                                <li>Use on any number of client projects</li>
                                <li>Lifetime updates — pay once</li>
                                <li>Priority email support</li>
                            </ul>
                            <a class="tp-btn tp-btn-secondary tp-btn-block" href={t.pro.ready ? buyUnlimitedHref : briefHref} {...(t.pro.ready && buyUnlimitedHref !== briefHref ? { target: '_blank', rel: 'noopener' } : {})}>{t.pro.ready ? `Buy Unlimited — $${t.pro.unlimited}` : 'Get notified'}</a>
                        </article>
                    </>
                )}
            </div>
            <p class="tp-support-note">
                Support covers theme defects and setup per the docs. Custom feature work is quoted separately — see services below.
            </p>
        </section>

        <!-- Services -->
        <section class="tp-section">
            <h2 class="tp-h2">Services</h2>
            <div class="tp-services">
                {SERVICES.map((s, i) => (
                    <article class:list={['contact-card card-aura tp-service', ['card-aura-aurora', 'card-aura-cosmic', 'card-aura-ocean'][i % 3]]}>
                        <div>
                            <h3 class="tp-service-name">{s.name} <span>{s.price}</span></h3>
                            <p class="tp-service-desc">{s.desc}</p>
                        </div>
                        <div class="contact-card-actions">
                            <a href={briefHref} class="btn btn-outline btn-sm">Request</a>
                        </div>
                    </article>
                ))}
            </div>
        </section>

        <!-- CTA -->
        <section class="tp-cta">
            <div class="tp-cta-copy">
                <span class="tp-kicker">We reply within a day</span>
                <h2>Questions before buying?</h2>
                <p>
                    Licensing, Shopify specifics, a feature you need — send a short
                    brief and we reply within a day with honest answers and a quote
                    if custom work is involved.
                </p>
            </div>
            <div class="tp-cta-actions">
                <a href={briefHref} class="tp-btn tp-btn-primary tp-btn-block">
                    Ask / start a brief
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
                </a>
                <a href={`/themes/${t.slug}/preview`} class="tp-btn tp-btn-ghost tp-btn-block">Open live preview</a>
            </div>
        </section>
    </main>

    <PagesFooter />
</BaseLayout>

<script is:inline>
    // Delegated: survives View Transitions swaps (direct listeners are lost on client-side nav)
    if (!window.__tpMoreBound) {
        window.__tpMoreBound = true;
        document.addEventListener('click', function (e) {
            var btn = e.target.closest && e.target.closest('[data-tp-more]');
            if (!btn) return;
            var card = btn.closest('.tp-price-card');
            var label = btn.querySelector('[data-more-label]');
            if (!card || !label) return;
            if (!btn.dataset.fullLabel) btn.dataset.fullLabel = label.textContent;
            var open = card.classList.toggle('is-open');
            label.textContent = open ? 'Show less' : btn.dataset.fullLabel;
        });
    }
</script>

<style is:global>
    .tp-page { padding-bottom: 96px; }

    /* ── Hero shell: auras + glow, same language as the home hero ── */
    .tp-shell {
        position: relative;
        overflow: hidden;
        width: min(1180px, 100%);
        margin: 28px auto 0;
        border-radius: 28px;
        border: 1px solid color-mix(in srgb, var(--color-neutral-600) 22%, transparent);
        background:
            radial-gradient(circle at top right, color-mix(in srgb, var(--color-primary) 12%, transparent), transparent 30%),
            radial-gradient(circle at bottom left, color-mix(in srgb, var(--color-accent) 10%, transparent), transparent 32%),
            linear-gradient(145deg, color-mix(in srgb, var(--color-dark-secondary) 88%, var(--сolor-dark)), color-mix(in srgb, var(--сolor-dark) 82%, var(--color-dark-secondary)));
        box-shadow:
            0 22px 60px color-mix(in srgb, #000 20%, transparent),
            inset 0 1px 0 color-mix(in srgb, #fff 4%, transparent);
    }
    .tp-shell::before,
    .tp-shell::after {
        content: '';
        position: absolute;
        border-radius: 999px;
        filter: blur(14px);
        pointer-events: none;
    }
    .tp-shell::before {
        top: -90px; right: -70px; width: 260px; height: 260px;
        background: radial-gradient(circle, color-mix(in srgb, var(--color-primary) 18%, transparent), transparent 72%);
    }
    .tp-shell::after {
        left: -70px; bottom: -100px; width: 220px; height: 220px;
        background: radial-gradient(circle, color-mix(in srgb, var(--color-accent) 16%, transparent), transparent 72%);
    }
    .tp-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.95fr);
        gap: clamp(24px, 3.5vw, 44px);
        padding: clamp(24px, 3.5vw, 40px);
        align-items: center;
    }
    .tp-back {
        display: inline-block;
        margin-bottom: 16px;
        color: var(--color-muted);
        font-size: 13px;
        text-decoration: underline;
        text-underline-offset: 3px;
    }
    .tp-back:hover { color: var(--color-light); }
    .tp-kicker {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 8px 14px;
        margin: 0 0 16px 14px;
        border-radius: 999px;
        border: 1px solid color-mix(in srgb, var(--color-primary) 22%, transparent);
        background: color-mix(in srgb, var(--color-primary) 9%, transparent);
        color: var(--color-primary);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.4px;
        text-transform: uppercase;
    }
    .tp-kicker::before {
        content: '';
        width: 7px; height: 7px;
        border-radius: 50%;
        background: currentColor;
        box-shadow: 0 0 14px currentColor;
    }
    .tp-title {
        margin: 0 0 14px;
        color: var(--color-light);
        font-family: 'Space Grotesk', 'Roboto', sans-serif;
        font-size: clamp(30px, 4vw, 48px);
        line-height: 1;
        letter-spacing: -1.5px;
        overflow-wrap: anywhere;
    }
    .tp-title strong { color: var(--color-primary); }
    .tp-text {
        margin: 0 0 20px;
        color: var(--color-muted);
        font-size: 15px;
        line-height: 1.72;
    }
    .tp-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 16px; }
    .tp-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 44px;
        padding: 0 18px;
        border-radius: 12px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease, color 0.18s ease, box-shadow 0.18s ease;
    }
    .tp-btn:hover { transform: translateY(-1px); }
    .tp-btn-primary {
        background: linear-gradient(135deg, var(--color-primary), color-mix(in srgb, var(--color-accent) 55%, var(--color-primary)));
        color: #fff;
        box-shadow: 0 12px 30px color-mix(in srgb, var(--color-primary) 28%, transparent);
    }
    .tp-btn-secondary {
        border: 1px solid color-mix(in srgb, var(--color-primary) 40%, transparent);
        background: color-mix(in srgb, var(--color-primary) 8%, transparent);
        color: var(--color-primary);
    }
    .tp-btn-ghost {
        border: 1px solid color-mix(in srgb, var(--color-neutral-600) 26%, transparent);
        background: color-mix(in srgb, var(--сolor-dark) 35%, transparent);
        color: var(--color-light);
    }
    .tp-btn-block { width: 100%; justify-content: center; }
    .tp-pills { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
    .tp-pills .tag strong { font-weight: 800; }
    .tp-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 32px;
        padding: 0 12px;
        border-radius: 999px;
        border: 1px solid color-mix(in srgb, var(--color-neutral-600) 18%, transparent);
        background: color-mix(in srgb, var(--сolor-dark) 26%, transparent);
        color: var(--color-muted);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.2px;
    }
    .tp-pill strong { color: var(--color-light); }

    .tp-hero-side { display: grid; gap: 14px; align-content: center; min-width: 0; }
    .tp-shot {
        position: relative;
        display: block;
        overflow: hidden;
        border-radius: 18px;
        border: 1px solid color-mix(in srgb, #fff 12%, transparent);
        box-shadow: 0 26px 70px color-mix(in srgb, #000 34%, transparent);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .tp-shot:hover {
        transform: translateY(-3px);
        box-shadow: 0 34px 90px color-mix(in srgb, #000 42%, transparent);
    }
    .tp-shot img { display: block; width: 100%; height: auto; }
    .tp-shot-hint {
        position: absolute;
        inset-inline: 0;
        bottom: 0;
        padding: 26px 16px 12px;
        background: linear-gradient(transparent, color-mix(in srgb, #000 72%, transparent));
        color: #fff;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.4px;
        opacity: 0;
        transition: opacity 0.2s ease;
    }
    .tp-shot:hover .tp-shot-hint { opacity: 1; }
    .tp-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
    .tp-stat {
        padding: 14px 12px;
        border-radius: 16px;
        border: 1px solid color-mix(in srgb, var(--color-neutral-600) 14%, transparent);
        background: color-mix(in srgb, var(--сolor-dark) 32%, transparent);
    }
    .tp-stat-value {
        display: block;
        margin-bottom: 4px;
        color: var(--color-light);
        font-size: 22px;
        font-weight: 900;
        letter-spacing: -0.8px;
    }
    .tp-stat-label { color: var(--color-muted); font-size: 11px; line-height: 1.4; }

    /* ── Sections ── */
    .tp-section { width: min(1180px, 100%); margin: 56px auto 0; }
    .tp-h2 {
        display: flex;
        align-items: center;
        gap: 14px;
        font-family: 'Poppins', sans-serif;
        font-size: 26px;
        font-weight: 800;
        color: var(--color-light);
        margin-bottom: 22px;
    }
    .tp-h2::after {
        content: '';
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, color-mix(in srgb, var(--color-primary) 45%, transparent), transparent);
    }

    /* ── Pricing ── */
    .tp-pricing { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; align-items: start; }
    .tp-price-card {
        position: relative;
        display: flex; flex-direction: column;
        border: 1px solid color-mix(in srgb, #fff 10%, transparent);
        border-radius: 20px;
        background: color-mix(in srgb, #fff 3%, transparent);
        padding: 26px 24px;
    }
    .tp-featured {
        border-color: color-mix(in srgb, var(--color-primary) 55%, transparent);
        background:
            radial-gradient(circle at 20% 0, color-mix(in srgb, var(--color-primary) 16%, transparent), transparent 20rem),
            color-mix(in srgb, #fff 3%, transparent);
        box-shadow: 0 24px 60px color-mix(in srgb, var(--color-primary) 14%, transparent);
    }
    .tp-badge {
        position: absolute;
        top: -12px;
        left: 24px;
        padding: 5px 12px;
        border-radius: 999px;
        background: linear-gradient(135deg, var(--color-primary), color-mix(in srgb, var(--color-accent) 55%, var(--color-primary)));
        color: #fff;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        box-shadow: 0 8px 20px color-mix(in srgb, var(--color-primary) 30%, transparent);
    }
    .tp-price-name { font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.5px; color: var(--color-primary); }
    .tp-price-value { margin-top: 8px; font-size: 40px; font-weight: 900; color: var(--color-light); }
    .tp-price-note { margin-top: 4px; font-size: 13px; color: var(--color-muted); }
    .tp-price-card ul { margin: 18px 0 22px; padding: 0; list-style: none; display: grid; gap: 9px; flex: 1; }
    .tp-price-card li {
        position: relative; padding-left: 20px;
        font-size: 13.5px; line-height: 1.5; color: var(--color-muted);
    }
    .tp-price-card li::before { content: '✓'; position: absolute; left: 0; color: var(--color-primary); font-weight: 900; }
    /* feature accordion: clamp + fade, chevron toggle */
    .tp-features.is-clamped {
        position: relative;
        max-height: 296px;
        overflow: hidden;
        margin-bottom: 0;
        flex: none;
    }
    .tp-features.is-clamped::after {
        content: '';
        position: absolute;
        inset-inline: 0;
        bottom: 0;
        height: 72px;
        background: linear-gradient(transparent, var(--tp-card-bg, #0d0f14));
        pointer-events: none;
    }
    .tp-more {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        align-self: flex-start;
        margin: 6px 0 18px;
        padding: 0;
        border: 0;
        background: none;
        color: var(--color-primary);
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
    }
    .tp-more svg { transition: transform 0.2s ease; }
    .tp-more:hover { text-decoration: underline; text-underline-offset: 3px; }
    .tp-price-card.is-open .tp-features.is-clamped { max-height: none; }
    .tp-price-card.is-open .tp-features.is-clamped::after { display: none; }
    .tp-price-card.is-open .tp-more svg { transform: rotate(180deg); }
    .tp-price-card li strong { color: var(--color-light); }
    .tp-price-card .btn { justify-content: center; }
    .tp-price-small { margin-top: 10px; font-size: 12px; line-height: 1.5; color: var(--color-muted); }
    .tp-support-note { margin-top: 18px; font-size: 13px; color: var(--color-muted); }

    /* ── Services: aura cards from the site's library ── */
    .tp-services { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
    .tp-service { display: flex; flex-direction: column; gap: 16px; padding: 20px; }
    .tp-service-name {
        display: flex; justify-content: space-between; align-items: baseline; gap: 10px;
        font-weight: 800; color: var(--color-light); font-size: 16px;
    }
    .tp-service-name span { color: var(--color-primary); white-space: nowrap; font-size: 14px; }
    .tp-service-desc { margin-top: 8px; font-size: 13.5px; line-height: 1.6; color: var(--color-muted); }

    .tp-cta {
        position: relative;
        overflow: hidden;
        width: min(1180px, 100%);
        margin: 56px auto 0;
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(260px, 0.6fr);
        gap: clamp(24px, 3.5vw, 44px);
        align-items: center;
        padding: clamp(24px, 3.5vw, 40px);
        border-radius: 28px;
        border: 1px solid color-mix(in srgb, var(--color-primary) 30%, transparent);
        background:
            radial-gradient(circle at top left, color-mix(in srgb, var(--color-primary) 14%, transparent), transparent 32%),
            radial-gradient(circle at bottom right, color-mix(in srgb, var(--color-accent) 12%, transparent), transparent 34%),
