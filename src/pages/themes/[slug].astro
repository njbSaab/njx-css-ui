---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PagesTopbar from '../../components/PagesTopbar.astro';
import PagesFooter from '../../components/PagesFooter.astro';
import { ALL_THEMES } from '../../data/themesCatalog';

export function getStaticPaths() {
  return ALL_THEMES.map((t) => ({ params: { slug: t.slug }, props: { theme: t } }));
}

const { theme: t } = Astro.props;
const briefHref = '/contact';
const nameParts = t.name.split('-');
const nameTail = nameParts.slice(2).join('-'); // astro-njx-<tail>

// Payments: Paddle Billing. A theme is checkout-live when it carries Paddle
// price IDs (t.pro.paddleSingle/…) AND the public client token is configured
// (PUBLIC_PADDLE_TOKEN in the store build env). Buy buttons then open the
// Paddle overlay; otherwise they fall back to the contact/brief form.
const paddleToken = import.meta.env.PUBLIC_PADDLE_TOKEN || '';
const buySinglePrice = t.pro?.paddleSingle || '';
const buyUnlimitedPrice = t.pro?.paddleUnlimited || '';
const checkoutLive = !!(paddleToken && buySinglePrice);
const buySingleHref = briefHref;
const buyUnlimitedHref = briefHref;
const canonical = new URL(`/themes/${t.slug}/`, 'https://themes.njxui.dev');
---

<BaseLayout canonical={canonical}
    title={`${t.name} — ${t.tagline} | njX Astro Themes`}
    description={t.desc}
>
    <PagesTopbar activePage="themes" />

    <main class="themes-page tp-page">
        <!-- LIVE DEMO: full-width stage above the hero card -->
        <section class="tp-live-wide">
            <a class="tp-shot" href={`/themes/${t.slug}/preview`} data-tp-shot data-demo={t.pro?.demo ?? t.demo}>
                <img src={t.img} alt={`${t.name} home page`} width="1280" height="720" />
                <span class="tp-shot-hint">Open live preview →</span>
                {(t.pro?.demo ?? t.demo) && (
                    <button type="button" class="tp-live-btn" data-tp-live>
                        <span class="tp-live-dot" />
                        <span data-tp-live-label>Live</span>
                    </button>
                )}
            </a>
        </section>

        <!-- HERO: shell with auras and kicker — same language as the njX UI home hero -->
        <section class="tp-shell">
            <div class="tp-hero">
                <div class="tp-hero-copy">
                    <a href="/themes" class="tp-back">← All themes</a>
                    <span class="tp-kicker">{t.tagline}</span>
                    <h1 class="tp-title">
                        astro-njx-<strong>{nameTail}</strong>
                    </h1>
                    <div class:list={['tp-hero-desc', t.longDesc.length > 380 && 'is-clamped']} data-hero-desc>
                        <p class="tp-text">{t.longDesc}</p>
                    </div>
                    {t.longDesc.length > 380 && (
                        <button type="button" class="tp-more" data-hero-more>
                            <span data-more-label>Read the full tour</span>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                        </button>
                    )}
                    <div class="tp-pills">
                        {t.tags.map((tag, i) => (
                            <span class:list={['tag', ['tag-primary', 'tag-success', 'tag-accent'][i % 3]]}>{tag}</span>
                        ))}
                        {t.premium ? (
                            <span class="tag tag-warning"><strong>Premium</strong>&nbsp;· commercial license</span>
                        ) : (
                            <span class="tag tag-warning"><strong>MIT</strong>&nbsp;· Lite license</span>
                        )}
                    </div>
                    <div class="tp-actions">
                        <a class="tp-btn tp-btn-primary" href={`/themes/${t.slug}/preview`}>
                            Live preview
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
                        </a>
                        {t.pro?.demo && (
                            <a class="tp-btn tp-btn-secondary" href={t.pro.demo} target="_blank" rel="noopener">Pro demo ↗</a>
                        )}
                        {!t.premium && (
                            <a class="tp-btn tp-btn-ghost" href={t.repo} target="_blank" rel="noopener">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55v-2.05c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.18-1.49 3.14-1.18 3.14-1.18.63 1.59.24 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.66.41.36.77 1.05.77 2.13v3.16c0 .3.2.66.8.55A11.52 11.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" /></svg>
                                Free theme
                            </a>
                        )}
                    </div>
                </div>
            </div>
        </section>

        <!-- About / full details (Eclipse-style long copy) -->
        {t.details && t.details.length > 0 && (
            <section class="tp-section" id="details">
                <h2 class="tp-h2">About this theme</h2>
                <div class="tp-details">
                    {t.details.map((block) =>
                        block.startsWith('## ') ? (
                            <h3 class="tp-details-h">{block.slice(3)}</h3>
                        ) : block.startsWith('- ') ? (
                            <li class="tp-details-li">{block.slice(2)}</li>
                        ) : (
                            <p class="tp-details-p">{block}</p>
                        )
                    )}
                </div>
            </section>
        )}

        <!-- Pricing -->
        <section class="tp-section">
            <h2 class="tp-h2">Pricing</h2>
            <div class:list={['tp-pricing', t.premium && 'tp-pricing-2']}>
                <!-- Free -->
                {!t.premium && (
                <article class="tp-price-card">
                    <p class="tp-price-name">Lite</p>
                    <p class="tp-price-value">Free</p>
                    <p class="tp-price-note">Open source · MIT · fork and ship</p>
                    <ul class:list={['tp-features', t.liteFeatures.length > 6 && 'is-clamped']}>
                        {t.liteFeatures.map((f) => <li>{f}</li>)}
                    </ul>
                    {t.liteFeatures.length > 6 && (
                        <button type="button" class="tp-more" data-tp-more>
                            <span data-more-label>All {t.liteFeatures.length} features</span>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                        </button>
                    )}
                    <a class="tp-btn tp-btn-ghost tp-btn-block" href={t.repo} target="_blank" rel="noopener">Get free theme on GitHub</a>
                </article>
                )}

                {t.pro && (
                    <>
                        <!-- Pro single -->
                        <article class="tp-price-card tp-featured">
                            <span class="tp-badge">{t.pro.ready ? 'Most popular' : 'Made to order'}</span>
                            <p class="tp-price-name">{t.premium ? 'Single site' : 'Pro · Single site'}</p>
                            <p class="tp-price-value">${t.pro.single}</p>
                            <p class="tp-price-note">One-time · 12 months of updates · email support</p>
                            <ul class:list={['tp-features', t.pro.features.length > 6 && 'is-clamped']}>
                                {!t.premium && <li><strong>Everything in Lite, plus:</strong></li>}
                                {t.pro.features.map((f) => <li>{f}</li>)}
                            </ul>
                            {t.pro.features.length > 6 && (
                                <button type="button" class="tp-more" data-tp-more>
                                    <span data-more-label>All {t.pro.features.length} Pro features</span>
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                                </button>
                            )}
                            {t.pro.ready ? (checkoutLive ? (
                                <button type="button" class="tp-btn tp-btn-primary tp-btn-block" data-paddle-buy={buySinglePrice}>{t.premium ? `Buy — $${t.pro.single}` : `Buy Pro — $${t.pro.single}`}</button>
                            ) : (
                                <a class="tp-btn tp-btn-primary tp-btn-block" href={buySingleHref}>{t.premium ? `Buy — $${t.pro.single}` : `Buy Pro — $${t.pro.single}`}</a>
                            )) : (
                                <button type="button" class="tp-btn tp-btn-primary tp-btn-block" data-order-open data-license="single">Order this build — ${t.pro.single}</button>
                            )}
                            {t.pro.ready ? (checkoutLive ? (
                                <p class="tp-price-small">Secure checkout · instant download · VAT invoices handled by our Merchant of Record.</p>
                            ) : (
                                <p class="tp-price-small">Checkout launching shortly — the button opens a short form, we reply with a payment link the same day.</p>
                            )) : (
                                <p class="tp-price-small">Made to order: the button opens a short form. Your order moves this theme to the front of our build queue — we finish it first and deliver in days, at launch pricing.</p>
                            )}
                        </article>

                        <!-- Pro unlimited -->
                        <article class="tp-price-card">
                            <p class="tp-price-name">{t.premium ? 'Unlimited' : 'Pro · Unlimited'}</p>
                            <p class="tp-price-value">${t.pro.unlimited}</p>
                            <p class="tp-price-note">Unlimited sites · lifetime updates · priority support (24–48h)</p>
                            <ul>
                                <li>{t.premium ? 'Everything in Single' : 'Everything in Pro Single'}</li>
                                <li>Use on any number of client projects</li>
                                <li>Lifetime updates — pay once</li>
                                <li>Priority email support</li>
                            </ul>
                            {t.pro.ready ? ((checkoutLive && buyUnlimitedPrice) ? (
                                <button type="button" class="tp-btn tp-btn-secondary tp-btn-block" data-paddle-buy={buyUnlimitedPrice}>Buy Unlimited — ${t.pro.unlimited}</button>
                            ) : (
                                <a class="tp-btn tp-btn-secondary tp-btn-block" href={buyUnlimitedHref}>Buy Unlimited — ${t.pro.unlimited}</a>
                            )) : (
                                <button type="button" class="tp-btn tp-btn-secondary tp-btn-block" data-order-open data-license="unlimited">Order Unlimited — ${t.pro.unlimited}</button>
                            )}
                        </article>
                    </>
                )}
            </div>
            <p class="tp-support-note">
                Support covers theme defects and setup per the included docs.
            </p>
        </section>

        <!-- CTA -->
        <section class="tp-cta">
            <div class="tp-cta-copy">
                <span class="tp-kicker">We reply within a day</span>
                <h2>Questions before buying?</h2>
                <p>
                    Licensing or Shopify specifics — email us and we reply within
                    a day with honest answers.
                </p>
            </div>
            <div class="tp-cta-actions">
                <a href={briefHref} class="tp-btn tp-btn-primary tp-btn-block">
                    Email support@njxui.dev
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
                </a>
                <a href={`/themes/${t.slug}/preview`} class="tp-btn tp-btn-ghost tp-btn-block">Open live preview</a>
            </div>
        </section>
    </main>

    <!-- Order brief popup: no live checkout yet, so orders open a short form.
         POSTs to the same /api/contact worker (Resend + Telegram mirror). -->
    {t.pro && !t.pro.ready && (
        <div class="tp-order-root" id="orderRoot" hidden>
            <div class="tp-order-dim" data-order-close></div>
            <div class="tp-order-card" role="dialog" aria-modal="true" aria-labelledby="orderTitle">
                <button type="button" class="tp-order-x" data-order-close aria-label="Close">✕</button>
                <div data-order-form-wrap>
                    <span class="tag tag-warning">Made to order</span>
                    <h3 id="orderTitle" class="tp-order-title">Order {t.name}</h3>
                    <p class="tp-order-sub">
                        Leave your details — your order moves this theme to the front of
                        our build queue. We reply within a day with a payment link;
                        delivery in days, launch pricing locked.
                    </p>
                    <form id="orderForm" class="tp-order-form">
                        <div class="tp-order-licenses">
                            <label class="tp-order-license">
                                <input type="radio" name="license" value={`Single site — $${t.pro.single}`} checked />
                                <span><strong>Single site</strong><small>${t.pro.single} · 12 months of updates</small></span>
                            </label>
                            <label class="tp-order-license">
                                <input type="radio" name="license" value={`Unlimited — $${t.pro.unlimited}`} />
                                <span><strong>Unlimited</strong><small>${t.pro.unlimited} · lifetime updates</small></span>
                            </label>
                        </div>
                        <label class="tp-order-field">
                            <span>Email *</span>
                            <input type="email" name="email" required placeholder="you@company.com" />
                        </label>
                        <label class="tp-order-field">
                            <span>Anything we should know? (optional)</span>
                            <textarea name="message" rows="3" placeholder="Timeline, Shopify or mock data, customization wishes…"></textarea>
                        </label>
                        <button type="submit" class="tp-btn tp-btn-primary tp-btn-block" data-order-submit>Send order request</button>
                        <p class="tp-order-note" data-order-status>No payment now — we confirm by email first.</p>
                    </form>
                </div>
                <div data-order-done hidden>
                    <h3 class="tp-order-title">Request received ✓</h3>
                    <p class="tp-order-sub">
                        Thanks — {t.name} just moved to the front of our build queue.
                        Expect a reply with a payment link within a day.
                    </p>
                    <button type="button" class="tp-btn tp-btn-secondary tp-btn-block" data-order-close>Close</button>
                </div>
            </div>
        </div>
    )}

    <PagesFooter />

    {checkoutLive && (
        <script is:inline src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>
        <script is:inline define:vars={{ token: paddleToken }}>
            (function () {
                function boot() {
                    if (!window.Paddle) { setTimeout(boot, 100); return; }
                    // account is production; no Environment.set needed for live
                    window.Paddle.Initialize({ token: token });
                    if (window.__paddleBound) return;
                    window.__paddleBound = true;
                    document.addEventListener('click', function (e) {
                        var b = e.target.closest && e.target.closest('[data-paddle-buy]');
                        if (!b) return;
                        e.preventDefault();
                        window.Paddle.Checkout.open({
                            items: [{ priceId: b.dataset.paddleBuy, quantity: 1 }],
                            settings: { successUrl: 'https://njxui.dev/thanks' },
                        });
                    });
                }
                boot();
            })();
        </script>
    )}
</BaseLayout>

<script is:inline>
    // Auto live demo in the hero shot: mounts ~1s after page load, unmounts
    // whenever the user is "gone" — tab hidden or shot scrolled out of view —
    // and comes back when they return. The button is a manual kill switch.
    (function () {
        function getShot() { return document.querySelector('[data-tp-shot]'); }
        function setLabel(shot, text) {
            var l = shot.querySelector('[data-tp-live-label]');
            if (l) l.textContent = text;
        }
        function scaleFrame(shot) {
            var f = shot.querySelector('.tp-live-frame');
            if (!f) return;
            var s = shot.clientWidth / 1280;
            f.style.transform = 'scale(' + s + ')';
            /* follow the box height so resizing grows the demo viewport */
            f.style.height = Math.round(shot.clientHeight / s) + 'px';
        }
        function mount(shot) {
            if (!shot.dataset.demo || shot.classList.contains('is-live')) return;
            var loading = document.createElement('span');
            loading.className = 'tp-live-loading';
            loading.innerHTML = '<span class="tp-live-spinner"></span>Loading live demo…';
            shot.appendChild(loading);
            var frame = document.createElement('iframe');
            frame.className = 'tp-live-frame';
            frame.src = shot.dataset.demo;
            frame.title = 'Live theme demo';
            frame.addEventListener('load', function () {
                frame.classList.add('is-ready');
                setTimeout(function () { loading.remove(); }, 350);
            });
            shot.appendChild(frame);
            shot.classList.add('is-live');
            setLabel(shot, 'Close');
            scaleFrame(shot);
        }
        function unmount(shot) {
            shot.querySelectorAll('.tp-live-frame, .tp-live-loading').forEach(function (n) { n.remove(); });
            shot.classList.remove('is-live');
            shot.style.width = '';
            shot.style.height = ''; /* undo any manual resize */
            setLabel(shot, 'Live');
        }
        function sync(shot) {
            var wanted = !document.hidden && shot.dataset.inView === '1' && !shot.dataset.muted;
            if (wanted) mount(shot);
            else unmount(shot);
        }
        function setup() {
            var shot = getShot();
            if (!shot || !shot.dataset.demo || shot.dataset.liveInit) return;
            shot.dataset.liveInit = '1';
            shot.dataset.inView = '1';
            if ('IntersectionObserver' in window) {
                new IntersectionObserver(function (entries) {
                    shot.dataset.inView = entries[0].isIntersecting ? '1' : '';
                    if (shot.dataset.started) sync(shot);
                }, { threshold: 0.25 }).observe(shot);
            }
            if ('ResizeObserver' in window) {
                new ResizeObserver(function () { scaleFrame(shot); }).observe(shot);
            }
            shot.dataset.started = '1';
            sync(shot); /* mount immediately — the shot is the first thing on the page */
        }
        if (!window.__tpLiveBound) {
            window.__tpLiveBound = true;
            document.addEventListener('click', function (e) {
                var btn = e.target.closest && e.target.closest('[data-tp-live]');
                if (!btn) return;
                e.preventDefault();
                e.stopPropagation();
                var shot = btn.closest('[data-tp-shot]');
                if (shot.classList.contains('is-live')) {
                    shot.dataset.muted = '1';
                    unmount(shot);
                } else {
                    delete shot.dataset.muted;
                    mount(shot);
                }
            });
            document.addEventListener('visibilitychange', function () {
                var shot = getShot();
                if (shot && shot.dataset.started) sync(shot);
            });
            window.addEventListener('resize', function () {
                var shot = getShot();
                if (shot) scaleFrame(shot);
            });
            document.addEventListener('astro:page-load', setup);
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setup);
        else setup();
    })();

    // Delegated: survives View Transitions swaps (direct listeners are lost on client-side nav)
    if (!window.__tpMoreBound) {
        window.__tpMoreBound = true;
        document.addEventListener('click', function (e) {
            var btn = e.target.closest && e.target.closest('[data-tp-more]');
            if (!btn) return;
            var card = btn.closest('.tp-price-card');
            var label = btn.querySelector('[data-more-label]');
            if (!card || !label) return;
            if (!btn.dataset.fullLabel) btn.dataset.fullLabel = label.textContent;
            var open = card.classList.toggle('is-open');
            label.textContent = open ? 'Show less' : btn.dataset.fullLabel;
        });
    }

    // Hero long-copy toggle — delegated, same pattern as the price accordion
    if (!window.__tpHeroMoreBound) {
        window.__tpHeroMoreBound = true;
        document.addEventListener('click', function (e) {
            var btn = e.target.closest && e.target.closest('[data-hero-more]');
            if (!btn) return;
            var desc = document.querySelector('[data-hero-desc]');
            var label = btn.querySelector('[data-more-label]');
            if (!desc || !label) return;
            if (!btn.dataset.fullLabel) btn.dataset.fullLabel = label.textContent;
            var open = desc.classList.toggle('is-open');
            btn.classList.toggle('is-open', open);
            label.textContent = open ? 'Show less' : btn.dataset.fullLabel;
        });
    }

    // Order brief popup (made-to-order themes) — delegated for the same reason
    if (!window.__tpOrderBound) {
        window.__tpOrderBound = true;
        var orderRootSel = '#orderRoot';
        document.addEventListener('click', function (e) {
            var root = document.querySelector(orderRootSel);
            if (!root) return;
            var open = e.target.closest && e.target.closest('[data-order-open]');
            if (open) {
                root.hidden = false;
                document.body.style.overflow = 'hidden';
                var lic = open.getAttribute('data-license');
                var radios = root.querySelectorAll('input[name="license"]');
                if (radios.length === 2) radios[lic === 'unlimited' ? 1 : 0].checked = true;
                var email = root.querySelector('input[name="email"]');
                if (email) setTimeout(function () { email.focus(); }, 50);
                return;
            }
            if (e.target.closest && e.target.closest('[data-order-close]')) {
                root.hidden = true;
                document.body.style.overflow = '';
            }
        });
        document.addEventListener('keydown', function (e) {
            var root = document.querySelector(orderRootSel);
            if (e.key === 'Escape' && root && !root.hidden) {
                root.hidden = true;
                document.body.style.overflow = '';
            }
        });
        document.addEventListener('submit', function (e) {
            var form = e.target.closest && e.target.closest('#orderForm');
            if (!form) return;
            e.preventDefault();
            var root = document.querySelector(orderRootSel);
            var status = root.querySelector('[data-order-status]');
            var submitBtn = root.querySelector('[data-order-submit]');
            var fd = new FormData(form);
            var themeName = (root.querySelector('.tp-order-title') || {}).textContent || 'theme';
            submitBtn.disabled = true;
            status.textContent = 'Sending…';
            fetch('/api/contact', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    topic: themeName.replace('Order ', 'Order: ') + ' · ' + fd.get('license'),
                    email: fd.get('email'),
                    message:
                        'MADE-TO-ORDER REQUEST\n' +
                        'License: ' + fd.get('license') + '\n' +
                        'Notes: ' + (fd.get('message') || '—'),
                }),
            })
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    if (d && d.ok) {
                        root.querySelector('[data-order-form-wrap]').hidden = true;
                        root.querySelector('[data-order-done]').hidden = false;
                    } else {
                        status.textContent = 'Something went wrong — email support@njxui.dev';
                        submitBtn.disabled = false;
                    }
                })
                .catch(function () {
                    status.textContent = 'Network error — try again or email support@njxui.dev';
                    submitBtn.disabled = false;
                });
        });
    }
</script>

<style is:global>
    .tp-page { padding-bottom: 96px; }

    /* ── Hero shell: auras + glow, same language as the home hero ── */
    .tp-shell {
        position: relative;
        overflow: hidden;
        width: min(1180px, 100%);
        margin: 28px auto 0;
        border-radius: 28px;
        border: 1px solid color-mix(in srgb, var(--color-neutral-600) 22%, transparent);
        background:
            radial-gradient(circle at top right, color-mix(in srgb, var(--color-primary) 12%, transparent), transparent 30%),
            radial-gradient(circle at bottom left, color-mix(in srgb, var(--color-accent) 10%, transparent), transparent 32%),
            linear-gradient(145deg, color-mix(in srgb, var(--color-dark-secondary) 88%, var(--сolor-dark)), color-mix(in srgb, var(--сolor-dark) 82%, var(--color-dark-secondary)));
        box-shadow:
            0 22px 60px color-mix(in srgb, #000 20%, transparent),
            inset 0 1px 0 color-mix(in srgb, var(--color-light) 4%, transparent);
    }
    .tp-shell::before,
    .tp-shell::after {
        content: '';
        position: absolute;
        border-radius: 999px;
        filter: blur(14px);
        pointer-events: none;
    }
    .tp-shell::before {
