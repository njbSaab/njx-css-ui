---
import Demo from '../shared/Demo.astro';

const inlineLinksColorsCode = `
<a href="#" class="link">Default</a>
<a href="#" class="link link-primary">Primary</a>
<a href="#" class="link link-muted">Muted</a>
<a href="#" class="link link-success">Success</a>
<a href="#" class="link link-danger">Danger</a>
<a href="#" class="link link-warning">Warning</a>
<a href="#" class="link link-info">Info</a>
`;

const underlineVariantsCode = `
<a href="#" class="link link-underline">Always underline</a>
<a href="#" class="link link-slide">Slide on hover</a>
<a href="#" class="link link-plain">No underline</a>
`;

const withIconsArrowExternalCode = `
<a href="#" class="link link-arrow">Read more</a>
<a href="#" class="link link-arrow link-primary">View all</a>
<a href="#" class="link link-external">GitHub</a>
<a href="#" class="link link-external link-muted">Docs</a>
`;

const linkCardsBlockLinksCode = `
<a href="#" class="link-card">
  <div class="link-card-icon">📄</div>
  <div class="link-card-body">
    <div class="link-card-title">Documentation</div>
    <div class="link-card-desc">Full API reference</div>
  </div>
  <span class="link-card-arrow">→</span>
</a>
`;

const linkListNavStyleCode = `
<div class="link-list">
  <a href="#" class="is-active">Dashboard</a>
  <a href="#">Profile</a>
  <a href="#">Settings</a>
</div>
`;
---

<section class="lib-section" id="links">
    <div class="lib-section-title">🔗 Links</div>
    <div class="lib-section-desc">
        From <code>_links.css</code>. Inline links, color variants, animated
        underline and block link cards. Link buttons — see
        <a href="#buttons" class="link">Buttons ↗</a>.
    </div>

    <!-- Inline links -->
    <Demo is:raw label={'Inline links — colors'} previewStyle="gap:16px;flex-wrap:wrap;align-items:center" code={inlineLinksColorsCode}>
            <a href="#" class="link">Default</a>
            <a href="#" class="link link-primary">Primary</a>
            <a href="#" class="link link-muted">Muted</a>
            <a href="#" class="link link-success">Success</a>
            <a href="#" class="link link-danger">Danger</a>
            <a href="#" class="link link-warning">Warning</a>
            <a href="#" class="link link-info">Info</a>
        </Demo>

    <!-- Underline variants -->
    <Demo is:raw label={'Underline variants'} previewStyle="gap:20px;flex-wrap:wrap;align-items:center;font-size:15px" code={underlineVariantsCode}>
            <a href="#" class="link link-underline">Always underline</a>
            <a href="#" class="link link-slide">Slide on hover</a>
            <a href="#" class="link link-plain">No underline</a>
        </Demo>

    <!-- Arrow / External -->
    <Demo is:raw label={'With icons — arrow / external'} previewStyle="gap:20px;flex-wrap:wrap;align-items:center;font-size:15px" code={withIconsArrowExternalCode}>
            <a href="#" class="link link-arrow">Read more</a>
            <a href="#" class="link link-arrow link-primary">View all</a>
            <a href="#" class="link link-external">GitHub</a>
            <a href="#" class="link link-external link-muted">Docs</a>
        </Demo>

    <!-- Link cards -->
    <Demo is:raw label={'Link cards — block links'} previewClass="col" previewStyle="align-items:stretch;max-width:440px" code={linkCardsBlockLinksCode}>
            <a href="#" class="link-card">
                <div class="link-card-icon">📄</div>
                <div class="link-card-body">
                    <div class="link-card-title">Documentation</div>
                    <div class="link-card-desc">
                        Full API reference and guides
                    </div>
                </div>
                <span class="link-card-arrow">→</span>
            </a>
            <a href="#" class="link-card">
                <div class="link-card-icon">⚡</div>
                <div class="link-card-body">
                    <div class="link-card-title">Quick Start</div>
                    <div class="link-card-desc">
                        Up and running in 30 seconds
                    </div>
                </div>
                <span class="link-card-arrow">→</span>
            </a>
            <a href="#" class="link-card">
                <div class="link-card-icon">🎨</div>
                <div class="link-card-body">
                    <div class="link-card-title">Themes</div>
                    <div class="link-card-desc">
                        9 built-in themes, all customisable
                    </div>
                </div>
                <span class="link-card-arrow">→</span>
            </a>
        </Demo>

    <!-- Link list -->
    <Demo is:raw label={'Link list — nav-style'} previewStyle="align-items:flex-start" code={linkListNavStyleCode}>
            <div class="link-list" style="min-width:200px">
                <a href="#" class="is-active">
                    <svg
                        width="14"
                        height="14"
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                    >
                        <rect x="1" y="3" width="14" height="10" rx="2"></rect>
                        <path d="M1 7h14"></path>
                    </svg>
                    Dashboard
                </a>
                <a href="#">
                    <svg
                        width="14"
                        height="14"
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                    >
                        <circle cx="8" cy="6" r="3"></circle>
                        <path d="M2 14c0-3.3 2.7-5 6-5s6 1.7 6 5"></path>
                    </svg>
                    Profile
                </a>
                <a href="#">
                    <svg
                        width="14"
                        height="14"
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                    >
                        <path d="M8 2a5 5 0 015 5v3l1 1H2l1-1V7a5 5 0 015-5z"
                        ></path>
                        <path d="M6.5 13a1.5 1.5 0 003 0"></path>
                    </svg>
                    Notifications
                </a>
                <a href="#">
                    <svg
                        width="14"
                        height="14"
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                    >
                        <circle cx="8" cy="8" r="3"></circle>
                        <path
                            d="M8 1v2M8 13v2M1 8h2M13 8h2M3.5 3.5l1.5 1.5M11 11l1.5 1.5M11 3.5L9.5 5M5 11l-1.5 1.5"
                        ></path>
                    </svg>
                    Settings
                </a>
                <a href="#">
                    <svg
                        width="14"
                        height="14"
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M10 3H6L4 8l4-1 4 1-2-5z"></path>
                        <path d="M4 13h8"></path>
                    </svg>
                    Help
                </a>
            </div>
        </Demo>
</section>
