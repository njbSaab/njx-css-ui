---
import Demo from '../shared/Demo.astro';

// Превью — многопанельные инсталляции; образцы намеренно сфокусированы
// на конкретной возможности (одна панель / один блок).
const variantsCode = `
<div class="panel is-primary">
  <div class="panel-heading">Title</div>
  <a class="panel-block is-active"><span class="panel-icon">⭐</span> Item</a>
  <a class="panel-block"><span class="panel-icon">📁</span> Item 2</a>
</div>
`;

const tabsCode = `
<div class="panel is-primary">
  <div class="panel-heading">Repository</div>
  <div class="panel-tabs">
    <a class="is-active">All</a>
    <a>Public</a>
  </div>
  <a class="panel-block is-active">item</a>
</div>
`;

const searchCode = `
<div class="panel">
  <div class="panel-heading">Team members</div>
  <div class="panel-search">
    <input type="text" placeholder="Search…">
  </div>
  <a class="panel-block">
    Alice <span class="panel-block-badge">Admin</span>
  </a>
  <div class="panel-footer">...</div>
</div>
`;

const checkboxCode = `
<div class="panel">
  <div class="panel-heading">Features</div>
  <label class="panel-block">
    <input type="checkbox" checked> Dark mode
    <span class="panel-block-meta">enabled</span>
  </label>
  <div class="panel-footer">
    <button class="btn btn-sm btn-primary">Save</button>
  </div>
</div>
`;

const badgesCode = `
<a class="panel-block">
  <span class="panel-icon">💬</span> Messages
  <span class="panel-block-badge">12</span>
</a>
`;

const avatarsCode = `
<a class="panel-block">
  <span class="panel-avatar">AJ</span>
  Alice Johnson
  <span class="panel-block-meta">32 commits</span>
</a>
`;
---

<section class="lib-section" id="panel">
    <div class="lib-section-title">🗃 Panel</div>
    <div class="lib-section-desc">
        List panel component — filterable, selectable, with tabs, badges and
        actions. From <code>_breadcrumb.css</code>. Color variants: <code
            >is-primary</code
        >
        <code>is-success</code>
        <code>is-warning</code>
        <code>is-danger</code>.
    </div>

    <Demo
        is:raw
        label="Color variants"
        previewStyle="align-items:flex-start;flex-wrap:wrap;gap:16px"
        code={variantsCode}
    >
        <div class="panel is-primary" style="min-width:200px">
            <div class="panel-heading">Primary</div>
            <a class="panel-block is-active"><span class="panel-icon">⭐</span> Dashboard</a>
            <a class="panel-block"><span class="panel-icon">📁</span> Projects</a>
            <a class="panel-block"><span class="panel-icon">⚙️</span> Settings</a>
        </div>
        <div class="panel is-success" style="min-width:200px">
            <div class="panel-heading">Success</div>
            <a class="panel-block is-active"><span class="panel-icon">✅</span> Deployed</a>
            <a class="panel-block"><span class="panel-icon">📦</span> Packages</a>
            <a class="panel-block"><span class="panel-icon">🔗</span> Links</a>
        </div>
        <div class="panel is-warning" style="min-width:200px">
            <div class="panel-heading">Warning</div>
            <a class="panel-block is-active"><span class="panel-icon">⚠️</span> Pending</a>
            <a class="panel-block"><span class="panel-icon">🕐</span> Queued</a>
            <a class="panel-block"><span class="panel-icon">🔄</span> In Progress</a>
        </div>
        <div class="panel is-danger" style="min-width:200px">
            <div class="panel-heading">Danger</div>
            <a class="panel-block is-active"><span class="panel-icon">❌</span> Errors</a>
            <a class="panel-block"><span class="panel-icon">🚫</span> Blocked</a>
            <a class="panel-block"><span class="panel-icon">🗑️</span> Deleted</a>
        </div>
    </Demo>

    <Demo is:raw label="With tabs" code={tabsCode}>
        <div class="panel is-primary" style="min-width:280px">
            <div class="panel-heading">Repository</div>
            <div class="panel-tabs">
                <a class="is-active">All</a>
                <a>Public</a>
                <a>Private</a>
                <a>Forks</a>
            </div>
            <a class="panel-block is-active"><span class="panel-icon">⭐</span> njx-css-ui</a>
            <a class="panel-block"><span class="panel-icon">📁</span> marksheet</a>
            <a class="panel-block"><span class="panel-icon">📄</span> blog</a>
            <a class="panel-block"><span class="panel-icon">🔧</span> config</a>
        </div>
    </Demo>

    <Demo is:raw label="With search filter" code={searchCode}>
        <div class="panel" style="min-width:280px">
            <div class="panel-heading">Team members</div>
            <div class="panel-search">
                <input type="text" placeholder="Search member…" />
            </div>
            <a class="panel-block is-active">
                <span class="panel-icon">👤</span> Alice Johnson
                <span class="panel-block-badge">Admin</span>
            </a>
            <a class="panel-block">
                <span class="panel-icon">👤</span> Bob Smith
                <span class="panel-block-badge is-muted">Member</span>
            </a>
            <a class="panel-block">
                <span class="panel-icon">👤</span> Carol White
                <span class="panel-block-badge is-muted">Member</span>
            </a>
            <div class="panel-footer">
                <button class="btn btn-primary btn-sm">Invite</button>
            </div>
        </div>
    </Demo>

    <Demo is:raw label="Selectable — checkboxes" code={checkboxCode}>
        <div class="panel" style="min-width:280px">
            <div class="panel-heading">Features</div>
            <label class="panel-block">
                <input type="checkbox" checked /> Dark mode
                <span class="panel-block-meta">enabled</span>
            </label>
            <label class="panel-block">
                <input type="checkbox" checked /> Animations
                <span class="panel-block-meta">enabled</span>
            </label>
            <label class="panel-block">
                <input type="checkbox" /> Compact layout
                <span class="panel-block-meta">disabled</span>
            </label>
            <label class="panel-block">
                <input type="checkbox" /> Beta features
                <span class="panel-block-meta">disabled</span>
            </label>
            <div class="panel-footer">
                <button class="btn btn-sm btn-outline">Reset</button>
                <button class="btn btn-sm btn-primary">Save</button>
            </div>
        </div>
    </Demo>

    <Demo is:raw label="With notification badges" code={badgesCode}>
        <div class="panel" style="min-width:280px">
            <div class="panel-heading">Notifications</div>
            <div class="panel-tabs">
                <a class="is-active">All</a>
                <a>Mentions</a>
                <a>Updates</a>
            </div>
            <a class="panel-block is-active">
                <span class="panel-icon">💬</span> Messages
                <span class="panel-block-badge">12</span>
            </a>
            <a class="panel-block">
                <span class="panel-icon">🔔</span> Alerts
                <span class="panel-block-badge">3</span>
            </a>
            <a class="panel-block">
                <span class="panel-icon">⭐</span> Starred
                <span class="panel-block-badge is-muted">24</span>
            </a>
            <a class="panel-block">
                <span class="panel-icon">📦</span> Releases
                <span class="panel-block-badge is-muted">0</span>
            </a>
        </div>
    </Demo>

    <Demo is:raw label="With avatars" code={avatarsCode}>
        <div class="panel" style="min-width:300px">
            <div class="panel-heading">Contributors</div>
            <a class="panel-block">
                <span class="panel-avatar">AJ</span>
                Alice Johnson
                <span class="panel-block-meta">32 commits</span>
            </a>
            <a class="panel-block is-active">
                <span class="panel-avatar" style="background:color-mix(in srgb,var(--color-success) 18%,transparent);color:var(--color-success)">BS</span>
                Bob Smith
                <span class="panel-block-meta">18 commits</span>
            </a>
            <a class="panel-block">
                <span class="panel-avatar" style="background:color-mix(in srgb,var(--color-accent) 18%,transparent);color:var(--color-accent)">CW</span>
                Carol White
                <span class="panel-block-meta">9 commits</span>
            </a>
            <div class="panel-footer">
                <span style="font-size:var(--fs-xs);color:var(--color-muted)">3 contributors total</span>
                <button class="btn btn-sm btn-outline">View all</button>
            </div>
        </div>
    </Demo>
</section>
