---
import Demo from '../shared/Demo.astro';

const defaultUnderlineCode = `
<div class="tab-wrap">
  <div class="tab-nav">
    <button class="tab-btn is-active" onclick="tabSwitch(this)">Tab 1</button>
    <button class="tab-btn" onclick="tabSwitch(this)">Tab 2</button>
    <button class="tab-btn" onclick="tabSwitch(this)">Tab 3</button>
  </div>
  <div class="tab-content">
    <div class="tab-panel is-active">Content 1</div>
    <div class="tab-panel">Content 2</div>
    <div class="tab-panel">Content 3</div>
  </div>
</div>

<script>
function tabSwitch(btn) {
  const wrap = btn.closest(".tab-wrap");
  wrap.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("is-active"));
  wrap.querySelectorAll(".tab-panel").forEach(p => p.classList.remove("is-active"));
  btn.classList.add("is-active");
  const idx = [...btn.parentElement.children].indexOf(btn);
  wrap.querySelectorAll(".tab-panel")[idx].classList.add("is-active");
}
</script>
`;

const pillsCode = `
<div class="tab-nav tab-nav-pills">
  <button class="tab-btn is-active" onclick="tabSwitch(this)">Daily</button>
  <button class="tab-btn" onclick="tabSwitch(this)">Weekly</button>
  <button class="tab-btn" onclick="tabSwitch(this)">Monthly</button>
</div>
`;

const pillsAlpineCode = `
<!-- njx-alpine.js preset: x-data="njxTabs" — select(i) / isActive(i), no tabSwitch() -->
<div class="tab-wrap" x-data="njxTabs">
  <div class="tab-nav tab-nav-pills">
    <button class="tab-btn" :class="{ 'is-active': isActive(0) }" @click="select(0)">Daily</button>
    <button class="tab-btn" :class="{ 'is-active': isActive(1) }" @click="select(1)">Weekly</button>
    <button class="tab-btn" :class="{ 'is-active': isActive(2) }" @click="select(2)">Monthly</button>
  </div>
  <div class="tab-content">
    <div class="tab-panel" :class="{ 'is-active': isActive(0) }">Stats for today</div>
    <div class="tab-panel" :class="{ 'is-active': isActive(1) }">Stats for this week</div>
    <div class="tab-panel" :class="{ 'is-active': isActive(2) }">Stats for this month</div>
  </div>
</div>
`;

const boxedCode = `
<div class="tab-nav tab-nav-boxed">...</div>
<div class="tab-content tab-content-bordered">...</div>
`;

const cardTopBorderVsCodeStyleCode = `
<div class="tab-nav tab-nav-card">
  <button class="tab-btn is-active" onclick="tabSwitch(this)">index.html</button>
  <button class="tab-btn" onclick="tabSwitch(this)">style.css</button>
</div>
`;

const cardTopBorderAlpineCode = `
<!-- njx-alpine.js preset: x-data="njxTabs" — same .tab-nav-card classes -->
<div class="tab-wrap" x-data="njxTabs">
  <div class="tab-nav tab-nav-card">
    <button class="tab-btn" :class="{ 'is-active': isActive(0) }" @click="select(0)">index.html</button>
    <button class="tab-btn" :class="{ 'is-active': isActive(1) }" @click="select(1)">style.css</button>
  </div>
  <div class="tab-content tab-content-bordered">
    <div class="tab-panel" :class="{ 'is-active': isActive(0) }">...</div>
    <div class="tab-panel" :class="{ 'is-active': isActive(1) }">...</div>
  </div>
</div>
`;

const badgesFullWidthCode = `
<!-- Full-width tabs with badges -->
<div class="tab-nav is-full">
  <button class="tab-btn is-active" onclick="tabSwitch(this)">
    Inbox <span class="tab-badge">4</span>
  </button>
  <button class="tab-btn" onclick="tabSwitch(this)">
    Sent <span class="tab-badge">12</span>
  </button>
</div>
`;

const badgesFullWidthAlpineCode = `
<!-- njx-alpine.js preset: x-data="njxTabs" -->
<div class="tab-wrap" x-data="njxTabs">
  <div class="tab-nav is-full">
    <button class="tab-btn" :class="{ 'is-active': isActive(0) }" @click="select(0)">
      Inbox <span class="tab-badge">4</span>
    </button>
    <button class="tab-btn" :class="{ 'is-active': isActive(1) }" @click="select(1)">
      Sent <span class="tab-badge">12</span>
    </button>
  </div>
  <div class="tab-content">
    <div class="tab-panel" :class="{ 'is-active': isActive(0) }">4 unread messages.</div>
    <div class="tab-panel" :class="{ 'is-active': isActive(1) }">12 sent messages.</div>
  </div>
</div>
`;

const sizesSmDefaultLgCode = `
<div class="tab-nav tab-nav-sm">...</div>
<div class="tab-nav">...</div>
<div class="tab-nav tab-nav-lg">...</div>
`;
---

<section class="lib-section" id="tabs">
  <div class="lib-section-title">🗂 Tabs</div>
  <div class="lib-section-desc">
    From <code>_tab.css</code>. Variants: underline (default),
    <code>.tab-nav-pills</code>, <code>.tab-nav-boxed</code>, <code
      >.tab-nav-card</code
    >. Modifiers:
    <code>.is-full</code>, <code>.tab-nav-sm</code>, <code>.tab-nav-lg</code>.
    JS: <code>tabSwitch(btn)</code>.
  </div>

  <!-- Underline (default) · Alpine-рецепт вторым табом -->
  <Demo label={'Default — underline'} previewClass="col" previewStyle="align-items:stretch" code={defaultUnderlineCode}>
    <Fragment slot="alpine" is:raw>
<!-- Alpine drives the same .is-active classes — no tabSwitch() needed -->
<div class="tab-wrap" x-data="{ tab: 0 }">
  <div class="tab-nav">
    <button class="tab-btn" :class="{ 'is-active': tab === 0 }" @click="tab = 0">Tab 1</button>
    <button class="tab-btn" :class="{ 'is-active': tab === 1 }" @click="tab = 1">Tab 2</button>
    <button class="tab-btn" :class="{ 'is-active': tab === 2 }" @click="tab = 2">Tab 3</button>
  </div>
  <div class="tab-content">
    <div class="tab-panel" :class="{ 'is-active': tab === 0 }">Content 1</div>
    <div class="tab-panel" :class="{ 'is-active': tab === 1 }">Content 2</div>
    <div class="tab-panel" :class="{ 'is-active': tab === 2 }">Content 3</div>
  </div>
</div>
    </Fragment>
    <Fragment is:raw>
      <div class="tab-wrap">
        <div class="tab-nav">
          <button class="tab-btn is-active" onclick="tabSwitch(this)"
            >Overview</button
          >
          <button class="tab-btn" onclick="tabSwitch(this)">Features</button>
          <button class="tab-btn" onclick="tabSwitch(this)">Changelog</button>
        </div>
        <div class="tab-content">
          <div
            class="tab-panel is-active text-sm text-muted"
            style="line-height:1.7"
          >
            njX is a zero-dependency CSS library with 9 built-in themes. One <code
              >&lt;link&gt;</code
            > tag — no build step required.
          </div>
          <div class="tab-panel text-sm text-muted" style="line-height:1.7">
            9 themes · 30+ components · CSS variables · Bulma-compatible · 0
            dependencies.
          </div>
          <div class="tab-panel text-sm text-muted" style="line-height:1.7">
            <strong>v1.3</strong> — Added <code>_links.css</code>, new collapse
            variants, improved tab system.
          </div>
        </div>
      </div>
    </Fragment>
  </Demo>

  <!-- Pills -->
  <Demo is:raw label={'Pills'} previewClass="col" previewStyle="align-items:stretch" code={pillsCode} alpineCode={pillsAlpineCode} htmlTabLabel="JS">
      <div class="tab-wrap">
        <div class="tab-nav tab-nav-pills" style="align-self:flex-start">
          <button class="tab-btn is-active" onclick="tabSwitch(this)"
            >Daily</button
          >
          <button class="tab-btn" onclick="tabSwitch(this)">Weekly</button>
          <button class="tab-btn" onclick="tabSwitch(this)">Monthly</button>
        </div>
        <div class="tab-content">
          <div class="tab-panel is-active text-sm text-muted">
            Stats for today: 1,204 visits · 38 signups
          </div>
          <div class="tab-panel text-sm text-muted">
            Stats for this week: 8,720 visits · 214 signups
          </div>
          <div class="tab-panel text-sm text-muted">
            Stats for this month: 32,100 visits · 890 signups
          </div>
        </div>
      </div>
    </Demo>

  <!-- Boxed -->
  <Demo is:raw label={'Boxed'} previewClass="col" previewStyle="align-items:stretch" code={boxedCode}>
      <div class="tab-wrap">
        <div class="tab-nav tab-nav-boxed">
          <button class="tab-btn is-active" onclick="tabSwitch(this)"
            >HTML</button
          >
          <button class="tab-btn" onclick="tabSwitch(this)">CSS</button>
          <button class="tab-btn" onclick="tabSwitch(this)">JS</button>
        </div>
        <div class="tab-content tab-content-bordered">
          <div class="tab-panel is-active text-sm text-muted">
            <code>&lt;div class="tab-wrap"&gt;...&lt;/div&gt;</code>
          </div>
          <div class="tab-panel text-sm text-muted">
            <code>.tab-nav &#123; display: flex; &#125;</code>
          </div>
          <div class="tab-panel text-sm text-muted">
            <code>function tabSwitch(btn) &#123; ... &#125;</code>
          </div>
        </div>
      </div>
    </Demo>

  <!-- Card (VS Code style) -->
  <Demo is:raw label={'Card — top border (VS Code style)'} previewClass="col" previewStyle="align-items:stretch" code={cardTopBorderVsCodeStyleCode} alpineCode={cardTopBorderAlpineCode} htmlTabLabel="JS">
      <div class="tab-wrap">
        <div class="tab-nav tab-nav-card">
          <button class="tab-btn is-active" onclick="tabSwitch(this)"
            >index.html</button
          >
          <button class="tab-btn" onclick="tabSwitch(this)">style.css</button>
          <button class="tab-btn" onclick="tabSwitch(this)">main.js</button>
        </div>
        <div class="tab-content tab-content-bordered">
          <div class="tab-panel is-active text-sm text-muted">
            <code>&lt;!DOCTYPE html&gt;&lt;html data-theme="dark"&gt;...</code>
          </div>
          <div class="tab-panel text-sm text-muted">
            <code>@import "_base.css"; @import "_buttons.css";</code>
          </div>
          <div class="tab-panel text-sm text-muted">
            <code>document.addEventListener('DOMContentLoaded', init);</code>
          </div>
        </div>
      </div>
    </Demo>

  <!-- With badges + full width -->
  <Demo is:raw label={'Badges + full width'} previewClass="col" previewStyle="align-items:stretch" code={badgesFullWidthCode} alpineCode={badgesFullWidthAlpineCode} htmlTabLabel="JS">
      <div class="tab-wrap">
        <div class="tab-nav is-full">
          <button class="tab-btn is-active" onclick="tabSwitch(this)">
            Inbox <span class="tab-badge">4</span>
          </button>
          <button class="tab-btn" onclick="tabSwitch(this)">
            Sent <span class="tab-badge">12</span>
          </button>
          <button class="tab-btn" onclick="tabSwitch(this)">
            Drafts <span class="tab-badge">1</span>
          </button>
        </div>
        <div class="tab-content">
          <div class="tab-panel is-active text-sm text-muted">
            4 unread messages in your inbox.
          </div>
          <div class="tab-panel text-sm text-muted">12 sent messages.</div>
          <div class="tab-panel text-sm text-muted">1 draft saved.</div>
        </div>
      </div>
    </Demo>

  <!-- Sizes -->
  <Demo is:raw label={'Sizes — sm / default / lg'} previewClass="col" previewStyle="align-items:stretch;gap:20px" code={sizesSmDefaultLgCode}>
      <div class="tab-nav tab-nav-sm">
        <button class="tab-btn is-active" onclick="tabSwitch(this)"
          >Small</button
        >
        <button class="tab-btn" onclick="tabSwitch(this)">Tabs</button>
        <button class="tab-btn" onclick="tabSwitch(this)">Here</button>
      </div>
      <div class="tab-nav">
        <button class="tab-btn is-active" onclick="tabSwitch(this)"
          >Default</button
        >
        <button class="tab-btn" onclick="tabSwitch(this)">Size</button>
        <button class="tab-btn" onclick="tabSwitch(this)">Tabs</button>
      </div>
      <div class="tab-nav tab-nav-lg">
        <button class="tab-btn is-active" onclick="tabSwitch(this)"
          >Large</button
        >
        <button class="tab-btn" onclick="tabSwitch(this)">Tabs</button>
        <button class="tab-btn" onclick="tabSwitch(this)">Demo</button>
      </div>
    </Demo>
</section>
