---
import Demo from '../shared/Demo.astro';

const unit1Code = `
<!-- _table.css: is-striped | is-hoverable | is-bordered + table-container -->
<div class="table-container">
  <table class="table is-striped is-hoverable">
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Alex</td>
        <td>alex@mail.com</td>
        <td><span class="tag tag-success">Active</span></td>
      </tr>
      <tr class="is-selected">
        <td>Ivan</td>
        <td>ivan@mail.com</td>
        <td><span class="tag tag-error">Banned</span></td>
      </tr>
    </tbody>
  </table>
</div>
`;
---

      <section class="lib-section" id="table">
        <div class="lib-section-title">📋 Table</div>
        <div class="lib-section-desc">From <code>_table.css</code>.</div>
        <Demo is:raw previewClass="col" previewStyle="align-items:stretch" code={unit1Code}>
            <div class="table-container">
              <table class="table is-striped is-hoverable">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Alex</td>
                    <td>alex@mail.com</td>
                    <td>Admin</td>
                    <td><span class="tag tag-success">Active</span></td>
                  </tr>
                  <tr>
                    <td>Maria</td>
                    <td>maria@mail.com</td>
                    <td>User</td>
                    <td><span class="tag tag-warning">Pending</span></td>
                  </tr>
                  <tr class="is-selected">
                    <td>Ivan</td>
                    <td>ivan@mail.com</td>
                    <td>Editor</td>
                    <td><span class="tag tag-error">Banned</span></td>
                  </tr>
                  <tr>
                    <td>Olga</td>
                    <td>olga@mail.com</td>
                    <td>User</td>
                    <td><span class="tag tag-primary">Active</span></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </Demo>
      </section>
