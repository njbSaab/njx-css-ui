---

<section class="lib-section" id="buttons">
    <div class="lib-section-title">🔲 Buttons</div>
    <div class="lib-section-desc">
        All variants from <code>_buttons.css</code>. Base: <code>.btn</code> + variant.
    </div>

    <Demo is:raw code={unit1Code}>
            <button class="btn btn-primary">btn-primary</button>
            <button class="btn btn-accent">btn-accent</button>
            <button class="btn btn-success">btn-success</button>
            <button class="btn btn-error">btn-error</button>
            <button class="btn btn-warning">btn-warning</button>
            <button class="btn btn-dark">btn-dark</button>
            <button class="btn btn-light">btn-light</button>
        </Demo>

    <Demo is:raw label={'Outline'} code={outlineCode}>
            <button class="btn btn-outline">btn-outline</button>
            <button class="btn btn-outline-accent">btn-outline-accent</button>
            <button class="btn btn-outline-success">btn-outline-success</button>
            <button class="btn btn-outline-error">btn-outline-error</button>
            <button class="btn btn-outline-warning">btn-outline-warning</button>
            <button class="btn btn-outline-white">btn-outline-white</button>
        </Demo>

    <Demo is:raw label={'Ghost'} code={ghostCode}>
            <button class="btn btn-ghost">btn-ghost</button>
            <button class="btn btn-ghost-primary">btn-ghost-primary</button>
            <button class="btn btn-ghost-accent">btn-ghost-accent</button>
            <button class="btn btn-ghost-success">btn-ghost-success</button>
            <button class="btn btn-ghost-error">btn-ghost-error</button>
            <button class="btn btn-ghost-warning">btn-ghost-warning</button>
        </Demo>

    <!-- ── Soft / Tinted variants ── -->
    <Demo is:raw label={'Soft / Tinted variants'} previewStyle="gap:10px;flex-wrap:wrap" code={softTintedVariantsCode}>
            <button class="btn btn-soft-primary">soft-primary</button>
            <button class="btn btn-soft-accent">soft-accent</button>
            <button class="btn btn-soft-success">soft-success</button>
            <button class="btn btn-soft-error">soft-error</button>
            <button class="btn btn-soft-warning">soft-warning</button>
            <button class="btn btn-soft-info">soft-info</button>
        </Demo>

    <!-- Link buttons: Filled -->
    <Demo is:raw label={'Link buttons — Filled'} previewStyle="gap:10px;flex-wrap:wrap;align-items:center" code={linkButtonsFilledCode}>
            <a href="#" class="link-btn link-btn-primary">Primary</a>
            <a href="#" class="link-btn link-btn-accent">Accent</a>
            <a href="#" class="link-btn link-btn-success">Success</a>
            <a href="#" class="link-btn link-btn-error">Error</a>
            <a href="#" class="link-btn link-btn-warning">Warning</a>
            <a href="#" class="link-btn link-btn-dark">Dark</a>
            <a href="#" class="link-btn link-btn-light">Light</a>
        </Demo>

    <!-- Link buttons: Outline -->
    <Demo is:raw label={'Link buttons — Outline'} previewStyle="gap:10px;flex-wrap:wrap;align-items:center" code={linkButtonsOutlineCode}>
            <a href="#" class="link-btn link-btn-outline-primary">Primary</a>
            <a href="#" class="link-btn link-btn-outline-accent">Accent</a>
            <a href="#" class="link-btn link-btn-outline-success">Success</a>
            <a href="#" class="link-btn link-btn-outline-error">Error</a>
            <a href="#" class="link-btn link-btn-outline-warning">Warning</a>
            <a href="#" class="link-btn link-btn-outline-dark">Dark</a>
            <a href="#" class="link-btn link-btn-outline-light">Light</a>
        </Demo>

    <!-- Link buttons: Ghost -->
