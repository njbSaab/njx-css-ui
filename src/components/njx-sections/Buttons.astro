                    stroke-linecap="round"><path d="M8 3v10M3 8h10"></path></svg
                >
            </button>
            <button class="btn btn-primary btn-icon" title="md (default)">
                <svg
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"><path d="M8 3v10M3 8h10"></path></svg
                >
            </button>
            <button class="btn btn-accent btn-icon btn-lg" title="lg">
                <svg
                    width="18"
                    height="18"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"><path d="M8 3v10M3 8h10"></path></svg
