---
import Demo from '../shared/Demo.astro';

const textLinesCode = `
<div class="skeleton-group">
  <span class="skeleton skeleton-lg skeleton-full"></span>
  <span class="skeleton skeleton-md skeleton-3/4"></span>
  <span class="skeleton skeleton-md skeleton-full"></span>
  <span class="skeleton skeleton-md skeleton-2/3"></span>
  <span class="skeleton skeleton-sm skeleton-1/2"></span>
</div>
`;

const avatarTextUserRowCode = `
<div class="skeleton-user">
  <span class="skeleton skeleton-circle" style="width:48px;height:48px"></span>
  <div class="skeleton-user-info">
    <span class="skeleton skeleton-md skeleton-2/3"></span>
    <span class="skeleton skeleton-sm skeleton-1/2"></span>
  </div>
</div>
`;

const cardSkeletonCode = `
<div class="skeleton-card">
  <span class="skeleton skeleton-card-img"></span>
  <div class="skeleton-card-body">
    <span class="skeleton skeleton-lg skeleton-3/4"></span>
    <span class="skeleton skeleton-md skeleton-full"></span>
    <span class="skeleton skeleton-md skeleton-2/3"></span>
    <span class="skeleton skeleton-xl skeleton-1/3"></span>
  </div>
</div>
`;

const listRowsCode = `
<div class="skeleton-list">
  <div class="skeleton-list-item">
    <span class="skeleton skeleton-circle" style="width:40px;height:40px"></span>
    <div class="skeleton-list-item-info">
      <span class="skeleton skeleton-md skeleton-1/2"></span>
      <span class="skeleton skeleton-sm skeleton-3/4"></span>
    </div>
    <span class="skeleton skeleton-sm" style="width:52px"></span>
  </div>
  <!-- repeat rows -->
</div>
`;

const tableRowsCode = `
<div class="skeleton-table">
  <div class="skeleton-table-row">
    <span class="skeleton skeleton-circle" style="width:32px;height:32px"></span>
    <span class="skeleton skeleton-sm skeleton-1/4"></span>
    <span class="skeleton skeleton-sm skeleton-2/3"></span>
    <span class="skeleton skeleton-sm skeleton-1/3"></span>
    <span class="skeleton skeleton-sm skeleton-pill" style="width:60px"></span>
  </div>
  <!-- repeat rows -->
</div>
`;

const buttonSkeletonsCode = `
<span class="skeleton skeleton-xl skeleton-pill" style="width:100px"></span>
<span class="skeleton skeleton-xl skeleton-pill" style="width:130px"></span>
<span class="skeleton skeleton-xl skeleton-rounded" style="width:110px"></span>
<span class="skeleton skeleton-circle" style="width:48px;height:48px"></span>
`;

const buttonSoftVariantsCode = `
<!-- .skeleton-soft dims to ~40% opacity (ghost/outline button) -->
<span class="skeleton skeleton-xl skeleton-pill" style="width:110px"></span>
<span class="skeleton skeleton-xl skeleton-pill skeleton-soft" style="width:110px"></span>
<span class="skeleton skeleton-xl skeleton-rounded skeleton-soft" style="width:100px"></span>
<span class="skeleton skeleton-circle skeleton-soft" style="width:40px;height:40px"></span>
`;

const waveAnimationCode = `
<!-- Add .skeleton-wave wrapper to switch animation -->
<div class="skeleton-wave skeleton-group">
  <span class="skeleton skeleton-lg skeleton-full"></span>
  <span class="skeleton skeleton-md skeleton-3/4"></span>
  <span class="skeleton skeleton-md skeleton-full"></span>
  <span class="skeleton skeleton-md skeleton-1/2"></span>
</div>
`;

const formCode = `
<div class="skeleton-form">
  <div class="skeleton-form-row-inline">
    <div class="skeleton-form-row">
      <span class="skeleton skeleton-form-label"></span>
      <span class="skeleton skeleton-form-input"></span>
    </div>
    <div class="skeleton-form-row">
      <span class="skeleton skeleton-form-label"></span>
      <span class="skeleton skeleton-form-input"></span>
    </div>
  </div>
  <div class="skeleton-form-row">
    <span class="skeleton skeleton-form-label"></span>
    <span class="skeleton skeleton-form-input"></span>
  </div>
  <!-- submit / cancel / delete row -->
  <div style="display:flex;gap:10px;align-items:center">
    <span class="skeleton skeleton-xl skeleton-pill" style="width:110px"></span>
    <span class="skeleton skeleton-xl skeleton-pill skeleton-soft" style="width:90px"></span>
    <span class="skeleton skeleton-xl skeleton-pill skeleton-soft" style="width:90px;margin-left:auto"></span>
  </div>
</div>
`;

const statsDashboardCode = `
<div class="skeleton-stats">
  <div class="skeleton-stat">
    <span class="skeleton skeleton-stat-icon"></span>
    <span class="skeleton skeleton-stat-value"></span>
    <span class="skeleton skeleton-stat-label"></span>
  </div>
  <!-- repeat per stat -->
</div>
`;

const galleryGridCode = `
<div class="skeleton-gallery">
  <span class="skeleton skeleton-gallery-item"></span>
  <span class="skeleton skeleton-gallery-item"></span>
  <span class="skeleton skeleton-gallery-item"></span>
  <span class="skeleton skeleton-gallery-item"></span>
  <span class="skeleton skeleton-gallery-item"></span>
  <span class="skeleton skeleton-gallery-item"></span>
</div>
`;

const detailProductCode = `
<div class="skeleton-detail">
  <span class="skeleton skeleton-detail-img"></span>
  <div class="skeleton-detail-info">
    <span class="skeleton skeleton-lg skeleton-3/4"></span>
    <span class="skeleton skeleton-md skeleton-full"></span>
    <span class="skeleton skeleton-md skeleton-2/3"></span>
    <span class="skeleton skeleton-xl skeleton-1/3"></span>
  </div>
</div>
`;
---

<section class="lib-section" id="skeleton">
  <div class="lib-section-title">💀 Skeleton</div>
  <div class="lib-section-desc">Loading placeholders from <code>_skeleton.css</code>. Base: <code>.skeleton</code> +
    size/shape modifiers. Three animations: shimmer, pulse, wave.</div>

  <!-- 1. Text block -->
  <Demo is:raw label={'Text lines'} code={textLinesCode}>
      <div class="skeleton-group" style="max-width:320px">
        <span class="skeleton skeleton-lg skeleton-full"></span>
        <span class="skeleton skeleton-md skeleton-3/4"></span>
        <span class="skeleton skeleton-md skeleton-full"></span>
        <span class="skeleton skeleton-md skeleton-2/3"></span>
        <span class="skeleton skeleton-sm skeleton-1/2"></span>
      </div>
    </Demo>

  <!-- 2. Avatar + text -->
  <Demo is:raw label={'Avatar + text (user row)'} code={avatarTextUserRowCode}>
      <div class="skeleton-user" style="max-width:340px">
        <span class="skeleton skeleton-circle" style="width:48px;height:48px"></span>
        <div class="skeleton-user-info">
          <span class="skeleton skeleton-md skeleton-2/3"></span>
          <span class="skeleton skeleton-sm skeleton-1/2"></span>
        </div>
      </div>
    </Demo>

  <!-- 3. Card -->
  <Demo is:raw label={'Card skeleton'} code={cardSkeletonCode}>
      <div class="skeleton-card">
        <span class="skeleton skeleton-card-img"></span>
        <div class="skeleton-card-body">
          <span class="skeleton skeleton-lg skeleton-3/4"></span>
          <span class="skeleton skeleton-md skeleton-full"></span>
          <span class="skeleton skeleton-md skeleton-2/3"></span>
          <span class="skeleton skeleton-xl skeleton-1/3" style="margin-top:4px;border-radius:8px"></span>
        </div>
      </div>
      <div class="skeleton-card">
        <span class="skeleton skeleton-card-img"></span>
        <div class="skeleton-card-body">
          <span class="skeleton skeleton-lg skeleton-1/2"></span>
          <span class="skeleton skeleton-md skeleton-full"></span>
          <span class="skeleton skeleton-md skeleton-3/4"></span>
          <span class="skeleton skeleton-xl skeleton-1/3" style="margin-top:4px;border-radius:8px"></span>
        </div>
      </div>
    </Demo>

  <!-- 4. List -->
  <Demo is:raw label={'List rows'} code={listRowsCode}>
      <div class="skeleton-list" style="max-width:380px">
        <div class="skeleton-list-item">
          <span class="skeleton skeleton-circle" style="width:40px;height:40px"></span>
          <div class="skeleton-list-item-info">
            <span class="skeleton skeleton-md skeleton-1/2"></span>
            <span class="skeleton skeleton-sm skeleton-3/4"></span>
          </div>
          <span class="skeleton skeleton-sm" style="width:52px"></span>
        </div>
        <div class="skeleton-list-item">
          <span class="skeleton skeleton-circle" style="width:40px;height:40px"></span>
          <div class="skeleton-list-item-info">
            <span class="skeleton skeleton-md skeleton-2/3"></span>
            <span class="skeleton skeleton-sm skeleton-1/2"></span>
          </div>
          <span class="skeleton skeleton-sm" style="width:52px"></span>
        </div>
        <div class="skeleton-list-item">
          <span class="skeleton skeleton-circle" style="width:40px;height:40px"></span>
          <div class="skeleton-list-item-info">
            <span class="skeleton skeleton-md skeleton-3/4"></span>
            <span class="skeleton skeleton-sm skeleton-1/3"></span>
          </div>
          <span class="skeleton skeleton-sm" style="width:52px"></span>
        </div>
      </div>
    </Demo>

  <!-- 5. Table rows -->
  <Demo is:raw label={'Table rows'} code={tableRowsCode}>
      <div class="skeleton-table" style="max-width:480px">
        <div class="skeleton-table-row"
          style="padding-bottom:4px;border-bottom:1px solid color-mix(in srgb,currentColor 10%,transparent)">
          <span style="flex:0 0 32px"></span>
          <span class="skeleton skeleton-sm skeleton-1/4" style="opacity:.5"></span>
          <span class="skeleton skeleton-sm skeleton-1/4" style="opacity:.5"></span>
          <span class="skeleton skeleton-sm skeleton-1/4" style="opacity:.5"></span>
          <span class="skeleton skeleton-sm" style="width:60px;opacity:.5"></span>
        </div>
        <div class="skeleton-table-row">
          <span class="skeleton skeleton-circle" style="width:32px;height:32px"></span>
          <span class="skeleton skeleton-sm skeleton-1/4"></span>
          <span class="skeleton skeleton-sm skeleton-2/3"></span>
          <span class="skeleton skeleton-sm skeleton-1/3"></span>
          <span class="skeleton skeleton-sm skeleton-pill" style="width:60px"></span>
        </div>
        <div class="skeleton-table-row">
          <span class="skeleton skeleton-circle" style="width:32px;height:32px"></span>
          <span class="skeleton skeleton-sm skeleton-1/3"></span>
          <span class="skeleton skeleton-sm skeleton-1/2"></span>
          <span class="skeleton skeleton-sm skeleton-1/4"></span>
          <span class="skeleton skeleton-sm skeleton-pill" style="width:60px"></span>
        </div>
        <div class="skeleton-table-row">
          <span class="skeleton skeleton-circle" style="width:32px;height:32px"></span>
          <span class="skeleton skeleton-sm skeleton-1/4"></span>
          <span class="skeleton skeleton-sm skeleton-3/4"></span>
          <span class="skeleton skeleton-sm skeleton-1/3"></span>
          <span class="skeleton skeleton-sm skeleton-pill" style="width:60px"></span>
        </div>
      </div>
    </Demo>

  <!-- 6. Buttons -->
  <Demo is:raw label={'Button skeletons'} code={buttonSkeletonsCode}>
      <span class="skeleton skeleton-xl skeleton-pill" style="width:100px"></span>
      <span class="skeleton skeleton-xl skeleton-pill" style="width:130px"></span>
      <span class="skeleton skeleton-xl skeleton-rounded" style="width:110px"></span>
      <span class="skeleton skeleton-circle" style="width:48px;height:48px"></span>
    </Demo>

  <!-- 6b. Button soft variants -->
  <Demo is:raw label={'Button soft variants'} code={buttonSoftVariantsCode}>
      <span class="skeleton skeleton-xl skeleton-pill" style="width:110px"></span>
      <span class="skeleton skeleton-xl skeleton-pill skeleton-soft" style="width:110px"></span>
      <span class="skeleton skeleton-xl skeleton-rounded skeleton-soft" style="width:100px"></span>
      <span class="skeleton skeleton-circle skeleton-soft" style="width:40px;height:40px"></span>
    </Demo>
  <!-- 8. Wave animation -->
  <Demo is:raw label={'Wave animation'} code={waveAnimationCode}>
      <div class="skeleton-wave skeleton-group" style="max-width:320px">
        <span class="skeleton skeleton-lg skeleton-full"></span>
        <span class="skeleton skeleton-md skeleton-3/4"></span>
        <span class="skeleton skeleton-md skeleton-full"></span>
        <span class="skeleton skeleton-md skeleton-1/2"></span>
      </div>
    </Demo>

  <!-- 7. Form skeleton -->
  <Demo is:raw label={'Form'} previewClass="col" code={formCode}>
      <div class="skeleton-form" style="max-width:360px">
        <div class="skeleton-form-row-inline">
          <div class="skeleton-form-row">
            <span class="skeleton skeleton-form-label"></span>
            <span class="skeleton skeleton-form-input"></span>
          </div>
          <div class="skeleton-form-row">
            <span class="skeleton skeleton-form-label"></span>
            <span class="skeleton skeleton-form-input"></span>
          </div>
        </div>
        <div class="skeleton-form-row">
          <span class="skeleton skeleton-form-label"></span>
          <span class="skeleton skeleton-form-input"></span>
        </div>
        <div class="skeleton-form-row">
          <span class="skeleton skeleton-form-label"></span>
          <span class="skeleton skeleton-form-input" style="height:80px"></span>
        </div>
        <div style="display:flex;gap:10px;align-items:center">
          <span class="skeleton skeleton-xl skeleton-pill" style="width:110px"></span>
          <span class="skeleton skeleton-xl skeleton-pill skeleton-soft" style="width:90px"></span>
          <span class="skeleton skeleton-xl skeleton-pill skeleton-soft" style="width:90px;margin-left:auto"></span>
        </div>
      </div>
    </Demo>

  <!-- 8. Stats/Dashboard skeleton -->
  <Demo is:raw label={'Stats / Dashboard'} previewClass="col" code={statsDashboardCode}>
      <div class="skeleton-stats">
        <div class="skeleton-stat">
          <span class="skeleton skeleton-stat-icon"></span>
          <span class="skeleton skeleton-stat-value"></span>
          <span class="skeleton skeleton-stat-label"></span>
        </div>
        <div class="skeleton-stat">
          <span class="skeleton skeleton-stat-icon"></span>
          <span class="skeleton skeleton-stat-value"></span>
          <span class="skeleton skeleton-stat-label"></span>
        </div>
        <div class="skeleton-stat">
          <span class="skeleton skeleton-stat-icon"></span>
          <span class="skeleton skeleton-stat-value"></span>
          <span class="skeleton skeleton-stat-label"></span>
        </div>
      </div>
    </Demo>

  <!-- 9. Gallery skeleton -->
  <Demo is:raw label={'Gallery grid'} previewClass="col" code={galleryGridCode}>
      <div class="skeleton-gallery" style="max-width:420px">
        <span class="skeleton skeleton-gallery-item"></span>
        <span class="skeleton skeleton-gallery-item"></span>
        <span class="skeleton skeleton-gallery-item"></span>
        <span class="skeleton skeleton-gallery-item"></span>
        <span class="skeleton skeleton-gallery-item"></span>
        <span class="skeleton skeleton-gallery-item"></span>
      </div>
    </Demo>

  <!-- 10. Detail / Product skeleton -->
  <Demo is:raw label={'Detail / Product'} previewClass="col" code={detailProductCode}>
      <div class="skeleton-detail" style="max-width:480px">
        <span class="skeleton skeleton-detail-img"></span>
        <div class="skeleton-detail-info">
          <span class="skeleton skeleton-lg skeleton-3/4"></span>
          <span class="skeleton skeleton-md skeleton-full"></span>
          <span class="skeleton skeleton-md skeleton-2/3"></span>
          <span class="skeleton skeleton-sm skeleton-1/2"></span>
          <span class="skeleton skeleton-xl skeleton-1/3" style="margin-top:8px;border-radius:8px"></span>
        </div>
      </div>
    </Demo>

</section>