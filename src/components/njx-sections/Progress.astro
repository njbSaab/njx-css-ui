---
import Demo from '../shared/Demo.astro';

const unit1Code = `
<!-- progress native: is-primary | is-accent | is-success | is-large -->
<progress class="progress is-primary" value="70" max="100"></progress>
<progress class="progress is-success is-large" value="90" max="100"></progress>

<!-- progress-bar custom: with animation -->
<div class="progress-bar">
  <div class="progress-bar-fill" style="width:65%"></div>
</div>

<!-- gradient + animation -->
<div class="progress-bar">
  <div class="progress-bar-fill is-gradient is-animated" style="width:80%"></div>
</div>
`;
---

<section class="lib-section" id="progress">
    <div class="lib-section-title">📊 Progress</div>
    <div class="lib-section-desc">From <code>_notifications.css</code>.</div>
    <Demo is:raw previewClass="col" previewStyle="align-items:stretch;gap:16px" code={unit1Code}>
            <div>
                <div class="text-xs text-muted mb-2">
                    progress (native)
                </div><progress class="progress is-primary" value="70" max="100"
                ></progress>
            </div>
            <div>
                <div class="text-xs text-muted mb-2">
                    progress is-accent
                </div><progress class="progress is-accent" value="45" max="100"
                ></progress>
            </div>
            <div>
                <div class="text-xs text-muted mb-2">
                    progress is-success
                </div><progress class="progress is-success" value="90" max="100"
                ></progress>
            </div>
            <div>
                <div class="text-xs text-muted mb-2">
                    progress is-large
                </div><progress
                    class="progress is-large is-primary"
                    value="60"
                    max="100"></progress>
            </div>
            <div>
                <div class="text-xs text-muted mb-2">progress-bar (custom)</div>
                <div class="progress-bar">
                    <div class="progress-bar-fill" style="width:65%"></div>
                </div>
            </div>
            <div>
                <div class="text-xs text-muted mb-2">
                    progress-bar gradient animated
                </div>
                <div class="progress-bar">
                    <div
                        class="progress-bar-fill is-gradient is-animated"
                        style="width:80%"
                    >
                    </div>
                </div>
            </div>
        </Demo>
</section>
