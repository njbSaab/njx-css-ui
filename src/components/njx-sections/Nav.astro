---
import Demo from '../shared/Demo.astro';

const solidBackgroundBorderCode = `
<nav class="nav nav-solid">
  <div class="nav-left">
    <a class="nav-brand" href="#">⚡ Brand</a>
  </div>
  <div class="nav-center">
    <a href="#" class="nav-link is-active">Home</a>
    <a href="#" class="nav-link">About</a>
    <a href="#" class="nav-link">Docs</a>
  </div>
  <div class="nav-right">
    <a class="btn btn-primary btn-sm" href="#">Sign in</a>
  </div>
</nav>
`;

const glassFrostedBackdropCode = `
<nav class="nav nav-glass">
  <!-- backdrop-filter: blur(20px), semi-transparent background -->
</nav>
`;

const primaryThemedAccentCode = `
<nav class="nav nav-primary nav-solid">...</nav>
`;

const darkAlwaysDarkCode = `
<nav class="nav nav-dark">...</nav>
<!-- #0f0f0f background regardless of data-theme -->
`;

const floatingPillShapeCode = `
<nav class="nav nav-floating">
  <!-- border-radius: 99px, backdrop-filter, box-shadow -->
</nav>
`;

const underlineActiveLinkWithUnderlineCode = `
<nav class="nav nav-solid nav-underline">...</nav>
`;

const sizesSmDefaultLgCode = `
<nav class="nav nav-solid nav-sm">...</nav>   <!-- 48px -->
<nav class="nav nav-solid">...</nav>          <!-- 60px default -->
<nav class="nav nav-solid nav-lg">...</nav>   <!-- 72px -->
`;
---

<section class="lib-section" id="nav">
    <div class="lib-section-title">📌 Nav</div>
    <div class="lib-section-desc">
        From <code>_nav.css</code>. Sections <code>.nav-left</code>
        <code>.nav-center</code>
        <code>.nav-right</code>. Variants: <code>.nav-solid</code>
        <code>.nav-glass</code>
        <code>.nav-primary</code>
        <code>.nav-dark</code>
        <code>.nav-floating</code>
        <code>.nav-underline</code>. Sizes: <code>.nav-sm</code>
        <code>.nav-lg</code>.
    </div>

    <!-- Solid -->
    <Demo is:raw label={'Solid — background + border'} previewClass="col" previewStyle="align-items:stretch" code={solidBackgroundBorderCode}>
            <nav class="nav nav-solid">
                <div class="nav-left">
                    <a class="nav-brand" href="#">⚡ njX</a>
                </div>
                <div class="nav-center">
                    <a href="#" class="nav-link is-active">Home</a>
                    <a href="#" class="nav-link">Components</a>
                    <a href="#" class="nav-link">Themes</a>
                    <a href="#" class="nav-link">Docs</a>
                </div>
                <div class="nav-right">
                    <a href="#" class="nav-link">GitHub</a>
                    <a class="btn btn-primary btn-sm" href="#">Get Started</a>
                </div>
            </nav>
        </Demo>

    <!-- Glass -->
    <Demo is:raw label={'Glass — frosted backdrop'} previewClass="col" previewStyle="align-items:stretch;padding:0;overflow:hidden;border-radius:var(--radius-lg)" code={glassFrostedBackdropCode}>
            <div
                style="padding:24px 0 0;background:linear-gradient(135deg,color-mix(in srgb,var(--color-primary) 18%,transparent),color-mix(in srgb,var(--color-accent,#06b6d4) 10%,transparent))"
            >
                <nav
                    class="nav nav-glass"
                    style="margin:0 16px;border-radius:var(--radius-lg)"
                >
                    <div class="nav-left">
                        <a class="nav-brand" href="#">🎨 Studio</a>
                    </div>
                    <div class="nav-center">
                        <a href="#" class="nav-link is-active">Dashboard</a>
                        <a href="#" class="nav-link">Projects</a>
                        <a href="#" class="nav-link">Analytics</a>
                    </div>
                    <div class="nav-right">
                        <a class="btn btn-ghost btn-sm" href="#">Settings</a>
                        <a class="btn btn-primary btn-sm" href="#"
                            >New project</a
                        >
                    </div>
                </nav>
                <div style="height:32px"></div>
            </div>
        </Demo>

    <!-- Primary -->
    <Demo is:raw label={'Primary — themed accent'} previewClass="col" previewStyle="align-items:stretch" code={primaryThemedAccentCode}>
            <nav class="nav nav-primary nav-solid">
                <div class="nav-left">
                    <a class="nav-brand" href="#">🚀 App</a>
                </div>
                <div class="nav-center">
                    <a href="#" class="nav-link is-active">Home</a>
                    <a href="#" class="nav-link">Features</a>
                    <a href="#" class="nav-link">Pricing</a>
                </div>
                <div class="nav-right">
                    <a class="btn btn-primary btn-sm" href="#">Start free</a>
                </div>
            </nav>
        </Demo>

    <!-- Dark -->
    <Demo is:raw label={'Dark — always dark'} previewClass="col" previewStyle="align-items:stretch" code={darkAlwaysDarkCode}>
            <nav class="nav nav-dark">
                <div class="nav-left">
                    <a class="nav-brand" href="#">⚫ Dark Nav</a>
                </div>
                <div class="nav-center">
                    <a href="#" class="nav-link is-active">Overview</a>
                    <a href="#" class="nav-link">Docs</a>
                    <a href="#" class="nav-link">Blog</a>
                    <a href="#" class="nav-link">Community</a>
                </div>
                <div class="nav-right">
                    <a href="#" class="nav-link">Log in</a>
                    <a class="btn btn-primary btn-sm" href="#">Sign up</a>
                </div>
            </nav>
        </Demo>

    <!-- Floating -->
    <Demo is:raw label={'Floating — pill-shape'} previewClass="col" previewStyle="align-items:center;padding:20px" code={floatingPillShapeCode}>
            <nav class="nav nav-floating" style="width:100%;max-width:620px">
                <div class="nav-left">
                    <a class="nav-brand" href="#">💫 Float</a>
                </div>
                <div class="nav-center">
                    <a href="#" class="nav-link is-active">Home</a>
                    <a href="#" class="nav-link">Work</a>
                    <a href="#" class="nav-link">About</a>
                </div>
                <div class="nav-right">
                    <a
                        class="btn btn-primary btn-sm"
                        style="border-radius:99px"
                        href="#">Hire me</a
                    >
                </div>
            </nav>
        </Demo>

    <!-- Underline -->
    <Demo is:raw label={'Underline — active link with underline'} previewClass="col" previewStyle="align-items:stretch" code={underlineActiveLinkWithUnderlineCode}>
            <nav class="nav nav-solid nav-underline">
                <div class="nav-left">
                    <a class="nav-brand" href="#">📐 Design</a>
                </div>
                <div class="nav-center">
                    <a href="#" class="nav-link is-active">Components</a>
                    <a href="#" class="nav-link">Tokens</a>
                    <a href="#" class="nav-link">Icons</a>
                    <a href="#" class="nav-link">Templates</a>
                </div>
                <div class="nav-right">
                    <a class="btn btn-ghost btn-sm" href="#">v1.3</a>
                </div>
            </nav>
        </Demo>

    <!-- Sizes -->
    <Demo is:raw label={'Sizes — sm / default / lg'} previewClass="col" previewStyle="align-items:stretch;gap:8px" code={sizesSmDefaultLgCode}>
            <nav class="nav nav-solid nav-sm">
                <div class="nav-left">
                    <a class="nav-brand" href="#">Brand</a>
                </div>
                <div class="nav-center">
                    <a href="#" class="nav-link is-active">Home</a><a
                        href="#"
                        class="nav-link">About</a>
                </div>
                <div class="nav-right">
                    <span class="text-xs text-muted">.nav-sm — 48px</span>
                </div>
            </nav>
            <nav class="nav nav-solid">
                <div class="nav-left">
                    <a class="nav-brand" href="#">Brand</a>
                </div>
                <div class="nav-center">
                    <a href="#" class="nav-link is-active">Home</a><a
                        href="#"
                        class="nav-link">About</a>
                </div>
                <div class="nav-right">
                    <span class="text-xs text-muted">default — 60px</span>
                </div>
            </nav>
            <nav class="nav nav-solid nav-lg">
                <div class="nav-left">
                    <a class="nav-brand" href="#">Brand</a>
                </div>
                <div class="nav-center">
                    <a href="#" class="nav-link is-active">Home</a><a
                        href="#"
                        class="nav-link">About</a>
                </div>
                <div class="nav-right">
                    <span class="text-xs text-muted">.nav-lg — 72px</span>
                </div>
            </nav>
        </Demo>
</section>
