---
import Demo from '../shared/Demo.astro';

const scaleEffectsCode = `
<!-- _hovers.css: hover-scale-sm | hover-scale | hover-scale-lg | hover-scale-xl -->
<div class="card hover-scale-sm">...</div>   <!-- scale(1.02) -->
<div class="card hover-scale">...</div>      <!-- scale(1.04) -->
<div class="card hover-scale-lg">...</div>   <!-- scale(1.07) -->
<div class="card hover-scale-xl">...</div>   <!-- scale(1.12) -->
`;

const liftEffectsTranslateyCode = `
<!-- _hovers.css: hover-lift-sm | hover-lift | hover-lift-lg | hover-lift-xl -->
<div class="card hover-lift-sm">...</div>   <!-- translateY(-2px) -->
<div class="card hover-lift">...</div>      <!-- translateY(-4px) -->
<div class="card hover-lift-lg">...</div>   <!-- translateY(-8px) -->
<div class="card hover-lift-xl">...</div>   <!-- translateY(-14px) -->
`;

const glowEffectsBoxShadowCode = `
<!-- hover-glow | hover-glow-accent | hover-glow-success | hover-glow-error | hover-glow-white | hover-glow-intense -->
<div class="card hover-glow">...</div>
<div class="card hover-glow-accent">...</div>
<div class="card hover-glow-success">...</div>
<div class="card hover-glow-error">...</div>
<div class="card hover-glow-white">...</div>
<div class="card hover-glow-intense">...</div>
`;

const brightnessFilterCode = `
<!-- _hovers.css: brightness & filter -->
<div class="card hover-bright">...</div>         <!-- brightness(1.15) -->
<div class="card hover-bright-strong">...</div>  <!-- brightness(1.3) -->
<div class="card hover-dim">...</div>           <!-- brightness(0.8) -->
<div class="card hover-grayscale">...</div>     <!-- grayscale(100%) -->
`;

const opacityEffectsCode = `
<!-- _hovers.css: opacity effects -->
<div class="card hover-opacity-sm">...</div>  <!-- opacity: 0.85 -->
<div class="card hover-opacity">...</div>     <!-- opacity: 0.7 -->
<div class="card hover-opacity-lg">...</div>  <!-- opacity: 0.5 -->
<div class="card hover-fade">...</div>        <!-- opacity: 0.3 -->
`;

const borderEffectsCode = `
<!-- _hovers.css: border effects -->
<div class="card hover-border">...</div>         <!-- border primary -->
<div class="card hover-border-accent">...</div>  <!-- border accent -->
<div class="card hover-border-success">...</div> <!-- border success -->
<div class="card hover-border-glow">...</div>   <!-- border + glow -->
`;

const rotateEffectsCode = `
<!-- _hovers.css: rotate effects -->
<div class="card hover-rotate">...</div>      <!-- rotate(3deg) -->
<div class="card hover-rotate-neg">...</div>  <!-- rotate(-3deg) -->
<div class="card hover-rotate-180">...</div> <!-- rotate(180deg) -->
<div class="card hover-rotate-360">...</div> <!-- rotate(360deg) -->
`;

const cardComboEffectsCode = `
<!-- Combo: hover-card (lift+border+shadow), hover-card-glow, hover-mega -->
<div class="card hover-card">...</div>
<div class="card hover-card-glow">...</div>
<div class="card hover-card-slide">...</div>
<div class="card hover-mega">...</div>

<!-- Can be combined -->
<div class="card hover-scale hover-glow">...</div>
`;

const buttonEffectsCode = `
<!-- hover-btn | hover-btn-press | hover-btn-glow | hover-shimmer -->
<button class="btn btn-primary hover-btn">Button</button>
<button class="btn btn-primary hover-btn-press">Press</button>
<button class="btn btn-primary hover-btn-glow">Glow</button>
<!-- hover-shimmer requires overflow:hidden -->
<button class="btn btn-outline hover-shimmer" style="position:relative;overflow:hidden">Shimmer</button>
`;

const specialEffectsCode = `
<div class="card hover-pulse">...</div>
<!-- hover-shimmer requires position:relative + overflow:hidden -->
<div class="card hover-shimmer" style="position:relative;overflow:hidden">...</div>
<div class="card hover-backdrop-blur">...</div>
<div class="card hover-gradient">...</div>
`;

const textLinkEffectsCode = `
<!-- Underline slides left→right -->
<a class="hover-underline-animated" href="#">About</a>

<!-- Underline expands from center -->
<a class="hover-underline-center" href="#">Contact</a>

<!-- Strikethrough line on hover -->
<a class="hover-strikethrough" href="#">Old price</a>

<!-- Text color changes -->
<a class="hover-primary" href="#">Link</a>
<a class="hover-accent" href="#">Link</a>
`;

const fillFromBottomCode = `
<!-- hover-fill — sliding fill from bottom -->
<div class="hover-fill">Fill Primary</div>
<div class="hover-fill hover-fill-accent">Fill Accent</div>
<div class="hover-fill hover-fill-success">Fill Success</div>

<!-- hover-primary-bg — instant color fill -->
<div class="hover-primary-bg">BG Fill</div>
<div class="hover-accent-bg">Accent BG</div>
<div class="hover-success-bg">Success BG</div>
<div class="hover-error-bg">Error BG</div>
`;

const u3DTiltHoverToSeePerspectiveCode = `
<!-- tilt left -->
<div class="card hover-tilt">...</div>

<!-- tilt right -->
<div class="card hover-tilt hover-tilt-r">...</div>
`;

const borderDrawLinesAnimateInOnHoverCode = `
<!-- border lines draw top+bottom on hover -->
<a class="hover-border-draw" href="#">Nav link</a>
<div class="card hover-border-draw">...</div>
<button class="btn btn-ghost hover-border-draw">...</button>
`;

const imageZoomHoverZoomCode = `
<!-- hover-zoom: overflow:hidden on parent, img scales inside -->
<div class="hover-zoom">
  <img src="photo.jpg" alt="">
</div>
<div class="hover-zoom-sm"><img ...></div>  <!-- scale(1.05) -->
<div class="hover-zoom-lg"><img ...></div>  <!-- scale(1.15) -->
<div class="hover-zoom-out"><img ...></div> <!-- scale(0.95) -->
`;

const filterEffectsCode = `
<!-- Filter effects (great for images) -->
<img class="hover-grayscale" src="...">  <!-- starts gray, hover reveals color -->
<img class="hover-sepia" src="...">
<img class="hover-invert" src="...">
<img class="hover-bright-strong" src="..."> <!-- brightness(1.3) -->
<img class="hover-dim" src="...">           <!-- brightness(0.85) -->
<img class="hover-blur" src="...">          <!-- blur(2px) on hover -->
`;
---

<section class="lib-section" id="hovers">
  <div class="lib-section-title">🎭 Hover Effects</div>
  <div class="lib-section-desc">
    From <code>_hovers.css</code>. Hover your mouse over elements.
  </div>

  <!-- Scale Effects -->
  <Demo is:raw label={'📏 Scale Effects'} code={scaleEffectsCode}>
      <div
        class="card-dark p-4 hover-scale-sm"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">🔲</div>
        <div class="text-xs">.hover-scale-sm</div>
        <div style="font-size:9px;color:var(--color-muted);margin-top:2px">
          scale(1.02)
        </div>
      </div>
      <div
        class="card-dark p-4 hover-scale"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">🔳</div>
        <div class="text-xs">.hover-scale</div>
        <div style="font-size:9px;color:var(--color-muted);margin-top:2px">
          scale(1.05)
        </div>
      </div>
      <div
        class="card-dark p-4 hover-scale-lg"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">⬛</div>
        <div class="text-xs">.hover-scale-lg</div>
        <div style="font-size:9px;color:var(--color-muted);margin-top:2px">
          scale(1.1)
        </div>
      </div>
      <div
        class="card-dark p-4 hover-scale-xl"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">🟫</div>
        <div class="text-xs">.hover-scale-xl</div>
        <div style="font-size:9px;color:var(--color-muted);margin-top:2px">
          scale(1.15)
        </div>
      </div>
    </Demo>

  <!-- Lift Effects -->
  <Demo is:raw label={'⬆️ Lift Effects (translateY)'} code={liftEffectsTranslateyCode}>
      <div
        class="card-dark p-4 hover-lift-sm"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">🪶</div>
        <div class="text-xs">.hover-lift-sm</div>
        <div style="font-size:9px;color:var(--color-muted);margin-top:2px">
          −2px
        </div>
      </div>
      <div
        class="card-dark p-4 hover-lift"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">🚀</div>
        <div class="text-xs">.hover-lift</div>
        <div style="font-size:9px;color:var(--color-muted);margin-top:2px">
          −4px
        </div>
      </div>
      <div
        class="card-dark p-4 hover-lift-lg"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">✈️</div>
        <div class="text-xs">.hover-lift-lg</div>
        <div style="font-size:9px;color:var(--color-muted);margin-top:2px">
          −8px
        </div>
      </div>
      <div
        class="card-dark p-4 hover-lift-xl"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">🛸</div>
        <div class="text-xs">.hover-lift-xl</div>
        <div style="font-size:9px;color:var(--color-muted);margin-top:2px">
          −12px
        </div>
      </div>
    </Demo>

  <!-- Glow Effects -->
  <Demo is:raw label={'✨ Glow Effects (box-shadow)'} code={glowEffectsBoxShadowCode}>
      <div
        class="card-dark p-4 hover-glow"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">💜</div>
        <div class="text-xs">.hover-glow</div>
      </div>
      <div
        class="card-dark p-4 hover-glow-accent"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">💙</div>
        <div class="text-xs">.hover-glow-accent</div>
      </div>
      <div
        class="card-dark p-4 hover-glow-success"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">💚</div>
        <div class="text-xs">.hover-glow-success</div>
      </div>
      <div
        class="card-dark p-4 hover-glow-error"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">❤️</div>
        <div class="text-xs">.hover-glow-error</div>
      </div>
      <div
        class="card-dark p-4 hover-glow-white"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">🤍</div>
        <div class="text-xs">.hover-glow-white</div>
      </div>
      <div
        class="card-dark p-4 hover-glow-intense"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">🔥</div>
        <div class="text-xs">.hover-glow-intense</div>
      </div>
    </Demo>

  <!-- Brightness & Filter -->
  <Demo is:raw label={'🌈 Brightness & Filter'} code={brightnessFilterCode}>
      <div
        class="card-dark p-4 hover-bright"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">☀️</div>
        <div class="text-xs">.hover-bright</div>
        <div style="font-size:9px;color:var(--color-muted);margin-top:2px">
          ×1.15
        </div>
      </div>
      <div
        class="card-dark p-4 hover-bright-strong"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">💡</div>
        <div class="text-xs">.hover-bright-strong</div>
        <div style="font-size:9px;color:var(--color-muted);margin-top:2px">
          ×1.3
        </div>
      </div>
      <div
        class="card-dark p-4 hover-dim"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">🌒</div>
        <div class="text-xs">.hover-dim</div>
        <div style="font-size:9px;color:var(--color-muted);margin-top:2px">
          ×0.85
        </div>
      </div>
      <div
        class="card-dark p-4 hover-dim-strong"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">🌑</div>
        <div class="text-xs">.hover-dim-strong</div>
        <div style="font-size:9px;color:var(--color-muted);margin-top:2px">
          ×0.7
        </div>
      </div>
      <div
        class="card-dark p-4 hover-grayscale"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">🖤</div>
        <div class="text-xs">.hover-grayscale</div>
      </div>
    </Demo>

  <!-- Opacity -->
  <Demo is:raw label={'👁️ Opacity Effects'} code={opacityEffectsCode}>
      <div
        class="card-dark p-4 hover-opacity-sm"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">🌫️</div>
        <div class="text-xs">.hover-opacity-sm</div>
        <div style="font-size:9px;color:var(--color-muted);margin-top:2px">
          0.9
        </div>
      </div>
      <div
        class="card-dark p-4 hover-opacity"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">🌁</div>
        <div class="text-xs">.hover-opacity</div>
        <div style="font-size:9px;color:var(--color-muted);margin-top:2px">
          0.8
        </div>
      </div>
      <div
        class="card-dark p-4 hover-opacity-lg"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">🌬️</div>
        <div class="text-xs">.hover-opacity-lg</div>
        <div style="font-size:9px;color:var(--color-muted);margin-top:2px">
          0.6
        </div>
      </div>
      <div
        class="card-dark p-4 hover-fade"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">👻</div>
        <div class="text-xs">.hover-fade</div>
        <div style="font-size:9px;color:var(--color-muted);margin-top:2px">
          0.7 + shrink
        </div>
      </div>
    </Demo>

  <!-- Border Effects -->
  <Demo is:raw label={'🔲 Border Effects'} code={borderEffectsCode}>
      <div
        class="card-dark p-4 hover-border"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">⬜</div>
        <div class="text-xs">.hover-border</div>
        <div style="font-size:9px;color:var(--color-muted);margin-top:2px">
          primary
        </div>
      </div>
      <div
        class="card-dark p-4 hover-border-accent"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">🔷</div>
        <div class="text-xs">.hover-border-accent</div>
        <div style="font-size:9px;color:var(--color-muted);margin-top:2px">
          accent
        </div>
      </div>
      <div
        class="card-dark p-4 hover-border-success"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">🟩</div>
        <div class="text-xs">.hover-border-success</div>
        <div style="font-size:9px;color:var(--color-muted);margin-top:2px">
          success
        </div>
      </div>
      <div
        class="card-dark p-4 hover-border-glow"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">🌟</div>
        <div class="text-xs">.hover-border-glow</div>
        <div style="font-size:9px;color:var(--color-muted);margin-top:2px">
          border + glow
        </div>
      </div>
    </Demo>

  <!-- Rotate Effects -->
  <Demo is:raw label={'🔄 Rotate Effects'} code={rotateEffectsCode}>
      <div
        class="card-dark p-4 hover-rotate"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">🔁</div>
        <div class="text-xs">.hover-rotate</div>
        <div style="font-size:9px;color:var(--color-muted);margin-top:2px">
          +5deg
        </div>
      </div>
      <div
        class="card-dark p-4 hover-rotate-neg"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">🔃</div>
        <div class="text-xs">.hover-rotate-neg</div>
        <div style="font-size:9px;color:var(--color-muted);margin-top:2px">
          −5deg
        </div>
      </div>
      <div
        class="card-dark p-4 hover-rotate-180"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">🔽</div>
        <div class="text-xs">.hover-rotate-180</div>
        <div style="font-size:9px;color:var(--color-muted);margin-top:2px">
          180deg
        </div>
      </div>
      <div
        class="card-dark p-4 hover-rotate-360"
        style="min-width:110px;text-align:center;cursor:pointer"
      >
        <div style="font-size:1.5rem;margin-bottom:6px">🌀</div>
        <div class="text-xs">.hover-rotate-360</div>
        <div style="font-size:9px;color:var(--color-muted);margin-top:2px">
          full spin
        </div>
      </div>
    </Demo>

  <!-- Card Combo Effects -->
  <Demo is:raw label={'🃏 Card Combo Effects'} code={cardComboEffectsCode}>
      <div
        class="card-dark p-4 hover-card"
        style="min-width:140px;text-align:center;cursor:pointer"
      >
        <div class="text-xs">.hover-card</div>
      </div>
      <div
        class="card-dark p-4 hover-card-glow"
        style="min-width:140px;text-align:center;cursor:pointer"
      >
        <div class="text-xs">.hover-card-glow</div>
      </div>
      <div
        class="card-dark p-4 hover-card-slide"
        style="min-width:140px;text-align:center;cursor:pointer"
      >
        <div class="text-xs">.hover-card-slide</div>
      </div>
      <div
        class="card-dark p-4 hover-mega"
        style="min-width:140px;text-align:center;cursor:pointer"
      >
        <div class="text-xs">.hover-mega</div>
      </div>
    </Demo>

  <!-- Button Effects -->
  <Demo is:raw label={'🔘 Button Effects'} code={buttonEffectsCode}>
      <button class="btn btn-primary hover-btn">.hover-btn</button>
      <button class="btn btn-primary hover-btn-press">.hover-btn-press</button>
      <button class="btn btn-primary hover-btn-glow">.hover-btn-glow</button>
      <button
        class="btn btn-outline hover-shimmer"
        style="position:relative;overflow:hidden">.hover-shimmer</button
      >
    </Demo>

  <!-- Special Effects -->
  <Demo is:raw label={'🎆 Special Effects'} code={specialEffectsCode}>
      <div
        class="card-dark p-4 hover-pulse"
        style="min-width:120px;text-align:center;cursor:pointer"
      >
        <div class="text-xs">.hover-pulse</div>
      </div>
      <div
        class="card-dark p-4 hover-shimmer"
        style="min-width:120px;text-align:center;cursor:pointer;position:relative;overflow:hidden"
      >
        <div class="text-xs">.hover-shimmer</div>
      </div>
      <div
        class="card-dark p-4 hover-backdrop-blur"
        style="min-width:120px;text-align:center;cursor:pointer"
      >
        <div class="text-xs">.hover-backdrop-blur</div>
      </div>
      <div
        class="card-dark p-4 hover-gradient"
        style="min-width:120px;text-align:center;cursor:pointer;background:linear-gradient(90deg, var(--color-primary), var(--color-accent))"
      >
        <div class="text-xs" style="color:#fff">.hover-gradient</div>
      </div>
    </Demo>

  <!-- Text / Link Effects -->
  <Demo is:raw label={'✏️ Text & Link Effects'} previewStyle="align-items:stretch" code={textLinkEffectsCode}>
      <!-- Animated underline left→right -->
      <div
        style="display:flex;flex-direction:column;gap:6px;align-items:flex-start;padding:16px 20px;background:var(--color-primary-opacity);border-radius:var(--radius-md);border:1px solid color-mix(in srgb,var(--color-neutral-600) 20%,transparent);min-width:220px"
      >
        <div
          style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--color-muted);margin-bottom:4px"
        >
          hover-underline-animated
        </div>
        <a
          href="#"
          class="hover-underline-animated"
          style="font-size:16px;font-weight:600;color:var(--color-light);text-decoration:none;padding-bottom:3px"
          >Hover me</a
        >
        <a
          href="#"
          class="hover-underline-animated"
          style="font-size:15px;color:var(--color-primary);text-decoration:none;padding-bottom:3px"
          >Products</a
        >
        <a
          href="#"
          class="hover-underline-animated"
          style="font-size:15px;color:var(--color-primary);text-decoration:none;padding-bottom:3px"
          >About us</a
        >
        <div style="font-size:10px;color:var(--color-muted);margin-top:4px">
          underline slides left → right
        </div>
      </div>

      <!-- Underline from center -->
      <div
        style="display:flex;flex-direction:column;gap:6px;align-items:flex-start;padding:16px 20px;background:var(--color-primary-opacity);border-radius:var(--radius-md);border:1px solid color-mix(in srgb,var(--color-neutral-600) 20%,transparent);min-width:220px"
      >
