---
import Demo from '../shared/Demo.astro';

const socialProofStripCode = `
<section class="section">
  <div class="container">
    <span class="tag tag-success">Trusted by builders</span>
    <h2 class="title-lg mt-3">A small CSS toolkit with real demos.</h2>
    <div class="grid grid-3 gap-4 mt-6">
      <article class="card-glass p-5"><strong>40+</strong><span>CodePen demos</span></article>
      <article class="card-glass p-5"><strong>9</strong><span>themes</span></article>
      <article class="card-glass p-5"><strong>0</strong><span>dependencies</span></article>
    </div>
  </div>
</section>
`;

const communityFollowBlockCode = `
<section class="section">
  <div class="container card-glass p-6">
    <span class="tag tag-primary">Community</span>
    <h2 class="title-lg mt-3">Follow the project and ship with us.</h2>
    <p class="text-muted">Use this block for footer pages, launch pages and docs home screens.</p>
    <ul class="social-list social-list-pills mt-6">
      <li><a href="#" data-net="github">GitHub</a></li>
      <li><a href="#" data-net="twitter">X / Twitter</a></li>
      <li><a href="#" data-net="telegram">Telegram</a></li>
    </ul>
  </div>
</section>
`;
---

<section class="lib-section" id="social-blocks">
    <div class="lib-section-title">🌐 Social Blocks</div>
    <div class="lib-section-desc">
        Ready social proof, community and follow sections.
    </div>

    <Demo is:raw label={'Social Proof Strip'} previewClass="social-block-preview" code={socialProofStripCode}>
            <section class="rs rs-proof">
                <div>
                    <span class="tag tag-success">Trusted by builders</span>
                    <h2 class="title-lg">A small CSS toolkit with real demos.</h2>
                </div>
                <div class="rs-proof-grid">
                    <article class="card-glass"><strong>40+</strong><span>CodePen demos</span></article>
                    <article class="card-glass"><strong>9</strong><span>themes</span></article>
                    <article class="card-glass"><strong>0</strong><span>dependencies</span></article>
                </div>
            </section>
        </Demo>

    <Demo is:raw label={'Community Follow Block'} previewClass="social-block-preview" code={communityFollowBlockCode}>
            <section class="rs rs-community">
                <div>
                    <span class="tag tag-primary">Community</span>
                    <h2 class="title-lg">Follow the project and ship with us.</h2>
                    <p class="text-muted">
                        Use this block for footer pages, launch pages and docs
                        home screens.
                    </p>
                </div>
                <ul class="social-list social-list-pills rs-social">
                    <li><a href="#" data-net="github">GitHub</a></li>
                    <li><a href="#" data-net="twitter">X / Twitter</a></li>
                    <li><a href="#" data-net="telegram">Telegram</a></li>
                    <li><a href="#" data-net="linkedin">LinkedIn</a></li>
                </ul>
            </section>
        </Demo>
</section>

<style is:global>
    .social-block-preview {
        display: block;
        padding: 0;
        overflow: hidden;
        background:
            radial-gradient(circle at 20% 0, color-mix(in srgb, var(--color-primary) 14%, transparent), transparent 26rem),
            var(--сolor-dark);
    }

    .rs {
        min-height: 360px;
        padding: clamp(24px, 5vw, 42px);
    }

    .rs h2 {
        max-width: 760px;
        margin: 14px 0 0;
    }

    .rs-proof-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        margin-top: 28px;
    }

    .rs-proof-grid article {
        display: grid;
        gap: 8px;
        min-height: 130px;
        padding: 20px;
        border-radius: var(--radius-lg);
    }

    .rs-proof-grid strong {
        font-size: 38px;
        line-height: 1;
    }

    .rs-proof-grid span {
        color: var(--color-muted);
    }

    .rs-community {
        display: grid;
        align-content: center;
        border: 1px solid color-mix(in srgb, var(--color-primary) 20%, transparent);
    }

    .rs-community p {
        max-width: 620px;
        margin: 16px 0 0;
        line-height: 1.6;
    }

    .rs-social {
        margin-top: 24px;
        flex-wrap: wrap;
    }

    @media (max-width: 760px) {
        .rs-proof-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
