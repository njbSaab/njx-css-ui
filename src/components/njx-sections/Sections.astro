<style is:global>
    .ready-page-preview {
        display: block;
        padding: 0;
        overflow: hidden;
        background:
            radial-gradient(
                circle at 12% 0,
                color-mix(in srgb, var(--color-primary) 16%, transparent),
                transparent 28rem
            ),
            radial-gradient(
                circle at 90% 14%,
                color-mix(in srgb, var(--color-accent) 10%, transparent),
                transparent 24rem
            ),
            var(--сolor-dark);
    }

    .rp-page {
        width: 100%;
        min-height: 420px;
        padding: clamp(22px, 4vw, 34px);
        color: var(--color-light);
    }

    .rp-page p {
        margin: 0;
        line-height: 1.6;
    }

    .rp-nav,
    .rp-dash-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .rp-nav > div,
    .rp-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .rp-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(240px, 0.75fr);
