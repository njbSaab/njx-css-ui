---

<section class="lib-section" id="sections">
    <div class="lib-section-title">🔲 Sections & Containers</div>
    <div class="lib-section-desc">
        From <code>_sections.css</code>. Containers and wrappers for layouts.
    </div>

    <Demo is:raw label={'Containers (container-*)'} previewClass="col" previewStyle="align-items:flex-start;gap:16px" code={containersContainerCode}>
            <div
                style="background:var(--color-primary);padding:16px;border-radius:8px;width:100%"
                class="flex-center"
            >
                <span class="text-sm"
                    >default .container (max-width: 1280px)</span
                >
            </div>
            <div
                style="background:var(--color-accent);padding:16px;border-radius:8px;width:100%"
                class="flex-center"
            >
                <span class="text-sm">.container-sm (max-width: 640px)</span>
            </div>
            <div
                style="background:var(--color-success);padding:16px;border-radius:8px;width:100%"
                class="flex-center"
            >
                <span class="text-sm">.container-md (max-width: 960px)</span>
            </div>
            <div
                style="background:var(--color-warning);padding:16px;border-radius:8px;width:100%"
                class="flex-center"
            >
                <span class="text-sm">.container-lg (max-width: 1200px)</span>
            </div>
            <div
                style="background:var(--color-error);padding:16px;border-radius:8px;width:100%"
                class="flex-center"
            >
                <span class="text-sm">.container-xl (max-width: 1400px)</span>
            </div>
            <div
                style="background:#888888;padding:16px;border-radius:8px;width:100%"
                class="flex-center"
            >
                <span class="text-sm">.container-fluid (100% width)</span>
            </div>
        </Demo>

    <Demo is:raw label={'Section (padding variants)'} previewClass="col" previewStyle="align-items:flex-start;gap:12px" code={sectionPaddingVariantsCode}>
            <div
                style="background:var(--lib-preview-bg);padding:24px;border-radius:8px;width:100%;border:2px dashed var(--lib-comp-brd)"
            >
                <span class="text-xs text-muted"
                    >.section (padding: 64px 0 by default)</span
                >
            </div>
            <div
                style="background:var(--lib-preview-bg);padding:24px;border-radius:8px;width:100%;border:2px dashed var(--lib-comp-brd)"
            >
                <span class="text-xs text-muted"
                    >.section-sm (padding: 32px 0)</span
                >
            </div>
            <div
                style="background:var(--lib-preview-bg);padding:24px;border-radius:8px;width:100%;border:2px dashed var(--lib-comp-brd)"
            >
                <span class="text-xs text-muted"
                    >.section-lg (padding: 96px 0)</span
                >
            </div>
        </Demo>

    <Demo is:raw label={'Section Banner (full-height hero)'} previewClass="col" previewStyle="align-items:center;justify-content:center;min-height:280px;background:radial-gradient(ellipse 70% 60% at 30% 20%, color-mix(in srgb, var(--color-primary) 26%, transparent), transparent), radial-gradient(ellipse 50% 50% at 80% 80%, color-mix(in srgb, var(--color-accent) 14%, transparent), transparent), var(--сolor-dark)" code={sectionBannerFullHeightHeroCode}>
            <div style="text-align:center;padding:24px">
                <span class="tag tag-primary">v2.0 is live</span>
                <div class="title-lg" style="margin:14px 0 10px">
                    Launch your product<br />with one CDN link
                </div>
                <div class="text-sm text-muted" style="max-width:420px;margin:0 auto 18px">
                    .section-banner — full-height opening screen
                    (min-height: 100dvh, background cover)
                </div>
                <div class="flex justify-center gap-3 flex-wrap">
                    <a class="btn btn-gradient btn-sm hover-lift" href="#">Get started →</a>
                    <a class="btn btn-outline btn-sm" href="#">See examples</a>
                </div>
            </div>
        </Demo>

    <Demo is:raw label={'Ready Page Block — SaaS Landing'} previewClass="ready-page-preview" code={readyPageBlockSaasLandingCode}>
            <section class="rp-page rp-landing">
                <nav class="rp-nav">
                    <strong>LaunchKit</strong>
                    <div>
                        <a class="link" href="#">Features</a>
                        <a class="link" href="#">Pricing</a>
                        <a class="btn btn-primary btn-sm" href="#">Start free</a>
                    </div>
                </nav>

                <div class="rp-hero">
                    <div>
                        <span class="tag tag-primary">New release</span>
                        <h3 class="title-lg">
                            Ship your next product page before lunch.
                        </h3>
                        <p class="text-muted">
                            Hero, feature cards, pricing and CTA blocks built
                            from njX UI primitives.
                        </p>
                        <div class="rp-actions">
                            <a class="btn btn-primary" href="#">Get started</a>
                            <a class="btn btn-outline" href="#">View docs</a>
                        </div>
                    </div>
                    <div class="card-gradient rp-metric-card">
                        <span class="text-xs">Conversion lift</span>
                        <strong>32%</strong>
                        <small>after moving to focused page sections</small>
                    </div>
                </div>

                <div class="rp-feature-grid">
                    <article class="card-glass">
                        <span class="rp-icon">01</span>
                        <strong>Fast setup</strong>
                        <p>Drop one stylesheet and compose sections.</p>
                    </article>
                    <article class="card-glass">
                        <span class="rp-icon">02</span>
                        <strong>Theme ready</strong>
                        <p>Works with all 9 built-in color themes.</p>
                    </article>
                    <article class="card-glass">
                        <span class="rp-icon">03</span>
                        <strong>No runtime</strong>
                        <p>CSS first blocks for static and Astro pages.</p>
                    </article>
                </div>
            </section>
        </Demo>

    <Demo is:raw label={'Ready Page Block — App Dashboard'} previewClass="ready-page-preview" code={readyPageBlockAppDashboardCode}>
            <section class="rp-page rp-dashboard">
                <aside class="rp-sidebar card-dark">
                    <strong>Orbit CRM</strong>
                    <a class="link" href="#">Overview</a>
                    <a class="link" href="#">Pipeline</a>
                    <a class="link" href="#">Reports</a>
                </aside>

                <div class="rp-dash-main">
                    <header class="rp-dash-head">
                        <div>
                            <span class="tag tag-success">Live</span>
                            <h3>Revenue overview</h3>
                        </div>
                        <button class="btn btn-primary btn-sm">Export</button>
                    </header>

                    <div class="rp-stat-grid">
                        <article class="card-bg-primary">
                            <span>MRR</span>
                            <strong>$42.8k</strong>
                        </article>
                        <article class="card-bg-success">
                            <span>Trials</span>
                            <strong>318</strong>
                        </article>
                        <article class="card-bg-warning">
                            <span>Churn risk</span>
                            <strong>2.4%</strong>
                        </article>
                    </div>

                    <div class="card-glass rp-table">
                        <div><strong>Acme Inc.</strong><span>$8,400</span></div>
                        <div><strong>Northwind</strong><span>$5,920</span></div>
                        <div><strong>Bluefin</strong><span>$3,180</span></div>
                    </div>
                </div>
            </section>
        </Demo>

    <Demo is:raw label={'Ready Page Block — Pricing + Contact'} previewClass="ready-page-preview" code={readyPageBlockPricingContactCode}>
            <section class="rp-page rp-pricing">
                <div class="rp-center">
                    <span class="tag tag-accent">Simple plans</span>
                    <h3 class="title-lg">Start small. Upgrade when needed.</h3>
                    <p class="text-muted">
                        Pricing, trust notes and a contact form in one ready
                        page composition.
                    </p>
                </div>

                <div class="rp-price-grid">
                    <article class="card-bordered rp-plan">
                        <span class="tag">Starter</span>
                        <strong>$0</strong>
                        <p>Docs, prototypes and quick pages.</p>
                        <button class="btn btn-outline">Use CDN</button>
                    </article>
                    <article class="card-glow rp-plan is-featured">
                        <span class="tag tag-primary">Pro</span>
                        <strong>$19</strong>
                        <p>Teams that ship multiple marketing pages.</p>
                        <button class="btn btn-primary">Start Pro</button>
                    </article>
                    <article class="card-bordered rp-plan">
                        <span class="tag tag-success">Open source</span>
                        <strong>MIT</strong>
                        <p>Fork, customize and build with the library.</p>
                        <button class="btn btn-outline-success">GitHub</button>
                    </article>
                </div>

                <form class="card-glass rp-form">
                    <input class="input" placeholder="Email address" />
                    <button class="btn btn-primary">Request demo</button>
                </form>
            </section>
        </Demo>

    <Demo is:raw label={'Wrappers & Lists'} previewClass="col" previewStyle="align-items:flex-start;gap:12px" code={wrappersListsCode}>
            <div
                style="background:var(--lib-preview-bg);padding:16px;border-radius:8px;width:100%;border:1px solid var(--lib-sep)"
            >
                <div class="text-xs text-muted" style="margin-bottom:8px">
                    .items-wrapper-col (flex column)
                </div>
                <div class="items-wrapper-col" style="gap:8px">
                    <div
                        style="background:var(--color-primary);padding:12px;border-radius:4px;color:#000"
                    >
                        Item 1
                    </div>
                    <div
                        style="background:var(--color-accent);padding:12px;border-radius:4px;color:#000"
                    >
                        Item 2
                    </div>
                </div>
            </div>
            <div
                style="background:var(--lib-preview-bg);padding:16px;border-radius:8px;width:100%;border:1px solid var(--lib-sep)"
            >
                <div class="text-xs text-muted" style="margin-bottom:8px">
                    .list-items-row (flex row)
                </div>
                <div class="list-items-row">
                    <div
                        style="background:var(--color-success);padding:12px 20px;border-radius:4px"
                    >
                        Item A
                    </div>
                    <div
                        style="background:var(--color-warning);padding:12px 20px;border-radius:4px"
                    >
                        Item B
                    </div>
                    <div
                        style="background:var(--color-error);padding:12px 20px;border-radius:4px"
                    >
                        Item C
                    </div>
                </div>
            </div>
        </Demo>

    <Demo is:raw label={'Social List — Default (Icon Buttons)'} previewStyle="justify-content:center" code={socialListDefaultIconButtonsCode}>
            <ul class="social-list">
                <li>
                    <a href="#" aria-label="GitHub" title="GitHub">
