---
import Demo from '../shared/Demo.astro';

const u12ColumnFlexGridRowColCode = `
<div class="row">
  <div class="col-6">50%</div>
  <div class="col-6">50%</div>
</div>
<div class="row">
  <div class="col-8">Main (66%)</div>
  <div class="col-4">Sidebar (33%)</div>
</div>
<div class="row">
  <div class="col-4">33%</div>
  <div class="col-4">33%</div>
  <div class="col-4">33%</div>
</div>
`;

const cssGridFixedColumnsGridCol1GridCol6Code = `
<!-- Fixed columns: 1–6 -->
<div class="grid-col-2 gap-4">...</div>
<div class="grid-col-3 gap-4">...</div>
<div class="grid-col-4 gap-4">...</div>
<div class="grid-col-5 gap-4">...</div>
<div class="grid-col-6 gap-4">...</div>

<!-- Responsive: collapses on mobile (< 600px → 1 col)
     and on tablet (600–899px: 4/5/6 → 2 cols) -->
`;

const cssGridAutoFitAdaptiveGridAutoCode = `
<!-- Auto-fit: fills as many cols as fit, wraps automatically -->
<div class="grid-auto-xs gap-2">…</div>  <!-- 100px min -->
<div class="grid-auto-sm gap-3">…</div>  <!-- 160px min -->
<div class="grid-auto-md gap-4">…</div>  <!-- 220px min -->
<div class="grid-auto-lg gap-4">…</div>  <!-- 300px min -->
<div class="grid-auto-xl gap-6">…</div>  <!-- 400px min -->
`;

const cssGridLayoutPresetsCode = `
<!-- Layout presets -->
<div class="grid-sidebar-l gap-4">
  <aside>Sidebar (260px)</aside>
  <main>Main content</main>
</div>

<div class="grid-sidebar-r gap-4">
  <main>Main content</main>
  <aside>Sidebar (260px)</aside>
</div>

<div class="grid-thirds gap-4">
  <div>Left (1fr)</div>
  <div>Main (2fr)</div>
  <div>Right (1fr)</div>
</div>
`;
---

<section class="lib-section" id="grid">
    <div class="lib-section-title">📏 Grid System</div>
    <div class="lib-section-desc">
        Two systems: classic 12-column (Flex) and modern CSS Grid. File <code>_grid.css</code>.
        Gap utilities (<code>.gap-2</code>, <code>.gap-4</code>…) are in <code>_utils.css</code>.
    </div>

    <!-- ── 12-Column Flex Grid ── -->
    <Demo is:raw label={'12-Column Flex Grid — <code>.row + .col-*</code>'} previewClass="col no-dot" previewStyle="gap:8px" code={u12ColumnFlexGridRowColCode}>
            <div class="row" style="width:100%">
                <div class="col-12" style="background:var(--color-primary);color:#000;padding:8px 10px;text-align:center;font-size:11px;font-weight:700;border-radius:4px">col-12</div>
            </div>
            <div class="row" style="width:100%">
                <div class="col-6" style="background:var(--color-primary);color:#000;padding:8px 10px;text-align:center;font-size:11px;font-weight:700;border-radius:4px">col-6</div>
                <div class="col-6" style="background:var(--color-primary);color:#000;padding:8px 10px;text-align:center;font-size:11px;font-weight:700;border-radius:4px">col-6</div>
            </div>
            <div class="row" style="width:100%">
                <div class="col-4" style="background:var(--color-primary);color:#000;padding:8px 10px;text-align:center;font-size:11px;font-weight:700;border-radius:4px">col-4</div>
                <div class="col-4" style="background:var(--color-primary);color:#000;padding:8px 10px;text-align:center;font-size:11px;font-weight:700;border-radius:4px">col-4</div>
                <div class="col-4" style="background:var(--color-primary);color:#000;padding:8px 10px;text-align:center;font-size:11px;font-weight:700;border-radius:4px">col-4</div>
            </div>
            <div class="row" style="width:100%">
                <div class="col-8" style="background:var(--color-primary);color:#000;padding:8px 10px;text-align:center;font-size:11px;font-weight:700;border-radius:4px">col-8 · Main</div>
                <div class="col-4" style="background:rgba(var(--color-primary-rgb,20,160,255),0.5);color:#fff;padding:8px 10px;text-align:center;font-size:11px;font-weight:700;border-radius:4px">col-4 · Sidebar</div>
            </div>
            <div class="row" style="width:100%">
                <div class="col-3" style="background:var(--color-primary);color:#000;padding:8px 10px;text-align:center;font-size:11px;font-weight:700;border-radius:4px">col-3</div>
                <div class="col-3" style="background:var(--color-primary);color:#000;padding:8px 10px;text-align:center;font-size:11px;font-weight:700;border-radius:4px">col-3</div>
                <div class="col-3" style="background:var(--color-primary);color:#000;padding:8px 10px;text-align:center;font-size:11px;font-weight:700;border-radius:4px">col-3</div>
                <div class="col-3" style="background:var(--color-primary);color:#000;padding:8px 10px;text-align:center;font-size:11px;font-weight:700;border-radius:4px">col-3</div>
            </div>
        </Demo>

    <!-- ── CSS Grid: Fixed Columns ── -->
    <Demo is:raw label={'CSS Grid — Fixed Columns <code>.grid-col-1</code> … <code>.grid-col-6</code>'} previewClass="col no-dot" previewStyle="gap:12px" code={cssGridFixedColumnsGridCol1GridCol6Code}>

            <!-- 2 cols -->
            <div class="grid-col-label">2 columns — <code>.grid-col-2</code></div>
            <div class="grid-col-2 gap-3" style="width:100%">
                <div class="grid-demo-cell">1</div>
                <div class="grid-demo-cell">2</div>
            </div>

            <!-- 3 cols -->
            <div class="grid-col-label">3 columns — <code>.grid-col-3</code></div>
            <div class="grid-col-3 gap-3" style="width:100%">
                <div class="grid-demo-cell">1</div>
                <div class="grid-demo-cell">2</div>
                <div class="grid-demo-cell">3</div>
            </div>

            <!-- 4 cols -->
            <div class="grid-col-label">4 columns — <code>.grid-col-4</code></div>
            <div class="grid-col-4 gap-3" style="width:100%">
                <div class="grid-demo-cell">1</div>
                <div class="grid-demo-cell">2</div>
                <div class="grid-demo-cell">3</div>
                <div class="grid-demo-cell">4</div>
            </div>

            <!-- 5 cols -->
            <div class="grid-col-label">5 columns — <code>.grid-col-5</code></div>
            <div class="grid-col-5 gap-3" style="width:100%">
                <div class="grid-demo-cell">1</div>
                <div class="grid-demo-cell">2</div>
                <div class="grid-demo-cell">3</div>
                <div class="grid-demo-cell">4</div>
                <div class="grid-demo-cell">5</div>
            </div>

            <!-- 6 cols -->
            <div class="grid-col-label">6 columns — <code>.grid-col-6</code></div>
            <div class="grid-col-6 gap-3" style="width:100%">
                <div class="grid-demo-cell">1</div>
                <div class="grid-demo-cell">2</div>
                <div class="grid-demo-cell">3</div>
                <div class="grid-demo-cell">4</div>
                <div class="grid-demo-cell">5</div>
                <div class="grid-demo-cell">6</div>
            </div>
        </Demo>

    <!-- ── Auto-fit (Adaptive) ── -->
    <Demo is:raw label={'CSS Grid — Auto-fit Adaptive <code>.grid-auto-*</code>'} previewClass="col no-dot" previewStyle="gap:12px" code={cssGridAutoFitAdaptiveGridAutoCode}>

            <div class="grid-col-label"><code>.grid-auto-xs</code> — minmax(100px, 1fr)</div>
            <div class="grid-auto-xs gap-2" style="width:100%">
                <div class="grid-demo-cell-sm">A</div>
                <div class="grid-demo-cell-sm">B</div>
                <div class="grid-demo-cell-sm">C</div>
                <div class="grid-demo-cell-sm">D</div>
                <div class="grid-demo-cell-sm">E</div>
                <div class="grid-demo-cell-sm">F</div>
                <div class="grid-demo-cell-sm">G</div>
                <div class="grid-demo-cell-sm">H</div>
            </div>

            <div class="grid-col-label"><code>.grid-auto-sm</code> — minmax(160px, 1fr)</div>
            <div class="grid-auto-sm gap-3" style="width:100%">
                <div class="grid-demo-cell-sm">Card 1</div>
                <div class="grid-demo-cell-sm">Card 2</div>
                <div class="grid-demo-cell-sm">Card 3</div>
                <div class="grid-demo-cell-sm">Card 4</div>
                <div class="grid-demo-cell-sm">Card 5</div>
            </div>

            <div class="grid-col-label"><code>.grid-auto-md</code> — minmax(220px, 1fr)</div>
            <div class="grid-auto-md gap-3" style="width:100%">
                <div class="grid-demo-cell">Card A</div>
                <div class="grid-demo-cell">Card B</div>
                <div class="grid-demo-cell">Card C</div>
                <div class="grid-demo-cell">Card D</div>
            </div>

            <div class="grid-col-label"><code>.grid-auto-lg</code> — minmax(300px, 1fr)</div>
            <div class="grid-auto-lg gap-4" style="width:100%">
                <div class="grid-demo-cell">Wide Card 1</div>
                <div class="grid-demo-cell">Wide Card 2</div>
                <div class="grid-demo-cell">Wide Card 3</div>
            </div>

        </Demo>

    <!-- ── Layout Presets ── -->
    <Demo is:raw label={'CSS Grid — Layout Presets'} previewClass="col no-dot" previewStyle="gap:12px" code={cssGridLayoutPresetsCode}>

            <div class="grid-col-label"><code>.grid-sidebar-l</code> — 260px | 1fr</div>
            <div class="grid-sidebar-l gap-3" style="width:100%">
                <div class="grid-demo-cell" style="background:color-mix(in srgb,var(--color-accent) 25%,transparent)">Sidebar</div>
                <div class="grid-demo-cell">Main Content</div>
            </div>

            <div class="grid-col-label"><code>.grid-sidebar-r</code> — 1fr | 260px</div>
            <div class="grid-sidebar-r gap-3" style="width:100%">
                <div class="grid-demo-cell">Main Content</div>
                <div class="grid-demo-cell" style="background:color-mix(in srgb,var(--color-accent) 25%,transparent)">Sidebar</div>
            </div>

            <div class="grid-col-label"><code>.grid-thirds</code> — 1fr | 2fr | 1fr</div>
            <div class="grid-thirds gap-3" style="width:100%">
                <div class="grid-demo-cell" style="background:color-mix(in srgb,var(--color-accent) 25%,transparent)">Left</div>
                <div class="grid-demo-cell">Main</div>
                <div class="grid-demo-cell" style="background:color-mix(in srgb,var(--color-accent) 25%,transparent)">Right</div>
            </div>

        </Demo>

</section>

<style is:global>
    .grid-col-label {
        font-size: 11px;
        color: var(--color-muted);
        margin-top: 4px;
        margin-bottom: 2px;
    }
    .grid-demo-cell {
        background: color-mix(in srgb, var(--color-primary) 18%, transparent);
        color: var(--color-primary);
        border: 1px solid color-mix(in srgb, var(--color-primary) 30%, transparent);
        padding: 14px 10px;
        text-align: center;
        font-size: 12px;
        font-weight: 700;
        border-radius: 6px;
    }
    .grid-demo-cell-sm {
        background: color-mix(in srgb, var(--color-accent) 18%, transparent);
        color: var(--color-accent);
        border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
        padding: 10px 6px;
        text-align: center;
        font-size: 11px;
        font-weight: 700;
        border-radius: 6px;
    }
</style>
