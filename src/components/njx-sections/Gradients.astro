---
import Demo from '../shared/Demo.astro';

const backgroundGradientsMainCode = `
<!-- _gradients.css — background gradients -->
<div class="gradient-primary">...</div>
<div class="gradient-primary-light">...</div>
<div class="gradient-accent">...</div>
<div class="gradient-success">...</div>
`;

const backgroundGradientsCombinedCode = `
<!-- _gradients.css — combined -->
<div class="gradient-blue-purple">...</div>
<div class="gradient-ocean">...</div>
<div class="gradient-sunset">...</div>
<div class="gradient-nature">...</div>
<div class="gradient-gold">...</div>
<div class="gradient-cosmic">...</div>
`;

const backgroundGradientsDarkCode = `
<!-- _gradients.css — dark gradients -->
<div class="gradient-dark-midnight">...</div>
<div class="gradient-dark-void">...</div>
<div class="gradient-dark-blue">...</div>
<div class="gradient-dark-purple">...</div>
`;

const textGradientsCode = `
<!-- _gradients.css — gradient text (background-clip: text) -->
<h1 class="text-gradient-primary">Primary</h1>
<h1 class="text-gradient-accent">Accent</h1>
<h1 class="text-gradient-blue-purple">Blue Purple</h1>
<h1 class="text-gradient-sunset">Sunset</h1>
<h1 class="text-gradient-ocean">Ocean</h1>
<h1 class="text-gradient-gold">Gold</h1>
<h1 class="text-gradient-cosmic">Cosmic</h1>
<h1 class="text-gradient-rainbow">Rainbow</h1>
`;

const gradientBordersCode = `
<!-- _gradients.css — gradient borders (via mask + padding) -->
<div class="border-gradient-primary">...</div>
<div class="border-gradient-accent">...</div>
<div class="border-gradient-rainbow">...</div>
<div class="border-gradient-gold">...</div>
`;

const animatedGradientsCode = `
<!-- _gradients.css — animated gradients (background-size: 200%) -->
<div class="gradient-animated">Bright animated</div>
<div class="gradient-animated-subtle">Soft animated</div>
`;

const gradientOverlaysCode = `
<!-- _gradients.css — gradient overlays (::before pseudo) -->
<!-- Element must have position:relative -->
<div class="gradient-overlay-dark" style="position:relative">
  <img src="bg.jpg" />
  <div style="position:relative;z-index:1">Text above</div>
</div>
<div class="gradient-overlay-primary" style="position:relative">...</div>
`;

const conicGradientsCode = `
<!-- _gradients.css — conic gradients -->
<div class="gradient-conic">...</div>
<div class="gradient-conic-warm">...</div>
<div class="gradient-conic-cool">...</div>
<div class="gradient-conic-pie">...</div>
`;

const meshGradientsCode = `
<!-- _gradients.css — mesh (multi-point radial gradients) -->
<div class="gradient-mesh">...</div>
<div class="gradient-mesh-warm">...</div>
<div class="gradient-mesh-cool">...</div>
`;

const shimmerSkeletonLoaderCode = `
<!-- .gradient-shimmer — animated skeleton loader -->
<div class="gradient-shimmer" style="height:20px;border-radius:4px"></div>
<div class="gradient-shimmer" style="height:80px;border-radius:8px"></div>
`;

const utilityDirectionRadialCode = `
<!-- Utility classes with CSS vars --gradient-from / --gradient-to -->
<div class="gradient-horizontal" style="--gradient-from:#f9063f;--gradient-to:#667eea">...</div>
<div class="gradient-vertical" style="--gradient-from:#f9063f;--gradient-to:#667eea">...</div>
<div class="gradient-diagonal" style="--gradient-from:#f9063f;--gradient-to:#667eea">...</div>
<div class="gradient-radial" style="--gradient-from:#f9063f;--gradient-to:transparent">...</div>
`;
---

<section class="lib-section" id="gradients">
    <div class="lib-section-title">🌈 Gradients</div>
    <div class="lib-section-desc">
        From <code>_gradients.css</code>. Ready-made gradients for background
        and text.
    </div>

    <!-- Background Gradients Primary -->
    <Demo is:raw label={'🎨 Background Gradients — Main'} code={backgroundGradientsMainCode}>
            <div
                class="gradient-primary p-4 rounded-lg"
                style="min-width:120px;text-align:center;color:#fff;font-weight:700"
            >
                .gradient-primary
            </div>
            <div
                class="gradient-primary-light p-4 rounded-lg"
                style="min-width:120px;text-align:center;color:#111;font-weight:700"
            >
                .gradient-primary-light
            </div>
            <div
                class="gradient-primary-dark p-4 rounded-lg"
                style="min-width:120px;text-align:center;color:#fff;font-weight:700"
            >
                .gradient-primary-dark
            </div>
            <div
                class="gradient-primary-vertical p-4 rounded-lg"
                style="min-width:120px;text-align:center;color:#fff;font-weight:700"
            >
                .gradient-primary-vertical
            </div>
            <div
                class="gradient-accent p-4 rounded-lg"
                style="min-width:120px;text-align:center;color:#fff;font-weight:700"
            >
                .gradient-accent
            </div>
            <div
                class="gradient-success p-4 rounded-lg"
                style="min-width:120px;text-align:center;color:#fff;font-weight:700"
            >
                .gradient-success
            </div>
            <div
                class="gradient-error p-4 rounded-lg"
                style="min-width:120px;text-align:center;color:#fff;font-weight:700"
            >
                .gradient-error
            </div>
            <div
                class="gradient-warning p-4 rounded-lg"
                style="min-width:120px;text-align:center;color:#111;font-weight:700"
            >
                .gradient-warning
            </div>
        </Demo>

    <!-- Background Gradients Combinations -->
    <Demo is:raw label={'🌈 Background Gradients — Combined'} code={backgroundGradientsCombinedCode}>
            <div
                class="gradient-blue-purple p-4 rounded-lg"
                style="min-width:120px;text-align:center;color:#fff;font-weight:700"
            >
                .gradient-blue-purple
            </div>
            <div
                class="gradient-ocean p-4 rounded-lg"
                style="min-width:120px;text-align:center;color:#fff;font-weight:700"
            >
                .gradient-ocean
            </div>
            <div
                class="gradient-sunset p-4 rounded-lg"
                style="min-width:120px;text-align:center;color:#fff;font-weight:700"
            >
                .gradient-sunset
            </div>
            <div
                class="gradient-nature p-4 rounded-lg"
                style="min-width:120px;text-align:center;color:#fff;font-weight:700"
            >
                .gradient-nature
            </div>
            <div
                class="gradient-gold p-4 rounded-lg"
                style="min-width:120px;text-align:center;color:#fff;font-weight:700"
            >
                .gradient-gold
            </div>
            <div
                class="gradient-cosmic p-4 rounded-lg"
                style="min-width:120px;text-align:center;color:#fff;font-weight:700"
            >
                .gradient-cosmic
            </div>
        </Demo>

    <!-- Background Gradients Dark -->
    <Demo is:raw label={'🌑 Background Gradients — Dark'} code={backgroundGradientsDarkCode}>
            <div
                class="gradient-dark-midnight p-4 rounded-lg"
                style="min-width:120px;text-align:center;color:#fff;font-weight:700"
            >
                .gradient-dark-midnight
            </div>
            <div
                class="gradient-dark-void p-4 rounded-lg"
                style="min-width:120px;text-align:center;color:#fff;font-weight:700"
            >
                .gradient-dark-void
            </div>
            <div
                class="gradient-dark-blue p-4 rounded-lg"
                style="min-width:120px;text-align:center;color:#fff;font-weight:700"
            >
                .gradient-dark-blue
            </div>
            <div
                class="gradient-dark-purple p-4 rounded-lg"
                style="min-width:120px;text-align:center;color:#fff;font-weight:700"
            >
                .gradient-dark-purple
            </div>
        </Demo>

    <!-- Text Gradients -->
    <Demo is:raw label={'✏️ Text Gradients'} previewClass="col" previewStyle="align-items:flex-start;gap:20px" code={textGradientsCode}>
            <h2 class="text-gradient-primary" style="margin:0;font-size:36px">
                .text-gradient-primary
            </h2>
            <h2 class="text-gradient-accent" style="margin:0;font-size:36px">
                .text-gradient-accent
            </h2>
            <h2
                class="text-gradient-blue-purple"
                style="margin:0;font-size:36px"
            >
                .text-gradient-blue-purple
            </h2>
            <h2 class="text-gradient-sunset" style="margin:0;font-size:36px">
                .text-gradient-sunset
            </h2>
            <h2 class="text-gradient-ocean" style="margin:0;font-size:36px">
                .text-gradient-ocean
            </h2>
            <h2 class="text-gradient-gold" style="margin:0;font-size:36px">
                .text-gradient-gold
            </h2>
            <h2 class="text-gradient-cosmic" style="margin:0;font-size:36px">
                .text-gradient-cosmic
            </h2>
            <h2 class="text-gradient-rainbow" style="margin:0;font-size:36px">
                .text-gradient-rainbow
            </h2>
        </Demo>

    <!-- Gradient Borders -->
    <Demo is:raw label={'🔲 Gradient Borders'} code={gradientBordersCode}>
            <div
                class="border-gradient-primary p-4 rounded-lg"
                style="min-width:140px;text-align:center;"
            >
                <div style="color:var(--color-muted);font-size:12px">
                    .border-gradient-primary
                </div>
            </div>
            <div
                class="border-gradient-accent p-4 rounded-lg"
                style="min-width:140px;text-align:center;"
            >
                <div style="color:var(--color-muted);font-size:12px">
                    .border-gradient-accent
                </div>
            </div>
            <div
                class="border-gradient-rainbow p-4 rounded-lg"
                style="min-width:140px;text-align:center;"
            >
                <div style="color:var(--color-muted);font-size:12px">
                    .border-gradient-rainbow
                </div>
            </div>
            <div
                class="border-gradient-gold p-4 rounded-lg"
                style="min-width:140px;text-align:center;"
            >
                <div style="color:var(--color-muted);font-size:12px">
                    .border-gradient-gold
                </div>
            </div>
        </Demo>

    <!-- Animated Gradients -->
    <Demo is:raw label={'✨ Animated Gradients'} code={animatedGradientsCode}>
            <div
                class="gradient-animated p-4 rounded-lg"
                style="min-width:160px;text-align:center;color:#fff;font-weight:700"
            >
                .gradient-animated
            </div>
            <div
                class="gradient-animated-subtle p-4 rounded-lg"
                style="min-width:160px;text-align:center;color:var(--color-light);font-weight:700"
            >
                .gradient-animated-subtle
            </div>
        </Demo>

    <!-- Gradient Overlays -->
    <Demo is:raw label={'🎭 Gradient Overlays'} previewClass="col" previewStyle="align-items:stretch;gap:20px" code={gradientOverlaysCode}>
            <div
                class="gradient-overlay-dark p-6 rounded-lg"
                style="background:url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22100%22 height=%22100%22><rect fill=%22%23333%22 width=%22100%22 height=%22100%22/></svg>');min-height:120px;position:relative"
            >
                <div
                    style="position:relative;z-index:1;color:#fff;font-weight:700"
                >
                    .gradient-overlay-dark
                </div>
            </div>
            <div
                class="gradient-overlay-primary p-6 rounded-lg"
                style="background:var(--color-dark-secondary);min-height:120px;position:relative"
            >
                <div
                    style="position:relative;z-index:1;color:var(--color-light);font-weight:700"
                >
                    .gradient-overlay-primary
                </div>
            </div>
        </Demo>

    <!-- Conic Gradients -->
    <Demo is:raw label={'🌀 Conic Gradients'} code={conicGradientsCode}>
            <div
                class="gradient-conic p-4 rounded-lg"
                style="min-width:120px;height:120px;border-radius:50%;text-align:center;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:11px"
            >
                .gradient-conic
            </div>
            <div
                class="gradient-conic-warm p-4 rounded-lg"
                style="min-width:120px;height:120px;border-radius:50%;text-align:center;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:11px"
            >
                .conic-warm
            </div>
            <div
                class="gradient-conic-cool p-4 rounded-lg"
                style="min-width:120px;height:120px;border-radius:50%;text-align:center;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:11px"
            >
                .conic-cool
            </div>
            <div
                class="gradient-conic-pie rounded-lg"
                style="width:120px;height:120px;border-radius:50%"
            >
            </div>
        </Demo>

    <!-- Mesh Gradients -->
    <Demo is:raw label={'🕸 Mesh Gradients'} code={meshGradientsCode}>
            <div
                class="gradient-mesh p-6 rounded-lg"
                style="min-width:160px;min-height:100px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:12px;color:var(--color-light)"
            >
                .gradient-mesh
            </div>
            <div
                class="gradient-mesh-warm p-6 rounded-lg"
                style="min-width:160px;min-height:100px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:12px;color:#fff"
            >
                .gradient-mesh-warm
            </div>
            <div
                class="gradient-mesh-cool p-6 rounded-lg"
                style="min-width:160px;min-height:100px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:12px;color:#fff"
            >
                .gradient-mesh-cool
            </div>
        </Demo>

    <!-- Shimmer skeleton -->
    <Demo is:raw label={'💀 Shimmer / Skeleton Loader'} previewClass="col" previewStyle="align-items:stretch;gap:10px" code={shimmerSkeletonLoaderCode}>
            <div
                class="gradient-shimmer rounded-md"
                style="height:20px;max-width:300px"
            >
            </div>
            <div
                class="gradient-shimmer rounded-md"
                style="height:20px;max-width:200px"
            >
            </div>
            <div
                class="gradient-shimmer rounded-md"
                style="height:80px;max-width:300px;border-radius:8px"
            >
            </div>
        </Demo>

    <!-- Utility: direction & radial -->
    <Demo is:raw label={'📐 Utility — direction & radial'} code={utilityDirectionRadialCode}>
            <div
                class="gradient-horizontal p-4 rounded-lg"
                style="--gradient-from:var(--color-primary);--gradient-to:var(--color-accent);min-width:130px;text-align:center;color:#fff;font-weight:700;font-size:12px"
            >
                .gradient-horizontal
            </div>
            <div
                class="gradient-vertical p-4 rounded-lg"
                style="--gradient-from:var(--color-primary);--gradient-to:var(--color-accent);min-width:130px;text-align:center;color:#fff;font-weight:700;font-size:12px"
            >
                .gradient-vertical
            </div>
            <div
                class="gradient-diagonal p-4 rounded-lg"
                style="--gradient-from:#f9063f;--gradient-to:#667eea;min-width:130px;text-align:center;color:#fff;font-weight:700;font-size:12px"
            >
                .gradient-diagonal
            </div>
            <div
                class="gradient-radial p-4 rounded-lg"
                style="--gradient-from:var(--color-accent);--gradient-to:var(--color-dark-secondary);min-width:130px;text-align:center;color:#fff;font-weight:700;font-size:12px"
            >
                .gradient-radial
            </div>
        </Demo>
</section>
