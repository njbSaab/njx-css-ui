---
import CodeBlock from '../shared/CodeBlock.astro';
import { CDN_BASE, CDN_JS } from '../../lib/meta';

const base = import.meta.env.BASE_URL;
const qsLinkFull = `
<link rel="stylesheet" href="${CDN_BASE}style.min.css">
`;
const qsLinkInteractive = `
<link rel="stylesheet" href="${CDN_BASE}style.min.css">

<!-- Option A — Alpine.js: your state, njX classes -->
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3/dist/cdn.min.js"></script>

<!-- Option B — njx.js: zero-config helpers -->
<script src="${CDN_JS}"></script>
`;
const qsAlpineTaste = `
<!-- Same njX classes — Alpine just toggles .is-open -->
<div class="collapse" x-data="{ open: false }" :class="{ 'is-open': open }">
  <div class="collapse-header" @click="open = !open">
    FAQ item <span class="collapse-icon"></span>
  </div>
  <div class="collapse-body">Answer</div>
</div>
`;
const qsAstroImport = `
---
// src/layouts/Layout.astro
import 'njx-ui/css/style.min.css';
---
`;
const qsBoilerplateAstro = `
---
// src/layouts/Layout.astro
import 'njx-ui/css/style.min.css';
---
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <title>My App</title>
</head>
<body>

  <button class="btn btn-primary">Get Started</button>

  <div class="card-glow">
    <h2 class="text-gradient-primary">Hello njX</h2>
    <p class="text-muted">Astro + njX UI — zero JS shipped.</p>
  </div>

  <slot />

</body>
</html>
`;
const qsTheme = `
<html lang="en" data-theme="dark">
<!-- dark · light · red · blue · green · cyan · yellow · pink · purple -->
`;
const qsClassesFull = `
<button class="btn btn-primary">Click me</button>
<div class="card">A styled card</div>
<span class="tag tag-primary">Badge</span>
`;
const qsBoilerplateFull = `
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet"
        href="${CDN_BASE}style.min.css">
  <title>My App</title>
</head>
<body>

  <button class="btn btn-primary">Get Started</button>

  <div class="card-glow">
    <h2 class="text-gradient-primary">Hello njX</h2>
    <p class="text-muted">Built in 30 seconds.</p>
  </div>

</body>
</html>
`;
---

  <!-- ══════════════════════ FROM ZERO ══════════════════════ -->
  <div class="sc-section" style="padding-top:48px;padding-bottom:48px">
    <span class="sc-eyebrow">Your first page</span>
    <h2 class="sc-heading">From zero to styled<br />in 3 steps</h2>
    <div class="sc-two-col" style="margin-top:24px;align-items:stretch">
      <div class="sc-steps">
        <div class="sc-step">
          <div class="sc-step-left">
            <div class="sc-step-num">1</div>
            <div class="sc-step-line"></div>
          </div>
          <div class="sc-step-body">
            <div class="sc-step-title">Connect the stylesheet</div>
            <div data-qs-mode="full">
              <div class="sc-step-desc">
                One <code>&lt;link&gt;</code> tag inside <code>&lt;head&gt;</code
                >. No JavaScript, no build step, nothing else required.
              </div>
              <CodeBlock frame="sc" compact style="margin-top:10px" code={qsLinkFull} />
            </div>
            <div data-qs-mode="interactive" style="display:none">
              <div class="sc-step-desc">
                Stylesheet plus a driver: <strong>Alpine.js</strong> or
                <strong>njx.js</strong> — both toggle the same state classes.
              </div>
              <CodeBlock frame="sc" compact style="margin-top:10px" code={qsLinkInteractive} />
            </div>
            <div data-qs-mode="astro" style="display:none">
              <div class="sc-step-desc">
                One import in your Layout — Astro bundles the CSS
                automatically. No integration needed.
              </div>
              <CodeBlock frame="sc" compact lang="js" style="margin-top:10px" code={qsAstroImport} />
            </div>
          </div>
        </div>
        <div class="sc-step">
          <div class="sc-step-left">
            <div class="sc-step-num">2</div>
            <div class="sc-step-line"></div>
          </div>
          <div class="sc-step-body">
            <div class="sc-step-title">Pick a theme</div>
            <div class="sc-step-desc">
              Set <code>data-theme</code> on the <code>&lt;html&gt;</code> element.
              Every component adapts automatically — no extra CSS needed.
            </div>
            <CodeBlock frame="sc" compact style="margin-top:10px" code={qsTheme} />
          </div>
        </div>
        <div class="sc-step">
          <div class="sc-step-left">
            <div class="sc-step-num">3</div>
          </div>
          <div class="sc-step-body">
            <div class="sc-step-title">Use component classes</div>
            <div class="sc-step-desc">
              Add classes like <code>btn btn-primary</code> or <code>card</code
              >. That's the whole API — just class names on HTML elements.
            </div>
            <CodeBlock frame="sc" compact style="margin-top:10px" code={qsClassesFull} />
          </div>
        </div>
        <!-- Step 4: Interactive only — Alpine taste -->
        <div class="sc-step" data-qs-mode="interactive" style="display:none">
          <div class="sc-step-left">
            <div class="sc-step-num">4</div>
          </div>
          <div class="sc-step-body">
            <div class="sc-step-title">Bring it to life</div>
            <div class="sc-step-desc">
              With Alpine the state lives in the markup — full recipe set in the
              <a href={`${base}documentation#alpine`} style="color:var(--color-primary)">Alpine.js section</a> of the docs.
            </div>
            <CodeBlock frame="sc" compact style="margin-top:10px" code={qsAlpineTaste} />
          </div>
        </div>
      </div>
      <div style="display:flex;flex-direction:column">
        <div
          style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--color-muted);margin-bottom:12px"
        >
          Complete boilerplate
        </div>
        <div data-qs-mode="full interactive" style="flex:1;display:flex;flex-direction:column">
          <CodeBlock frame="sc" class="qs-bp" label="index.html" style="flex:1;display:flex;flex-direction:column" code={qsBoilerplateFull} />
        </div>
        <div data-qs-mode="astro" style="flex:1;display:none;flex-direction:column">
          <CodeBlock frame="sc" class="qs-bp" lang="js" label="Layout.astro" style="flex:1;display:flex;flex-direction:column" code={qsBoilerplateAstro} />
        </div>
      </div>
    </div>
  </div>
