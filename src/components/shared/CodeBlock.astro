---
import { dedent, escapeHtml, highlightHtml, highlightCss } from './code-utils.js';

interface Props {
    code: string;
    lang?: string;
    filename?: string;
    compact?: boolean;
    class?: string;
}

const {
    code,
    lang = 'html',
    filename,
    compact = false,
    class: className = '',
} = Astro.props;

const normalizedCode = dedent(code).trim();

const highlightedCode =
    lang === 'html'
        ? highlightHtml(normalizedCode)
        : lang === 'css'
          ? highlightCss(normalizedCode)
          : escapeHtml(normalizedCode);
---

<div
    class={`lib-code-wrapper ${compact ? 'is-compact' : ''} ${className}`}
    data-code-block
>
    <div class="lib-code-container">
        <div
            class="lib-code"
            data-raw={normalizedCode}
            data-code-filename={filename}
        >
            <pre class={`codeblock-pre language-${lang}`}><code set:html={highlightedCode} /></pre>
        </div>
    </div>
</div>

<style is:global>
    .lib-code .codeblock-pre {
        margin: 0;
        padding: 0;
        background: transparent !important;
        border: 0;
        white-space: pre;
        overflow-x: auto;
    }

    .lib-code .codeblock-pre code {
        display: block;
        background: transparent;
        font-family: inherit;
        font-size: inherit;
        line-height: inherit;
    }
</style>
