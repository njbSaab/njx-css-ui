---
import CodeBlock from '../shared/CodeBlock.astro';
import { CDN_BASE, CDN_JS } from '../../lib/meta';

const base = import.meta.env.BASE_URL;
const qsFullLink = `
<link rel="stylesheet" href="${CDN_BASE}style.min.css">
`;
const qsFullTheme = `
<html lang="en" data-theme="dark">
<!-- dark · light · red · blue · green · cyan · yellow · pink · purple -->
`;
const qsFullPage = `
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <link rel="stylesheet" href="${CDN_BASE}style.min.css">
</head>
<body>
  <button class="btn btn-primary">Hello njX</button>
  <div class="card-glow">
    <h2 class="text-gradient-primary">Works.</h2>
  </div>
</body>
</html>
`;
const qsFullJs = `
<!-- Adds: collapseToggle, tabSwitch, dropdownToggle,
     openModal, closeModal, showToast, initCarousels -->
<script src="${CDN_JS}"></script>
`;
const qsAstroInstall = `
# pick your package manager
npm  install njx-ui
pnpm add     njx-ui
yarn add     njx-ui
bun  add     njx-ui
`;
const qsAstroLayout = `
---
// src/layouts/Layout.astro
import 'njx-ui/css/style.min.css';
---
<html lang="en" data-theme="dark">
  <body><slot /></body>
</html>
`;
const qsAstroPage = `
---
// src/pages/index.astro — any page or component
---
<button class="btn btn-primary">Hello njX</button>
<div class="card-glow">
  <h2 class="text-gradient-primary">Works.</h2>
</div>
`;
const qsAstroInteractive = `
<!-- Option A — Alpine.js: state lives in the markup, survives navigation -->
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3/dist/cdn.min.js"></script>

<!-- Option B — njx.js: with <ClientRouter /> re-init carousels after swaps -->
<script src="${CDN_JS}"></script>
<script>document.addEventListener('astro:page-load', () => initCarousels());</script>
`;
const qsInteractiveLink = `
<!-- In <head> -->
<link rel="stylesheet" href="${CDN_BASE}style.min.css">

<!-- Option A — Alpine.js: your state, njX classes -->
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3/dist/cdn.min.js"></script>

<!-- Option B — njx.js: zero-config helpers, before </body> -->
<script src="${CDN_JS}"></script>
`;
const qsInteractiveTheme = `
<html lang="en" data-theme="dark">
<!-- dark · light · red · blue · green · cyan · yellow · pink · purple -->
`;
const qsInteractiveAlpine = `
<div x-data="{ open: false }" @keydown.escape.window="open = false">
  <button class="btn btn-primary" @click="open = true">Open Modal</button>

  <div class="lib-modal-overlay" :class="{ open }" @click.self="open = false">
    <div class="lib-modal-box is-primary">
      <h3>Hello from Alpine</h3>
      <button class="btn btn-ghost btn-sm" @click="open = false">Close</button>
    </div>
  </div>
</div>
`;
const qsInteractivePage = `
<button class="btn btn-primary" onclick="openModal('demo')">Open Modal</button>
<button class="btn btn-accent" onclick="showToast('Done!','success')">Toast</button>

<div class="modal" id="demo">
  <div class="modal-box">
    <h3>Hello from njX JS</h3>
    <button onclick="closeModal('demo')">Close</button>
  </div>
</div>
`;
---

<section class="doc-section" id="quickstart">
                <!-- ── Flavor-aware section header ── -->
                <div class="doc-section-header" data-flavor-code="full">
                    <span class="sc-eyebrow">Getting started</span>
                    <h1 class="sc-heading">Quick Start</h1>
                    <p class="sc-subheading">
                        Connect the library to your project in under a minute —
                        no build tools required.
                    </p>
                </div>
                <div
                    class="doc-section-header"
                    data-flavor-code="astro"
                    style="display:none"
                >
                    <span class="sc-eyebrow">Getting started</span>
                    <h1 class="sc-heading">Quick Start — Astro</h1>
                    <p class="sc-subheading">
                        njX UI is zero-JS by default — a natural fit for Astro.
                        One <code>npm install</code>, one import in your Layout,
                        and every page ships pure CSS components.
                    </p>
                </div>
                <div
                    class="doc-section-header"
                    data-flavor-code="interactive"
                    style="display:none"
                >
                    <span class="sc-eyebrow">Getting started</span>
                    <h1 class="sc-heading">Quick Start — Interactive</h1>
                    <p class="sc-subheading">
                        Bring components to life with the driver you prefer:
                        <strong>Alpine.js</strong> (your state, njX classes) or
                        vanilla <strong>njx.js</strong> (zero-config helpers) —
                        modals, tabs, toasts, dropdowns.
                    </p>
                </div>

                <!-- ── Version selector cards ── -->
                <div class="doc-flavor-cards">
                    <div
                        class="doc-flavor-card active"
                        data-flavor-card="full"
                        onclick="pageSyncFlavor('full')"
                    >
                        <div class="doc-flavor-card-label-default">
                            RECOMMENDED
                        </div>
                        <div
                            class="doc-flavor-card-icon"
                            style="color:var(--color-primary)"
                        >
                            ◈
                        </div>
                        <div class="doc-flavor-card-title">Full CSS + JS</div>
                        <div class="doc-flavor-card-desc">
                            The classic path — 30+ component classes, utilities
                            and 9 themes; add njx.js when you need interactivity.
                        </div>
                        <div class="doc-flavor-card-badge">
                            style.min.css · 308 KB
                        </div>
                    </div>
                    <div
                        class="doc-flavor-card"
                        data-flavor-card="astro"
                        onclick="pageSyncFlavor('astro')"
                    >
                        <div class="doc-flavor-card-icon" style="color:#ff5d01">
                            🚀
                        </div>
                        <div class="doc-flavor-card-title">Astro</div>
                        <div class="doc-flavor-card-desc">
                            npm install + one import in your Layout. Zero-JS by
                            default — made for content sites and landings.
                        </div>
                        <div class="doc-flavor-card-badge">
                            import 'njx-ui/css/style.min.css'
                        </div>
                    </div>
                    <div
                        class="doc-flavor-card"
                        data-flavor-card="interactive"
                        onclick="pageSyncFlavor('interactive')"
                    >
                        <div class="doc-flavor-card-icon" style="color:#facc15">
                            JS
                        </div>
                        <div class="doc-flavor-card-title">Interactive · JS / Alpine</div>
                        <div class="doc-flavor-card-desc">
                            Everything in Full plus live modals, tabs, toasts,
                            dropdowns — driven by Alpine.js or vanilla njx.js.
                        </div>
                        <div class="doc-flavor-card-badge">
                            + Alpine.js / njx.js
                        </div>
                    </div>
                </div>


                <!-- ── Steps: Full ── -->
                <div class="doc-steps" data-flavor-code="full">
                    <div class="doc-step">
                        <div class="doc-step-left">
                            <div class="doc-step-num">1</div>
                            <div class="doc-step-line"></div>
                        </div>
                        <div class="doc-step-body">
                            <div class="doc-step-title">Add the stylesheet</div>
                            <div class="doc-step-desc">
                                One <code>&lt;link&gt;</code> tag in <code
                                    >&lt;head&gt;</code
                                >. Nothing else required.
                            </div>
                            <CodeBlock frame="sc" lang="html" code={qsFullLink} />
                        </div>
                    </div>
                    <div class="doc-step">
                        <div class="doc-step-left">
                            <div class="doc-step-num">2</div>
                            <div class="doc-step-line"></div>
                        </div>
                        <div class="doc-step-body">
                            <div class="doc-step-title">Set a theme</div>
                            <div class="doc-step-desc">
                                Add <code>data-theme</code> to the <code
                                    >&lt;html&gt;</code
                                > element. All components adapt automatically.
                            </div>
                            <CodeBlock frame="sc" lang="html" code={qsFullTheme} />
                        </div>
                    </div>
                    <div class="doc-step">
                        <div class="doc-step-left">
                            <div class="doc-step-num">3</div>
                            <div class="doc-step-line"></div>
                        </div>
                        <div class="doc-step-body">
                            <div class="doc-step-title">
                                Use component classes
                            </div>
                            <div class="doc-step-desc">
                                Add class names to HTML elements. Most
                                components are pure CSS — no JavaScript needed.
                            </div>
                            <CodeBlock frame="sc" lang="html" label="index.html" code={qsFullPage} />
                        </div>
                    </div>
                </div>

                <!-- Step 4: JS (Full only) -->
                <div
                    class="doc-step"
                    style="margin-top:0"
                    data-flavor-code="full"
                >
                    <div class="doc-step-left">
                        <div class="doc-step-num">4</div>
                    </div>
                    <div class="doc-step-body">
                        <div class="doc-step-title">
                            Add JavaScript <span
                                style="font-size:12px;font-weight:400;color:var(--color-muted)"
                                >(optional)</span
                            >
                        </div>
                        <div class="doc-step-desc">
                            Interactive components — collapse, tabs, dropdown,
                            modal, carousel, toast — need one script.
                        </div>
                        <CodeBlock frame="sc" lang="html" style="margin-top:12px" code={qsFullJs} />
                        <div
                            style="margin-top:10px;font-size:13px;color:var(--color-muted)"
                        >
                            Native <code>details/summary</code> components work without
                            JS. See the <a
                                href="#javascript"
                                style="color:var(--color-primary)"
                                >JavaScript reference</a
                            > for all functions.
                        </div>
                    </div>
                </div>

                <!-- ── Steps: Astro ── -->
                <div
                    class="doc-steps"
                    data-flavor-code="astro"
                    style="display:none"
                >
                    <div class="doc-step">
                        <div class="doc-step-left">
                            <div class="doc-step-num">1</div>
                            <div class="doc-step-line"></div>
                        </div>
                        <div class="doc-step-body">
                            <div class="doc-step-title">Install the package</div>
                            <div class="doc-step-desc">
                                Works with npm, pnpm, yarn or bun. No config, no
                                integration to register.
                            </div>
                            <CodeBlock frame="sc" lang="sh" code={qsAstroInstall} />
                        </div>
                    </div>
                    <div class="doc-step">
                        <div class="doc-step-left">
                            <div class="doc-step-num">2</div>
                            <div class="doc-step-line"></div>
                        </div>
                        <div class="doc-step-body">
                            <div class="doc-step-title">
                                Import once in your Layout
                            </div>
                            <div class="doc-step-desc">
                                Astro bundles the CSS automatically. Set <code
                                    >data-theme</code
                                > on <code>&lt;html&gt;</code> right here.
                            </div>
                            <CodeBlock frame="sc" lang="js" label="Layout.astro" code={qsAstroLayout} />
                        </div>
                    </div>
                    <div class="doc-step">
                        <div class="doc-step-left">
                            <div class="doc-step-num">3</div>
                            <div class="doc-step-line"></div>
                        </div>
                        <div class="doc-step-body">
                            <div class="doc-step-title">
                                Use classes in any page
                            </div>
                            <div class="doc-step-desc">
                                Components are plain CSS classes — they work in
                                <code>.astro</code> files, Markdown and any
                                framework island alike.
                            </div>
                            <CodeBlock frame="sc" lang="js" label="index.astro" code={qsAstroPage} />
                        </div>
                    </div>
                    <div class="doc-step">
                        <div class="doc-step-left">
                            <div class="doc-step-num">4</div>
                        </div>
                        <div class="doc-step-body">
                            <div class="doc-step-title">
                                Interactivity <span
                                    style="font-size:12px;font-weight:400;color:var(--color-muted)"
                                    >(optional)</span
                                >
                            </div>
                            <div class="doc-step-desc">
                                Pick a driver for modals, tabs and toasts —
                                Alpine.js pairs naturally with Astro's
                                zero-JS philosophy.
                            </div>
                            <CodeBlock frame="sc" lang="html" code={qsAstroInteractive} />
                            <div
                                style="margin-top:10px;font-size:13px;color:var(--color-muted)"
                            >
                                Ready-made Alpine recipes: see the <a
                                    href="#alpine"
                                    style="color:var(--color-primary)"
                                    >Alpine.js section</a
                                > below.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ── Steps: Interactive ── -->
                <div
                    class="doc-steps"
                    data-flavor-code="interactive"
                    style="display:none"
                >
                    <div class="doc-step">
                        <div class="doc-step-left">
                            <div class="doc-step-num">1</div>
                            <div class="doc-step-line"></div>
                        </div>
                        <div class="doc-step-body">
                            <div class="doc-step-title">
                                Add CSS + pick a driver
                            </div>
                            <div class="doc-step-desc">
                                One stylesheet plus <strong>Alpine.js</strong> or
                                <strong>njx.js</strong> — both toggle the same
                                state classes, pick what fits your stack.
                            </div>
                            <CodeBlock frame="sc" lang="html" code={qsInteractiveLink} />
                        </div>
                    </div>
                    <div class="doc-step">
                        <div class="doc-step-left">
                            <div class="doc-step-num">2</div>
                            <div class="doc-step-line"></div>
                        </div>
                        <div class="doc-step-body">
                            <div class="doc-step-title">Set a theme</div>
                            <div class="doc-step-desc">
                                Add <code>data-theme</code> to <code
                                    >&lt;html&gt;</code
                                >. All components adapt automatically.
                            </div>
                            <CodeBlock frame="sc" lang="html" code={qsInteractiveTheme} />
                        </div>
                    </div>
                    <div class="doc-step">
                        <div class="doc-step-left">
                            <div class="doc-step-num">3</div>
                            <div class="doc-step-line"></div>
                        </div>
                        <div class="doc-step-body">
                            <div class="doc-step-title">
                                Option A — drive it with Alpine
                            </div>
                            <div class="doc-step-desc">
                                State lives in the markup: <code>x-data</code>
                                toggles the same njX classes. Full recipe set —
                                in the <a
                                    href="#alpine"
                                    style="color:var(--color-primary)"
                                    >Alpine.js section</a
                                >.
                            </div>
                            <CodeBlock frame="sc" lang="html" label="index.html" code={qsInteractiveAlpine} />
                        </div>
                    </div>
                    <div class="doc-step">
                        <div class="doc-step-left">
                            <div class="doc-step-num">4</div>
                        </div>
                        <div class="doc-step-body">
                            <div class="doc-step-title">
                                Option B — the njx.js API
                            </div>
                            <div class="doc-step-desc">
                                Classes work the same as Full. JS functions are
                                available globally — no import needed.
                            </div>
                            <CodeBlock frame="sc" lang="html" label="index.html" code={qsInteractivePage} />
                            <div
                                style="margin-top:10px;font-size:13px;color:var(--color-muted)"
                            >
                                JS API: <code>openModal</code> · <code
                                    >closeModal</code
                                > · <code>showToast</code> · <code
                                    >tabSwitch</code
                                > · <code>collapseToggle</code> · <code
                                    >dropdownToggle</code
                                >. See the <a
                                    href="#javascript"
                                    style="color:var(--color-primary)"
                                    >JavaScript reference</a
                                > — or the <a
                                    href="#alpine"
                                    style="color:var(--color-primary)"
                                    >Alpine.js recipes</a
                                > if you prefer markup-driven state.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="doc-tip" style="margin-top:28px">
                    <span class="doc-tip-icon">📦</span>
                    <div class="doc-tip-text">
                        <strong>More install options:</strong> npm install, download
                        ZIP, or import individual CSS files. See the <a
                            href={`${base}quickstart`}
                            style="color:var(--color-primary)"
                            >Quick Start guide</a
                        > for all methods.
                    </div>
                </div>
            </section>
