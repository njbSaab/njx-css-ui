];
const DOC_CLASSLESS_CARDS = [
    {
        t: "📝 Headings",
        lines: [
            "&lt;h1&gt; — &lt;h6&gt;",
            "Size · weight · color",
            "Responsive scale"
        ]
    },
    {
        t: "📄 Text",
        lines: [
            "&lt;p&gt; &lt;strong&gt; &lt;em&gt;",
            "&lt;small&gt; &lt;mark&gt;",
            "&lt;blockquote&gt; &lt;cite&gt;"
        ]
    },
    {
        t: "🔗 Links",
        lines: [
            "&lt;a&gt;",
            "color-primary",
            "hover underline"
        ]
    },
    {
        t: "🔲 Button",
        lines: [
            "&lt;button&gt;",
            "&lt;input type=\"button\"&gt;",
            "&lt;input type=\"submit\"&gt;"
        ]
    },
    {
        t: "📋 Forms",
        lines: [
            "&lt;input&gt; &lt;textarea&gt;",
            "&lt;select&gt; &lt;label&gt;",
            "&lt;fieldset&gt; &lt;legend&gt;"
        ]
    },
    {
        t: "✅ Checkboxes",
        lines: [
            "&lt;input type=\"checkbox\"&gt;",
            "&lt;input type=\"radio\"&gt;",
            "&lt;input type=\"range\"&gt;"
        ]
    },
    {
        t: "📊 Table",
        lines: [
            "&lt;table&gt; &lt;thead&gt;",
            "&lt;tbody&gt; &lt;tr&gt;",
            "&lt;th&gt; &lt;td&gt;"
        ]
    },
    {
        t: "📜 Lists",
        lines: [
            "&lt;ul&gt; &lt;ol&gt;",
            "&lt;li&gt;",
            "&lt;dl&gt; &lt;dt&gt; &lt;dd&gt;"
        ]
    },
    {
        t: "💻 Code",
        lines: [
            "&lt;code&gt; &lt;pre&gt;",
            "&lt;kbd&gt; &lt;samp&gt;",
            "Syntax highlight colors"
        ]
    },
    {
        t: "🪗 Accordion",
        lines: [
            "&lt;details&gt;",
            "&lt;summary&gt;",
            "Native open/close — no JS"
        ]
    },
    {
        t: "🧭 Nav",
        lines: [
            "&lt;nav&gt;",
            "&lt;header&gt;",
            "&lt;footer&gt; &lt;aside&gt;"
