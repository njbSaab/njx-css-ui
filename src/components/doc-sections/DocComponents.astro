---

const DOC_COMPONENT_CARDS = [
    {
        t: "🔲 Buttons",
        lines: [
            ".btn",
            ".btn-primary · .btn-outline",
            ".btn-ghost · .btn-gradient",
            ".btn-glow · .btn-shine",
            ".btn-sm · .btn-lg"
        ]
    },
    {
        t: "🃏 Cards",
        lines: [
            ".card · .card-glass",
            ".card-dark · .card-bordered",
            ".card-glow · .box"
        ]
    },
    {
        t: "📋 Forms",
        lines: [
            ".inp · .inp-primary",
            ".inp-glass · .float-field",
            ".toggle · .check",
            ".inp-select"
        ]
    },
    {
        t: "🗂 Tabs",
        note: "JS",
        lines: [
            ".tab-wrap · .tab-nav",
            ".tab-btn · .tab-panel",
            ".tab-nav-pills",
            ".tab-nav-boxed · .tab-nav-card",
            ".tab-nav.is-full · .tab-badge"
        ]
    },
    {
        t: "🪗 Collapse",
        note: "JS / native",
        lines: [
            "details.collapse (native)",
            ".collapse + JS toggle",
            ".collapse-plus · .collapse-ghost",
            ".collapse-primary",
            ".accordion · .accordion-flush"
        ]
    },
    {
        t: "💬 Modals",
        note: "JS",
        lines: [
            ".lib-modal-overlay",
            ".lib-modal-box",
            ".is-success · .is-error",
            ".is-warning · .is-info",
            ".lib-modal-close"
        ]
    },
    {
        t: "🧭 Navigation",
        lines: [
            ".nav · .nav-brand · .nav-link",
            ".nav-solid · .nav-glass",
            ".nav-primary · .nav-dark",
            ".nav-floating · .nav-underline",
            ".nav-sm · .nav-lg"
        ]
    },
    {
        t: "📂 Dropdown",
        note: "JS / native",
        lines: [
            "details.dropdown (native)",
            ".dropdown + JS toggle",
            ".dropdown-menu · .dropdown-item",
            ".dropdown-right · .dropdown-top",
            ".dropdown-primary · .dropdown-dark"
        ]
    },
    {
        t: "🎠 Carousel",
        note: "CSS + JS dots",
        lines: [
            ".carousel · .carousel-item",
            ".carousel-center · .carousel-gap",
            ".carousel-vertical",
            ".carousel-btn · .carousel-dots",
            ".carousel-item-sm/md/lg/xl"
        ]
    },
    {
        t: "🔗 Links",
        lines: [
            ".link · .link-underline",
            ".link-slide · .link-arrow",
            ".link-external · .link-muted",
            ".link-btn · .link-card",
            ".link-list"
        ]
    },
    {
        t: "🏷 Tags & Badges",
        lines: [
            ".tag · .badge",
            ".tag-primary · .tag-success",
            ".tag-accent · .tag-outline"
        ]
    },
    {
        t: "📊 Table & Progress",
        lines: [
            ".table",
            ".progress · .progress-bar"
        ]
    },
    {
        t: "🔔 Notifications",
        note: "JS",
        lines: [
            "showToast(msg, type)",
            ".lib-toast · .lib-toast-success",
            ".lib-toast-error · .lib-toast-primary"
        ]
    },
    {
        t: "🌈 Gradients",
        lines: [
            ".gradient-primary",
            ".text-gradient-primary",
            ".gradient-blue-purple"
        ]
    },
    {
        t: "✨ Hover FX",
        lines: [
            ".hover-lift · .hover-glow",
            ".hover-brighten · .hover-rotate"
        ]
    }
];
---

<section class="doc-section" id="components">
                <!-- ── Full / Interactive: class-based components ── -->
                <div data-flavor-code="full interactive">
                    <div class="doc-section-header">
                        <span class="sc-eyebrow">Reference</span>
                        <h2 class="sc-heading">Components</h2>
                        <p class="sc-subheading">
                            30+ components included. Browse live demos and code
                            at <a
                                href="../index.html"
                                style="color:var(--color-primary)"
                                >the components page</a
                            >.
                        </p>
                    </div>

                    <div class="doc-grid doc-grid-auto">
                        {DOC_COMPONENT_CARDS.map((c) => (
                            <div class="doc-card">
                                <div class="doc-card-title">
                                    {c.t}{c.note && (
                                        <span style="font-size:10px;color:var(--color-muted);font-weight:400"> {c.note}</span>
                                    )}
                                </div>
                                <div class="doc-card-mono" set:html={c.lines.join('<br />')} />
                            </div>
                        ))}
                    </div>

                    <div class="doc-tip" style="margin-top:20px">
                        <span class="doc-tip-icon">⚡</span>
                        <div class="doc-tip-text">
                            Components marked <strong>JS</strong> require <code
                                >njx.js</code
                            > for interactivity. Components marked <strong
                                >native</strong
                            > use <code>&lt;details&gt;</code>/<code
                                >&lt;summary&gt;</code
                            > and work without any JavaScript.
                        </div>
                    </div>
                </div><!-- /full interactive -->

            </section>
