---
import Demo from '../shared/Demo.astro';
---

<section class="lib-section cl-section" id="buttons">
    <div class="lib-section-title">🔲 Buttons</div>
    <div class="lib-section-desc">
        Native <code>&lt;button&gt;</code> elements styled by <code>_native.css</code> with <code>data-variant</code> for semantic variants.
    </div>

    <Demo label="Variants">
        <article slot="preview">
            <button>Default</button>
            <button data-variant="accent">Accent</button>
            <button data-variant="success">Success</button>
            <button data-variant="warning">Warning</button>
            <button data-variant="error">Error</button>
            <button data-variant="dark">Dark</button>
            <button data-variant="light">Light</button>
        </article>
        <Fragment is:raw>
            <button>Default</button>
            <button data-variant="accent">Accent</button>
            <button data-variant="success">Success</button>
            <button data-variant="warning">Warning</button>
            <button data-variant="error">Error</button>
            <button data-variant="dark">Dark</button>
            <button data-variant="light">Light</button>
        </Fragment>
    </Demo>

    <Demo label={'Disabled & types'}>
        <article slot="preview">
            <button type="button">button</button>
            <button type="submit">submit</button>
            <button type="reset">reset</button>
            <button disabled>disabled</button>
        </article>
        <Fragment is:raw>
            <button type="button">button</button>
            <button type="submit">submit</button>
            <button type="reset">reset</button>
            <button disabled>disabled</button>
        </Fragment>
    </Demo>
</section>
