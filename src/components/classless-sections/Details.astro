---
import Demo from '../shared/Demo.astro';

// Обобщённый шаблон-образец; превью показывает живой FAQ с реальными текстами.
const detailsCode = `
<details>
  <summary>Question title</summary>
  <p>Answer content goes here.</p>
</details>

<!-- Open by default -->
<details open>
  <summary>Always visible</summary>
  <p>This panel is open on load.</p>
</details>
`;
---

<section class="lib-section cl-section" id="details">
    <div class="lib-section-title">🔽 Details &amp; Summary</div>
    <div class="lib-section-desc">
        Native <code>&lt;details&gt;</code> / <code>&lt;summary&gt;</code> accordion
        — no JavaScript, styled by <code>_native.css</code>.
    </div>

    <Demo is:raw label="Details accordion" previewWrap="article" code={detailsCode}>
        <details>
            <summary>What is classless CSS?</summary>
            <p>
                A single CSS file that styles native HTML elements with
                zero class names. Drop it in and write semantic HTML —
                everything looks great out of the box.
            </p>
        </details>
        <details>
            <summary>How do I use data-theme?</summary>
            <p>
                Add <code>data-theme="dark"</code> (or any of the 9 theme
                names) to your <code>&lt;html&gt;</code> element. Themes update
                all CSS custom properties automatically.
            </p>
        </details>
        <details open>
            <summary>Is this production ready?</summary>
            <p>
                Yes. The library is minified to ~48 KB, has zero runtime
                dependencies, and supports all modern browsers. The
                classless mode is a standalone add-on to the main CSS.
            </p>
        </details>
    </Demo>
</section>
