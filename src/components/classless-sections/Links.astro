---
import Demo from '../shared/Demo.astro';

// Образцы без презентационных <p>-обёрток и разделителей «—» из превью.
const linksCode = `
<a href="#">Regular link</a>
<a href="#" aria-current="page">Active link</a>
<a href="#" target="_blank" rel="noopener">External ↗</a>
`;

const inlineCode = `
<cite>Cited work</cite>
<q>Inline quotation</q>
<dfn>Definition</dfn>
<var>variable</var>
H<sub>2</sub>O
E = mc<sup>2</sup>
<del>Deleted</del>
<ins>Inserted</ins>
<mark>Highlighted</mark>
<abbr title="HyperText Markup Language">HTML</abbr>
`;
---

<section class="lib-section cl-section" id="inline">
    <div class="lib-section-title">🔗 Inline &amp; Links</div>
    <div class="lib-section-desc">
        Inline semantic elements styled by <code>_native.css</code>: links, citations, definitions, abbreviations, and more.
    </div>

    <Demo is:raw label="Links" previewWrap="article" code={linksCode}>
        <p>
            <a href="#">Regular link</a> —
            <a href="#" aria-current="page">Active (aria-current)</a> —
            <a href="#" target="_blank" rel="noopener">External link ↗</a>
        </p>
    </Demo>

    <Demo is:raw label="Inline semantic elements" previewWrap="article" code={inlineCode}>
        <p>
            <cite>Cited work</cite> —
            <q>Inline quotation</q> —
            <dfn>Definition term</dfn> —
            <var>variable</var> —
            H<sub>2</sub>O —
            E = mc<sup>2</sup>
        </p>
        <p>
            <del>Deleted text</del> —
            <ins>Inserted text</ins> —
            <mark>Highlighted text</mark> —
            <abbr title="HyperText Markup Language">HTML</abbr>
        </p>
    </Demo>
</section>
