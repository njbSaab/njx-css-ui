---
interface Props {
    activePage?:
        | 'njxUIComponents'
        | 'documentation'
        | 'quickstart'
        | 'overview'
        | 'donate'
        | 'contact'
;
}
const { activePage } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<footer class="lib-footer">
    <a class="lib-footer-logo" href={base}>njX UI</a>
    <div class="lib-footer-links">
        <a href={base} class={activePage === 'njxUIComponents' ? 'active' : ''}
            >Components</a
        >
        <a href="https://classless.njxui.dev"
            >Classless</a
        >
        <a
            href={`${base}documentation`}
            class={activePage === 'documentation' ? 'active' : ''}
            >Documentation</a
        >
        <a
            href={`${base}quickstart`}
            class={activePage === 'quickstart' ? 'active' : ''}>Quick Start</a
        >
        <a
            href={`${base}overview`}
            class={activePage === 'overview' ? 'active' : ''}>Overview</a
        >
        <a
            href={`${base}contact`}
            class={activePage === 'contact' ? 'active' : ''}>Contact</a
        >
        <a href={`${base}terms`}>Terms &amp; Refunds</a>
        <a href={`${base}privacy`}>Privacy</a>
        <a href="https://github.com/njbSaab/njx-css-ui" target="_blank"
            >GitHub</a
        >
    </div>
</footer>
<style is:global>
    .lib-footer-links a.active {
        color: var(--color-primary);
    }
    .lib-footer-kofi {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin: 16px 0 8px;
        padding: 10px 20px;
        background: linear-gradient(
            135deg,
            var(--color-primary),
            var(--color-accent)
        );
        color: #fff;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        border-radius: 8px;
        transition:
            opacity 0.2s,
            transform 0.2s;
    }
    .lib-footer-kofi:hover {
        opacity: 0.85;
        transform: translateY(-1px);
    }
</style>
